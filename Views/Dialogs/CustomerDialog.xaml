<Window x:Class="AntiquePasabuyPOS.Views.Dialogs.CustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Customer" Width="480" MinHeight="380" MaxHeight="580" Height="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource PosSurface}"
        Style="{StaticResource MaterialDesignWindow}"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Header -->
            <RowDefinition Height="*"/>    <!-- Scrollable Form Body -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- ══ 1. HEADER ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <md:PackIcon x:Name="HeaderIcon" Kind="AccountPlus" Width="20" Height="20"
                             Foreground="{DynamicResource PosPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TitleLabel" Text="Add Customer" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ══ 2. SCROLLABLE FORM BODY ═════════════════════════════════════════ -->
        <ScrollViewer x:Name="FormScrollViewer" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      Margin="0,0,-10,0" Padding="0,0,10,0"
                      PreviewMouseWheel="OnFormPreviewMouseWheel">
            <StackPanel Margin="0,0,0,8">
                <!-- Full Name -->
                <TextBlock Text="Full Name *" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                <TextBox x:Name="NameBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Customer full name" FontSize="13" Margin="0,0,0,14"
                         FontFamily="Segoe UI"/>

                <!-- Phone Number -->
                <TextBlock Text="Phone Number" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                <TextBox x:Name="PhoneBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="09xxxxxxxxx" FontSize="13" Margin="0,0,0,14"
                         FontFamily="Segoe UI"/>

                <!-- Delivery Address -->
                <TextBlock Text="Delivery Address" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                <TextBox x:Name="AddressBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="House/Unit #, Street, Barangay, Town/City" FontSize="13" Margin="0,0,0,14"
                         Height="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         PreviewMouseWheel="OnTextBoxPreviewMouseWheel" FontFamily="Segoe UI"/>

                <!-- Notes / Special Instructions -->
                <TextBlock Text="Customer Notes / Landmarks (Optional)" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                <TextBox x:Name="NotesBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="e.g. Near blue gate, call before delivering, preferred schedule"
                         FontSize="12.5" Margin="0,0,0,10"
                         Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         PreviewMouseWheel="OnTextBoxPreviewMouseWheel" FontFamily="Segoe UI"/>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorLabel" Foreground="#DC2626" FontSize="12"
                           FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ══ 3. ACTIONS ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource PosBorder}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource Pos3DSecondaryBtn}"
                        Margin="0,0,10,0" Click="OnCancel" Height="36" Padding="16,0"/>
                <Button Content="Save Customer" Style="{StaticResource Pos3DPrimaryBtn}"
                        Click="OnSave" Height="36" Padding="18,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
