<Window x:Class="AntiquePasabuyPOS.Views.Dialogs.EditOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Edit Order" Width="520" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource MaterialDesignWindow}" Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleLabel" Text="Edit Order" FontSize="18" FontWeight="Bold"
                   Foreground="#1E293B" FontFamily="Segoe UI" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <!-- Customer -->
                <TextBlock Text="Customer" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                <ComboBox x:Name="CustomerCombo" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          DisplayMemberPath="Name" SelectedValuePath="Id" FontSize="13" Margin="0,0,0,12"/>

                <!-- Delivery Type -->
                <TextBlock Text="Order Type" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="PickupRadio" Content="Pickup" GroupName="DelivType" Margin="0,0,20,0" Checked="OnTypeChanged" FontSize="13"/>
                    <RadioButton x:Name="DeliveryRadio" Content="Delivery" GroupName="DelivType" Checked="OnTypeChanged" FontSize="13"/>
                </StackPanel>

                <!-- Delivery Address -->
                <TextBlock Text="Delivery Address" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                <TextBox x:Name="AddressBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Full delivery address" FontSize="13" Margin="0,0,0,12"
                         Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                <!-- Shopping Day & Store -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Shopping Day" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                        <ComboBox x:Name="BuyingDayCombo" Style="{StaticResource MaterialDesignOutlinedComboBox}" FontSize="13">
                            <ComboBoxItem Content="Wednesday"/>
                            <ComboBoxItem Content="Thursday"/>
                            <ComboBoxItem Content="Friday"/>
                            <ComboBoxItem Content="Saturday"/>
                            <ComboBoxItem Content="Sunday"/>
                            <ComboBoxItem Content="Monday"/>
                            <ComboBoxItem Content="Tuesday"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Preferred Store" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                        <ComboBox x:Name="StoreCombo" Style="{StaticResource MaterialDesignOutlinedComboBox}" FontSize="13" IsEditable="True"/>
                    </StackPanel>
                </Grid>

                <!-- Payment Details Block: Method, Status, Paid Date -->
                <Border Background="#F1F5F9" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" BorderBrush="#CBD5E1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Payment Details" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Payment Method" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                <ComboBox x:Name="PaymentMethodCombo" Style="{StaticResource MaterialDesignOutlinedComboBox}" FontSize="12">
                                    <ComboBoxItem Content="GCash"/>
                                    <ComboBoxItem Content="Bank"/>
                                    <ComboBoxItem Content="On Hand"/>
                                    <ComboBoxItem Content="Maya"/>
                                    <ComboBoxItem Content="COD (Cash on Delivery)"/>
                                    <ComboBoxItem Content="Other"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Payment Status" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                                <ComboBox x:Name="PaymentStatusCombo" Style="{StaticResource MaterialDesignOutlinedComboBox}" FontSize="12"
                                          SelectionChanged="OnPaymentStatusChanged">
                                    <ComboBoxItem Content="Paid"/>
                                    <ComboBoxItem Content="Not Paid"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="PaidDatePanel">
                            <TextBlock Text="Paid Date" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                            <DatePicker x:Name="PaidDatePicker" Style="{StaticResource MaterialDesignOutlinedDatePicker}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Pasabuy Fee -->
                <Grid Margin="0,0,0,12">
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Pasabuy Fee (₱)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <Button Content="Auto" Click="OnAutoCalcServiceFee"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalAlignment="Right" Height="18" Padding="4,0" FontSize="9.5" FontWeight="Bold"
                                Foreground="#0F766E" ToolTip="Auto-calculate Pasabuy Fee based on items subtotal and official rate table"/>
                    </Grid>
                    <TextBox x:Name="ServiceFeeBox" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="13" Margin="0,24,0,0"/>
                </Grid>

                <!-- Notes -->
                <TextBlock Text="Order Notes &amp; Special Requests" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                <TextBox x:Name="NotesBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Add customer notes, dedication, instructions..." FontSize="13" Margin="0,0,0,8"
                         Height="65" TextWrapping="Wrap" AcceptsReturn="True"/>

                <TextBlock x:Name="ErrorLabel" Foreground="#DC2626" FontSize="12" FontFamily="Segoe UI" Margin="0,2,0,0"/>

                <!-- Live Grand Total Preview -->
                <Border Background="#F1F5F9" CornerRadius="8" Padding="12,10" Margin="0,12,0,0"
                        BorderBrush="#CBD5E1" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Estimated Grand Total" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#64748B" FontFamily="Segoe UI"/>
                            <TextBlock Text="Subtotal + Pasabuy Fee" FontSize="10"
                                       Foreground="#94A3B8" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <TextBlock x:Name="GrandTotalPreview" Grid.Column="1"
                                   FontSize="20" FontWeight="Bold" Foreground="#0F766E"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"
                                   Text="₱0.00"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource Pos3DSecondaryBtn}"
                    Margin="0,0,10,0"
                    Click="OnCancel"/>
            <Button Content="Save Changes" Style="{StaticResource Pos3DPrimaryBtn}"
                    Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
