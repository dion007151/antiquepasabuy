<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AntiquePasabuyPOS.Views.Dialogs.NewMasterlistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="New Masterlist"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PosBackground}"
        Style="{StaticResource MaterialDesignWindow}">

    <StackPanel Margin="28,24,28,24">

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Border Background="#EDE9FE" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                <md:PackIcon Kind="FolderPlusOutline" Width="20" Height="20" Foreground="#4F46E5"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="New Masterlist" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"/>
                <TextBlock Text="This will close the current masterlist and start a new one."
                           FontSize="11.5" Foreground="{DynamicResource PosSecondaryText}"
                           FontFamily="Segoe UI" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Name -->
        <TextBlock Text="Masterlist Name" FontSize="11.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,4"/>
        <Border Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
            <TextBox x:Name="NameBox"
                     FontSize="13" FontFamily="Segoe UI"
                     BorderThickness="0"
                     Foreground="{DynamicResource PosPrimaryText}"
                     CaretBrush="{DynamicResource PosPrimary}"
                     md:HintAssist.Hint="e.g.  OCT W1 2026"
                     md:TextFieldAssist.DecorationVisibility="Hidden"/>
        </Border>

        <!-- Start Date -->
        <TextBlock Text="Start Date" FontSize="11.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,4"/>
        <Border Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,0,18">
            <DatePicker x:Name="StartDatePicker"
                        SelectedDateFormat="Short"
                        FontSize="13" FontFamily="Segoe UI"
                        Foreground="{DynamicResource PosPrimaryText}"
                        BorderThickness="0"/>
        </Border>

        <!-- Warning panel (hidden when no active masterlist) -->
        <Border x:Name="WarningPanel" Background="#FEF3C7" BorderBrush="#F59E0B"
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <md:PackIcon Kind="AlertCircleOutline" Width="15" Height="15"
                                 Foreground="#B45309" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Current Masterlist Has Pending Work"
                               FontSize="12" FontWeight="Bold" Foreground="#92400E"/>
                </StackPanel>
                <TextBlock x:Name="WarningText"
                           FontSize="11.5" Foreground="#92400E" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Confirmation message -->
        <Border x:Name="ConfirmPanel" Background="{DynamicResource PosSurface}"
                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,22">
            <TextBlock x:Name="ConfirmText"
                       FontSize="12" Foreground="{DynamicResource PosSecondaryText}"
                       TextWrapping="Wrap" FontStyle="Italic"/>
        </Border>

        <!-- Validation error -->
        <TextBlock x:Name="ErrorLabel" Foreground="#DC2626" FontSize="11.5"
                   Visibility="Collapsed" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <!-- Buttons -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Cancel" Click="OnCancel"
                    Style="{StaticResource Pos3DSecondaryBtn}"
                    Height="36" Padding="18,0" Margin="0,0,8,0"/>
            <Button Grid.Column="2" x:Name="ConfirmBtn"
                    Content="Create Masterlist" Click="OnConfirm"
                    Style="{StaticResource Pos3DPrimaryBtn}"
                    Height="36" Padding="18,0"/>
        </Grid>
    </StackPanel>
</Window>
