<Window x:Class="AntiquePasabuyPOS.Views.Dialogs.RestoRestockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Restock Inventory" Width="440" Height="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Style="{StaticResource MaterialDesignWindow}"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="TitleLbl" Text="Restock / Add Inventory Item" FontSize="17" FontWeight="Bold" Foreground="#102A43" FontFamily="Segoe UI" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Existing Item selector (for restocking existing) -->
                <TextBlock Text="Select Existing Item (or leave blank to add new)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                <ComboBox x:Name="ExistingItemCombo" Style="{StaticResource MaterialDesignOutlinedComboBox}" md:HintAssist.Hint="-- Select existing item --" FontSize="12.5" Padding="10,6" Margin="0,0,0,10" SelectionChanged="OnExistingItemChanged" DisplayMemberPath="Name"/>

                <!-- Item Code & Name -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Item Code" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                        <TextBox x:Name="CodeBox" Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="INV-001" FontSize="12.5" Padding="10,6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Item Name *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                        <TextBox x:Name="NameBox" Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="e.g. Pork Belly, San Miguel Beer" FontSize="12.5" Padding="10,6"/>
                    </StackPanel>
                </Grid>

                <!-- Category & Unit -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Category" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                        <ComboBox x:Name="CategoryCombo" Style="{StaticResource MaterialDesignOutlinedComboBox}" md:HintAssist.Hint="Category" FontSize="12.5" IsEditable="True" Padding="10,6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Unit" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                        <ComboBox x:Name="UnitCombo" Style="{StaticResource MaterialDesignOutlinedComboBox}" md:HintAssist.Hint="Unit" FontSize="12.5" IsEditable="True" Padding="10,6"/>
                    </StackPanel>
                </Grid>

                <!-- Quantity & Cost -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="QtyLabel" Text="Quantity to Add *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                        <TextBox x:Name="QtyBox" Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="0" FontSize="12.5" Padding="10,6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Unit Cost (₱)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                        <TextBox x:Name="CostBox" Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="0.00" FontSize="12.5" Padding="10,6"/>
                    </StackPanel>
                </Grid>

                <!-- Min Stock Level -->
                <TextBlock Text="Minimum Stock Level (alert threshold)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                <TextBox x:Name="MinStockBox" Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="5" FontSize="12.5" Padding="10,6" Margin="0,0,0,10" Text="5"/>

                <!-- Current stock info (visible only when restocking existing) -->
                <Border x:Name="CurrentStockPanel" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="CurrentStockLbl" Text="" FontSize="12" Foreground="#166534" FontWeight="SemiBold"/>
                </Border>

                <TextBlock x:Name="ErrLbl" Foreground="#DC2626" FontSize="11.5" FontFamily="Segoe UI" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ACTIONS -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Style="{StaticResource Pos3DSecondaryBtn}" Margin="0,0,10,0" Click="OnCancel"/>
            <Button x:Name="SaveBtn" Content="Save &amp; Restock" Style="{StaticResource Pos3DPrimaryBtn}" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
