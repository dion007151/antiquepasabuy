<Window x:Class="AntiquePasabuyPOS.Views.Dialogs.AddItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Add Item" Width="480" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource MaterialDesignWindow}" Background="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Add Order Item" FontSize="18" FontWeight="Bold"
                   Foreground="#1E293B" FontFamily="Segoe UI" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Item Name *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
            <TextBox x:Name="NameBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     md:HintAssist.Hint="e.g. Chicken (whole)" FontSize="13" Margin="0,0,0,12"
                     KeyDown="OnInputKeyDown"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Quantity *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                    <TextBox x:Name="QtyBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="1" FontSize="13" Text="1"
                             KeyDown="OnInputKeyDown"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Unit" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                    <TextBox x:Name="UnitBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="pc / kg / L" FontSize="13" Text="pc"
                             KeyDown="OnInputKeyDown"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Estimated Price (₱)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                    <TextBox x:Name="PriceBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="0.00" FontSize="13" Text="0.00"
                             KeyDown="OnInputKeyDown"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Store" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                    <ComboBox x:Name="StoreCombo" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              md:HintAssist.Hint="SM, Robinsons..." FontSize="13" IsEditable="True"/>
                </StackPanel>
            </Grid>

            <!-- Item Notes (flavor, size, brand substitute) -->
            <TextBlock Text="Item Notes (e.g. flavor, size, brand substitute)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
            <TextBox x:Name="NotesBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     md:HintAssist.Hint="e.g. Large size, Strawberry flavor if available" FontSize="12.5" Margin="0,0,0,12"
                     KeyDown="OnInputKeyDown"/>

            <TextBlock x:Name="ErrLabel" Foreground="#DC2626" FontSize="12" FontFamily="Segoe UI" MinHeight="18"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Style="{StaticResource Pos3DSecondaryBtn}"
                    Margin="0,0,10,0" Click="OnCancel"/>
            <Button x:Name="AddBtn" Style="{StaticResource Pos3DPrimaryBtn}"
                    Click="OnAdd">
                <TextBlock Text="Add Item" FontWeight="Bold" FontSize="12.5" Foreground="White"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
