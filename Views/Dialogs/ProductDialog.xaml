<Window x:Class="AntiquePasabuyPOS.Views.Dialogs.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Product Catalog Entry" Width="510" Height="640" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource PosBackground}"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="TitleLbl" Text="Add New Product" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. PRODUCT IMAGE MANAGEMENT -->
                <TextBlock Text="Product Image (Offline POS Display)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                <Border Background="{DynamicResource PosPanel}" BorderBrush="{DynamicResource PosBorder}" BorderThickness="1.5" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Image Preview Box (84x84) -->
                        <Border Grid.Column="0" Width="84" Height="84" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <Grid>
                                <!-- Fallback Placeholder Icon -->
                                <md:PackIcon x:Name="PlaceholderIcon" Kind="ShoppingOutline" Width="36" Height="36" Foreground="{DynamicResource PosPrimary}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible"/>
                                <!-- Actual Product Image -->
                                <Image x:Name="ProductImgPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Image Action Buttons -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="ImageStatusLabel" Text="No image selected (default placeholder will show)" FontSize="11" Foreground="{DynamicResource PosSecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Choose Image" Click="OnChooseImage"
                                        Style="{StaticResource Pos3DSecondaryBtn}"
                                        Height="32" Padding="12,0" FontSize="11" Margin="0,0,6,0"/>
                                <Button x:Name="RemoveImgBtn" Content="Remove" Click="OnRemoveImage"
                                        Style="{StaticResource Pos3DTableDangerBtn}"
                                        Height="32" Padding="10,0" FontSize="11" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. PRODUCT DETAILS -->
                <TextBlock Text="Product Name *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                <TextBox x:Name="NameBox" Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="e.g. Coca-Cola 1.5L, Rice Sinandomeng" FontSize="12.5" Margin="0,0,0,10" Padding="10,6"/>

                <!-- BARCODE / GTIN WITH SCANNER -->
                <TextBlock Text="Barcode / GTIN" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="BarcodeBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="e.g. 4800016644802 (or click Scan)" FontSize="12.5" Padding="10,6"/>
                    <Button Grid.Column="1" Click="OnScanBarcodeClick"
                            Style="{StaticResource Pos3DFilterBtn}" Height="38" Padding="12,0" Margin="8,0,0,0"
                            ToolTip="Scan barcode with camera to automatically fill product details">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="BarcodeScan" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource PosPrimary}"/>
                            <TextBlock Text="Scan" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Category" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                        <TextBox x:Name="CatBox" Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="e.g. Grocery, Pharmacy" FontSize="12.5" Padding="10,6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Store" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                        <ComboBox x:Name="StoreCombo" Style="{StaticResource MaterialDesignOutlinedComboBox}" md:HintAssist.Hint="SM, Robinsons..." FontSize="12.5" IsEditable="True" Padding="10,6"/>
                    </StackPanel>
                </Grid>

                <!-- PRICE FIELDS (Original / Cost Price Optional + Now / Selling Price) -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Original / Cost (₱)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                        <TextBox x:Name="CostPriceBox" Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="Optional cost" FontSize="12.5" Padding="8,6"
                                 ToolTip="Original purchase price at store / wholesale cost"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Now / Sell (₱) *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                        <TextBox x:Name="PriceBox" Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="0.00" FontSize="12.5" Padding="8,6"
                                 ToolTip="Selling price to customer"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Unit" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                        <TextBox x:Name="UnitBox" Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="pc/kg/pack" FontSize="12.5" Text="pc" Padding="8,6"/>
                    </StackPanel>
                </Grid>

                <!-- 3. PASABUY FEE TOGGLE -->
                <TextBlock Text="Pasabuy Fee" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                <Border BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10" Background="{DynamicResource PosPanel}">
                    <StackPanel>
                        <TextBlock Text="Does this product include a Pasabuy (service) fee?" FontSize="11" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="WithFeeRadio" GroupName="FeeGroup" IsChecked="True"
                                         Margin="0,0,16,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#D1FAE5" CornerRadius="4" Padding="8,4" Margin="4,0,0,0">
                                        <TextBlock Text="WITH PASABUY FEE" FontSize="11" FontWeight="Bold" Foreground="#065F46"/>
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NoFeeRadio" GroupName="FeeGroup" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource PosSurface}" CornerRadius="4" Padding="8,4" Margin="4,0,0,0">
                                        <TextBlock Text="NO PASABUY FEE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}"/>
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <TextBlock Text="Select 'No Pasabuy Fee' for exempt items (e.g. SOLAR LIGHT, bulk-purchase items without service charge)."
                                   FontSize="10.5" Foreground="{DynamicResource PosMutedText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrLbl" Foreground="#DC2626" FontSize="11.5" FontFamily="Segoe UI" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 4. ACTIONS -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Style="{StaticResource Pos3DSecondaryBtn}" Margin="0,0,10,0" Click="OnCancel"/>
            <Button Content="Save Product" Style="{StaticResource Pos3DPrimaryBtn}" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
