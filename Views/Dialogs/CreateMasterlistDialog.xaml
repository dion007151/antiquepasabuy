<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AntiquePasabuyPOS.Views.Dialogs.CreateMasterlistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Create New Masterlist"
        Width="520" SizeToContent="Height"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource PosBackground}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Border Background="{DynamicResource PosBackground}" Padding="28,24">
        <StackPanel>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Background="#EDE9FE" CornerRadius="10" Padding="10" Margin="0,0,12,0">
                    <md:PackIcon Kind="ClipboardTextOutline" Width="22" Height="22" Foreground="#4F46E5"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Create New Masterlist" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"/>
                    <TextBlock Text="Define a weekly batch for customer orders and purchasing."
                               FontSize="11.5" Foreground="{DynamicResource PosSecondaryText}" FontFamily="Segoe UI"/>
                </StackPanel>
            </StackPanel>

            <!-- Control Number (auto-generated, read-only) -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Control Number (Auto-Generated)" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource PosMutedText}" FontFamily="Segoe UI" Margin="0,0,0,5"/>
                <Border Background="#F5F3FF" BorderBrush="#C4B5FD" BorderThickness="1.5" CornerRadius="8"
                        Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="TagOutline" Width="16" Height="16" Foreground="#6D28D9"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ControlNumberLabel"
                                   FontSize="14" FontWeight="Bold" Foreground="#4338CA"
                                   VerticalAlignment="Center" FontFamily="Segoe UI Mono, Consolas, Segoe UI"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Name / Week Label -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Masterlist Name / Week Label" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource PosMutedText}" FontFamily="Segoe UI" Margin="0,0,0,5"/>
                <TextBox x:Name="NameBox"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         FontSize="13" FontFamily="Segoe UI"
                         md:HintAssist.Hint="e.g. Week 1 – October 2026"
                         Padding="10,8"/>
            </StackPanel>

            <!-- Month / Year row -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Month -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Month" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PosMutedText}" FontFamily="Segoe UI" Margin="0,0,0,5"/>
                    <ComboBox x:Name="MonthBox"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              FontSize="13" FontFamily="Segoe UI"
                              SelectionChanged="OnMonthYearChanged">
                        <ComboBoxItem Content="January"   Tag="1"/>
                        <ComboBoxItem Content="February"  Tag="2"/>
                        <ComboBoxItem Content="March"     Tag="3"/>
                        <ComboBoxItem Content="April"     Tag="4"/>
                        <ComboBoxItem Content="May"       Tag="5"/>
                        <ComboBoxItem Content="June"      Tag="6"/>
                        <ComboBoxItem Content="July"      Tag="7"/>
                        <ComboBoxItem Content="August"    Tag="8"/>
                        <ComboBoxItem Content="September" Tag="9"/>
                        <ComboBoxItem Content="October"   Tag="10"/>
                        <ComboBoxItem Content="November"  Tag="11"/>
                        <ComboBoxItem Content="December"  Tag="12"/>
                    </ComboBox>
                </StackPanel>

                <!-- Year -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Year" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PosMutedText}" FontFamily="Segoe UI" Margin="0,0,0,5"/>
                    <TextBox x:Name="YearBox"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FontSize="13" FontFamily="Segoe UI"
                             md:HintAssist.Hint="e.g. 2026"
                             Padding="10,8"
                             TextChanged="OnMonthYearChanged"/>
                </StackPanel>
            </Grid>

            <!-- Date Range -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Start Date" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PosMutedText}" FontFamily="Segoe UI" Margin="0,0,0,5"/>
                    <DatePicker x:Name="StartDatePicker"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                FontSize="13" FontFamily="Segoe UI"
                                SelectedDateChanged="OnDateChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="End Date" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource PosMutedText}" FontFamily="Segoe UI" Margin="0,0,0,5"/>
                    <DatePicker x:Name="EndDatePicker"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                FontSize="13" FontFamily="Segoe UI"
                                SelectedDateChanged="OnDateChanged"/>
                </StackPanel>
            </Grid>

            <!-- Notes -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Notes (Optional)" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource PosMutedText}" FontFamily="Segoe UI" Margin="0,0,0,5"/>
                <TextBox x:Name="NotesBox"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         FontSize="12.5" FontFamily="Segoe UI"
                         md:HintAssist.Hint="Any notes or remarks for this batch…"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Height="64"
                         VerticalScrollBarVisibility="Auto"
                         Padding="10,8"/>
            </StackPanel>

            <!-- Validation error -->
            <Border x:Name="ErrorBorder" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                    CornerRadius="8" Padding="10,8" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="AlertCircleOutline" Width="16" Height="16" Foreground="#DC2626"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ErrorLabel" FontSize="12" Foreground="#DC2626"
                               TextWrapping="Wrap" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="Cancel"
                        Style="{StaticResource Pos3DSecondaryBtn}"
                        Height="40" Padding="20,0"
                        Click="OnCancel"/>

                <Button Grid.Column="3" x:Name="CreateBtn"
                        Style="{StaticResource Pos3DPrimaryBtn}"
                        Height="40" Padding="20,0"
                        Click="OnCreate">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Create Masterlist" FontSize="12" FontWeight="Bold"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

        </StackPanel>
    </Border>
</Window>
