<Window x:Class="AntiquePasabuyPOS.Views.Dialogs.ExpenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Add Expense" Width="440" Height="440" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Style="{StaticResource MaterialDesignWindow}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="TitleLabel" Text="Add Expense" FontSize="17" FontWeight="Bold" Foreground="#1E293B" FontFamily="Segoe UI" Margin="0,0,0,20"/>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Description *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
            <TextBox x:Name="DescBox" Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="What was this expense for?" FontSize="13" Margin="0,0,0,12"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Amount (₱) *" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                    <TextBox x:Name="AmtBox" Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="0.00" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Category" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                    <TextBox x:Name="CatBox" Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="General" FontSize="13" Text="General"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="Notes" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4" FontFamily="Segoe UI"/>
            <TextBox x:Name="NotesBox" Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="Optional notes" FontSize="13" Margin="0,0,0,12"/>
            <TextBlock x:Name="ErrLbl" Foreground="#DC2626" FontSize="12" FontFamily="Segoe UI"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource Pos3DSecondaryBtn}" Margin="0,0,10,0" Click="OnCancel"/>
            <Button Content="Save Expense" Style="{StaticResource Pos3DDangerBtn}" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
