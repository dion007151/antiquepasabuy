<Window x:Class="AntiquePasabuyPOS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:AntiquePasabuyPOS.Views"
        Title="DIONIX POS"
        Icon="pack://application:,,,/Assets/dionix_icon.ico"
        WindowState="Maximized"
        MinWidth="960" MinHeight="580"
        Style="{StaticResource MaterialDesignWindow}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!-- MODERN MAIN NAVIGATION SECTION BUTTON STYLE                       -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <Style x:Key="Pos3DNavMainButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B8AFCE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFace"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,0">
                            <!-- Button Content -->
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- ACTIVE STATE: Selected Main Section (Primary Indigo #4F46E5) -->
                            <Trigger Property="views:NavProps.IsActive" Value="True">
                                <Setter TargetName="ButtonFace" Property="Background" Value="#4F46E5"/>
                                <Setter TargetName="ButtonFace" Property="BorderBrush" Value="#6366F1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>

                            <!-- HOVER STATE -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="views:NavProps.IsActive" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonFace" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="ButtonFace" Property="BorderBrush" Value="#334155"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="views:NavProps.IsActive" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonFace" Property="Background" Value="#6366F1"/>
                                <Setter TargetName="ButtonFace" Property="BorderBrush" Value="#818CF8"/>
                            </MultiTrigger>

                            <!-- PRESSED -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonFace" Property="Background" Value="#3730A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!-- MODERN CHILD NAVIGATION BUTTON STYLE                              -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <Style x:Key="Pos3DNavChildButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B8AFCE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,1.5,0,1.5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFace"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,0">
                            <!-- Button Content -->
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- ACTIVE STATE: Selected Child Page -->
                            <Trigger Property="views:NavProps.IsActive" Value="True">
                                <Setter TargetName="ButtonFace" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="ButtonFace" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="#C7D2FE"/>
                            </Trigger>

                            <!-- HOVER STATE -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="views:NavProps.IsActive" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonFace" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="views:NavProps.IsActive" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonFace" Property="Background" Value="#6366F1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>

                            <!-- PRESSED -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonFace" Property="Background" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!-- ANGELITO'S RESTAURANT NAVIGATION BUTTON STYLE                     -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <Style x:Key="Pos3DRestoNavMainButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C9ADA7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFace"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="views:NavProps.IsActive" Value="True">
                                <Setter TargetName="ButtonFace" Property="Background" Value="#3D2222"/>
                                <Setter TargetName="ButtonFace" Property="BorderBrush" Value="#5C3A3A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="views:NavProps.IsActive" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonFace" Property="Background" Value="#332020"/>
                                <Setter TargetName="ButtonFace" Property="BorderBrush" Value="#4A2C2C"/>
                                <Setter Property="Foreground" Value="#FAF7F5"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="views:NavProps.IsActive" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonFace" Property="Background" Value="#4A2C2C"/>
                                <Setter TargetName="ButtonFace" Property="BorderBrush" Value="#6D4545"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonFace" Property="Background" Value="#291818"/>
                                <Setter TargetName="ButtonFace" Property="BorderBrush" Value="#3D2222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootScaleGrid">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="MainScaleTransform" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarCol" Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ PRO ENTERPRISE MULTI-BUSINESS SIDEBAR ══ -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Brand Header (Profile-aware) -->
                <Border x:Name="BrandHeaderBorder" Grid.Row="0" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="18,0">
                    <Grid VerticalAlignment="Center">
                        <!-- 1A: Antique Pasabuy Header -->
                        <Grid x:Name="PasabuyBrandHeader" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="pack://application:,,,/pasabuy logo 2.png"
                                   Height="36"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   SnapsToDevicePixels="True"
                                   Margin="0,0,12,0"
                                   ToolTip="Antique Pasabuy &amp; Retail"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="DIONIX" Foreground="#818CF8" FontSize="14" FontWeight="Black" FontFamily="Segoe UI"/>
                                    <TextBlock Text=" POS" Foreground="White" FontSize="14" FontWeight="Black" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <TextBlock Text="ANTIQUE PASABUY" Foreground="#94A3B8" FontSize="9" FontWeight="Bold" FontFamily="Segoe UI" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <!-- 1B: Angelito's Bar & Resto Grill Header -->
                        <StackPanel x:Name="AngelitosBrandHeader" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border Background="#3D2222" BorderBrush="#5C3A3A" BorderThickness="1" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                                <md:PackIcon Kind="SilverwareForkKnife" Width="20" Height="20" Foreground="#D4B5AE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ANGELITO'S" Foreground="#D4B5AE" FontSize="13.5" FontWeight="Black" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <TextBlock Text="BAR &amp; RESTO GRILL" Foreground="#C9ADA7" FontSize="8.5" FontWeight="Bold" FontFamily="Segoe UI" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. HERO QUICK ACTION LAUNCHER (Angelito's only) -->
                <Border x:Name="HeroLauncherBorder" Grid.Row="1" Padding="12,12,12,6" Visibility="Collapsed">
                    <Grid>
                        <!-- Angelito's: + NEW SALE -->
                        <Button x:Name="NavBtn_NewSale"
                                Style="{StaticResource Pos3DPrimaryBtn}"
                                Click="OnNavButtonClick" Tag="RestoSales"
                                MinHeight="44" Padding="14,0" Cursor="Hand"
                                ToolTip="Create a new restaurant sale">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <md:PackIcon Kind="CashRegister" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="NEW SALE" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 3. DIRECT NAVIGATION LISTS -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,8">
                    <Grid>
                        <!-- ══ 3A: ANTIQUE PASABUY SIDEBAR (EXACT 9-ITEM ORDER) ══════════════════ -->
                        <StackPanel x:Name="PasabuyNavPanel">

                            <!-- 1. Dashboard -->
                            <Button x:Name="NavBtn_Dashboard" Style="{StaticResource Pos3DNavMainButtonStyle}" Click="OnNavButtonClick" Tag="Dashboard"
                                    ToolTip="View dashboard — operational summary and quick actions">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="ViewDashboardOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Dashboard" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>

                            <!-- 2. New Purchase Order -->
                            <Button x:Name="NavBtn_NewOrder" Style="{StaticResource Pos3DNavMainButtonStyle}" Click="OnNavButtonClick" Tag="NewOrder"
                                    ToolTip="Create a new Purchase Order">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="PlusCircleOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="New Purchase Order" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>

                            <!-- 3. Orders -->
                            <Button x:Name="NavBtn_Orders" Style="{StaticResource Pos3DNavMainButtonStyle}" Click="OnNavButtonClick" Tag="Orders"
                                    ToolTip="View and manage purchase orders">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="ClipboardListOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Orders" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>

                            <!-- Masterlists -->
                            <Button x:Name="NavBtn_Masterlists" Style="{StaticResource Pos3DNavMainButtonStyle}" Click="OnNavButtonClick" Tag="Masterlists"
                                    ToolTip="Masterlists — manage weekly customer order batches">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="ClipboardTextOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Masterlists" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>

                            <!-- Shopping Workspace -->
                            <Button x:Name="NavBtn_Buying" Style="{StaticResource Pos3DNavMainButtonStyle}" Click="OnNavButtonClick" Tag="Buying"
                                    ToolTip="Shopping workspace — mark items bought or unavailable">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="CartOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Shopping" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>

                            <!-- Products -->
                            <Button x:Name="NavBtn_Products" Style="{StaticResource Pos3DNavMainButtonStyle}" Click="OnNavButtonClick" Tag="Products"
                                    ToolTip="Manage your product list and prices">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="PackageVariantClosed" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Products" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>

                            <!-- Customers -->
                            <Button x:Name="NavBtn_Customers" Style="{StaticResource Pos3DNavMainButtonStyle}" Click="OnNavButtonClick" Tag="Customers">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="AccountMultipleOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Customers" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>

                            <!-- Stores -->
                            <Button x:Name="NavBtn_Stores" Style="{StaticResource Pos3DNavMainButtonStyle}" Click="OnNavButtonClick" Tag="Stores"
                                    ToolTip="Manage stores / suppliers">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="StorefrontOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Stores" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>

                            <!-- Reports -->
                            <Button x:Name="NavBtn_Reports" Style="{StaticResource Pos3DNavMainButtonStyle}" Click="OnNavButtonClick" Tag="Reports">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="ChartTimelineVariant" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Reports" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>

                            <!-- Settings -->
                            <Button x:Name="NavBtn_Settings" Style="{StaticResource Pos3DNavMainButtonStyle}" Click="OnNavButtonClick" Tag="Settings">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="CogOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Settings" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- ══ 3B: ANGELITO'S BAR & RESTO GRILL SIDEBAR ═════ -->
                        <StackPanel x:Name="AngelitosNavPanel" Visibility="Collapsed">
                            <!-- GROUP 1: OPERATIONS -->
                            <TextBlock Text="OPERATIONS" FontSize="9.5" FontWeight="Bold" Foreground="#B8998F" FontFamily="Segoe UI" Margin="8,8,0,4"/>

                            <!-- Dashboard -->
                            <Button x:Name="NavBtn_RestoDashboard" Style="{StaticResource Pos3DRestoNavMainButtonStyle}" Click="OnNavButtonClick" Tag="RestoDashboard">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="ViewDashboardOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Dashboard" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>

                            <!-- POS / Sales -->
                            <Button x:Name="NavBtn_RestoSales" Style="{StaticResource Pos3DRestoNavMainButtonStyle}" Click="OnNavButtonClick" Tag="RestoSales">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="CashRegister" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="POS / Sales" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>

                            <!-- Tables -->
                            <Button x:Name="NavBtn_RestoTables" Style="{StaticResource Pos3DRestoNavMainButtonStyle}" Click="OnNavButtonClick" Tag="RestoTables">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="TableChair" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Tables" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>

                            <!-- Orders -->
                            <Button x:Name="NavBtn_RestoOrders" Style="{StaticResource Pos3DRestoNavMainButtonStyle}" Click="OnNavButtonClick" Tag="RestoOrders">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="ClipboardListOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Orders" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>


                            <!-- GROUP 2: MANAGEMENT -->
                            <TextBlock Text="MANAGEMENT" FontSize="9.5" FontWeight="Bold" Foreground="#B8998F" FontFamily="Segoe UI" Margin="8,14,0,4"/>

                            <!-- Menu -->
                            <Button x:Name="NavBtn_RestoMenu" Style="{StaticResource Pos3DRestoNavMainButtonStyle}" Click="OnNavButtonClick" Tag="RestoMenu">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="FoodForkDrink" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Menu" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>

                            <!-- Inventory -->
                            <Button x:Name="NavBtn_RestoInventory" Style="{StaticResource Pos3DRestoNavMainButtonStyle}" Click="OnNavButtonClick" Tag="RestoInventory">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="Warehouse" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Inventory" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>

                            <!-- Customers -->
                            <Button x:Name="NavBtn_RestoCustomers" Style="{StaticResource Pos3DRestoNavMainButtonStyle}" Click="OnNavButtonClick" Tag="RestoCustomers">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="AccountMultipleOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Customers" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>

                            <!-- Staff -->
                            <Button x:Name="NavBtn_RestoStaff" Style="{StaticResource Pos3DRestoNavMainButtonStyle}" Click="OnNavButtonClick" Tag="RestoStaff">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="AccountTieOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Staff" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>

                            <!-- GROUP 3: REPORTS -->
                            <TextBlock Text="REPORTS" FontSize="9.5" FontWeight="Bold" Foreground="#B8998F" FontFamily="Segoe UI" Margin="8,14,0,4"/>

                            <!-- Sales Reports -->
                            <Button x:Name="NavBtn_RestoSalesReport" Style="{StaticResource Pos3DRestoNavMainButtonStyle}" Click="OnNavButtonClick" Tag="RestoSalesReport">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="ChartTimelineVariant" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Sales Reports" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>

                            <!-- Inventory Reports -->
                            <Button x:Name="NavBtn_RestoInventoryReport" Style="{StaticResource Pos3DRestoNavMainButtonStyle}" Click="OnNavButtonClick" Tag="RestoInventoryReport">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="FileChartOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Inventory Reports" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>

                            <!-- GROUP 4: SYSTEM -->
                            <TextBlock Text="SYSTEM" FontSize="9.5" FontWeight="Bold" Foreground="#B8998F" FontFamily="Segoe UI" Margin="8,14,0,4"/>

                            <!-- Settings -->
                            <Button x:Name="NavBtn_RestoSettings" Style="{StaticResource Pos3DRestoNavMainButtonStyle}" Click="OnNavButtonClick" Tag="Settings">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="CogOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Settings" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 4. User Profile & Logout Section -->
                <Border x:Name="SidebarBottomBorder" Grid.Row="3" BorderBrush="#382463" BorderThickness="0,1,0,0" Padding="14,12" Background="#1B0E38">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="AvatarBorder" Grid.Column="0" CornerRadius="18" Width="36" Height="36" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#452B86" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock x:Name="AvatarInitials" Text="AD" Foreground="White"
                                       FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameLabel" Text="Admin" Foreground="White"
                                       FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                            <Border x:Name="UserRoleBadgeBorder" Background="#351F68" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left" Margin="0,2,0,0">
                                <TextBlock x:Name="UserRoleLabel" Text="Administrator" Foreground="#C4B5FD"
                                           FontSize="9.5" FontWeight="Bold" FontFamily="Segoe UI"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#A99FC5" ToolTip="Logout" Padding="6"
                                Click="OnLogout" Cursor="Hand">
                            <md:PackIcon Kind="LogoutVariant" Width="18" Height="18"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ══ MAIN AREA ════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="{DynamicResource PosBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Topbar -->
            <Border Grid.Row="0" Background="{DynamicResource PosSurface}"
                    BorderBrush="{DynamicResource PosBorder}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock x:Name="PageTitleLabel" Text="Dashboard"
                                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="BreadcrumbLabel" Text="Home / Dashboard"
                                   FontSize="11.5" Foreground="{DynamicResource PosMutedText}" FontFamily="Segoe UI" Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Active Pasabuy Batch Pill & Switcher -->
                        <Border x:Name="ActiveBatchBadge" Visibility="Collapsed" Background="#F5F3FF" BorderBrush="#C4B5FD" BorderThickness="1.5" CornerRadius="8" Padding="10,4" Margin="0,0,10,0"
                                ToolTip="Current Active Pasabuy Batch / Trip. Click to change.">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <md:PackIcon Kind="AirplaneTakeoff" Width="15" Height="15" Foreground="#6D28D9" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Trip Batch: " FontSize="11" FontWeight="SemiBold" Foreground="#6D28D9" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ActiveBatchLabel" Text="AUG 2" FontSize="11.5" FontWeight="Black" Foreground="#4338CA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="Switch" Click="OnSwitchActiveBatch"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Height="22" Padding="6,0" FontSize="10" FontWeight="Bold"
                                        Foreground="#6D28D9" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Modern Date Badge -->
                        <Border Background="{DynamicResource PosPanel}" BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <md:PackIcon Kind="CalendarClockOutline" Width="15" Height="15" Foreground="{DynamicResource PosPrimary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="DateLabel" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PosSecondaryText}" FontSize="11.5" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>
                        <!-- Modern Theme Toggle -->
                        <Button Style="{StaticResource Pos3DSecondaryBtn}" MinWidth="36" MinHeight="36" Padding="6"
                                ToolTip="Toggle Theme (Light / Dark)" Click="OnThemeToggle" Cursor="Hand">
                            <md:PackIcon x:Name="ThemeIcon" Kind="WeatherSunny" Width="18" Height="18" Foreground="{DynamicResource PosPrimary}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content frame -->
            <Frame x:Name="ContentFrame" Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   Background="{DynamicResource PosBackground}"/>
        </Grid>
    </Grid>
</Window>
