<Page x:Class="AntiquePasabuyPOS.Views.Pages.RestoReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource PosBackground}"
      SnapsToDevicePixels="True">
    <Page.Resources>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="RestoReportTextCenter">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="RestoReportTextCenterBold">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Page.Resources>

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Tab Buttons -->
            <RowDefinition Height="*"/>    <!-- Reports Panels -->
        </Grid.RowDefinitions>

        <!-- ══ 0. HEADER ═════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Restaurant Analytics &amp; Reports" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource PosPrimaryText}"/>
                <TextBlock Text="Financial performance, sales breakdowns, bar revenue, and inventory stock valuations."
                           FontSize="12" Foreground="{DynamicResource PosSecondaryText}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ══ 1. REPORT TABS ═════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnTabSales" Content="📊 Sales &amp; Revenue Analytics" Click="OnTabSalesClick"
                        Style="{StaticResource Pos3DPrimaryBtn}" Height="34" Padding="18,0" Margin="0,0,8,0" Cursor="Hand"/>
                <Button x:Name="BtnTabInventory" Content="📦 Inventory &amp; Stock Valuation" Click="OnTabInventoryClick"
                        Style="{StaticResource Pos3DSecondaryBtn}" Height="34" Padding="18,0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- ══ 2. REPORT CONTENT ══════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <!-- ── A. Sales Report Panel ─────────────────────────────────── -->
            <Grid x:Name="SalesReportsPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- KPI Summary Cards -->
                    <RowDefinition Height="Auto"/> <!-- Date & Search Toolbar -->
                    <RowDefinition Height="*"/>    <!-- Sales DataGrid -->
                </Grid.RowDefinitions>

                <!-- KPI Ribbon (4 Elevated Cards) -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Revenue -->
                    <Border Grid.Column="0" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <Grid>
                            <Border Height="3" VerticalAlignment="Top" Background="#16A34A" CornerRadius="2" Margin="0,-10,0,0"/>
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="TOTAL REVENUE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}"/>
                                <TextBlock x:Name="TxtTotalRevenue" Text="₱0.00" FontSize="19" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TxtTotalOrdersCount" Text="0 orders" FontSize="11" Foreground="{DynamicResource PosMutedText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Average Ticket / Bill -->
                    <Border Grid.Column="2" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <Grid>
                            <Border Height="3" VerticalAlignment="Top" Background="#2563EB" CornerRadius="2" Margin="0,-10,0,0"/>
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="AVERAGE BILL" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}"/>
                                <TextBlock x:Name="TxtAvgOrderValue" Text="₱0.00" FontSize="19" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                                <TextBlock Text="Average per sale" FontSize="11" Foreground="{DynamicResource PosMutedText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Cash Revenue -->
                    <Border Grid.Column="4" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <Grid>
                            <Border Height="3" VerticalAlignment="Top" Background="#059669" CornerRadius="2" Margin="0,-10,0,0"/>
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="CASH SALES" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}"/>
                                <TextBlock x:Name="TxtCashSales" Text="₱0.00" FontSize="19" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                                <TextBlock Text="Physical cash collected" FontSize="11" Foreground="{DynamicResource PosMutedText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Digital / GCash Revenue -->
                    <Border Grid.Column="6" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <Grid>
                            <Border Height="3" VerticalAlignment="Top" Background="#0284C7" CornerRadius="2" Margin="0,-10,0,0"/>
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="GCASH / DIGITAL" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}"/>
                                <TextBlock x:Name="TxtDigitalSales" Text="₱0.00" FontSize="19" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0"/>
                                <TextBlock Text="E-wallet &amp; electronic" FontSize="11" Foreground="{DynamicResource PosMutedText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Date & Search Toolbar -->
                <Border Grid.Row="1" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Date Preset Pills -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" x:Name="ReportDatePillsPanel">
                            <Button Content="Today" Tag="Today" Click="OnReportDatePillClick" Style="{StaticResource Pos3DPrimaryBtn}" Height="30" Padding="12,0" Margin="0,0,5,0"/>
                            <Button Content="Yesterday" Tag="Yesterday" Click="OnReportDatePillClick" Style="{StaticResource Pos3DSecondaryBtn}" Height="30" Padding="12,0" Margin="0,0,5,0"/>
                            <Button Content="This Week" Tag="ThisWeek" Click="OnReportDatePillClick" Style="{StaticResource Pos3DSecondaryBtn}" Height="30" Padding="12,0" Margin="0,0,5,0"/>
                            <Button Content="This Month" Tag="ThisMonth" Click="OnReportDatePillClick" Style="{StaticResource Pos3DSecondaryBtn}" Height="30" Padding="12,0" Margin="0,0,5,0"/>
                            <Button Content="All Time" Tag="All" Click="OnReportDatePillClick" Style="{StaticResource Pos3DSecondaryBtn}" Height="30" Padding="12,0"/>
                        </StackPanel>

                        <!-- Search Box -->
                        <Border Grid.Column="1" Background="{DynamicResource PosBackground}" CornerRadius="6"
                                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" Padding="8,4" Margin="14,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <md:PackIcon Kind="Magnify" Width="16" Height="16" Foreground="{DynamicResource PosMutedText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtSearchReports" Grid.Column="1" BorderThickness="0" FontSize="12"
                                         Foreground="{DynamicResource PosPrimaryText}" CaretBrush="{DynamicResource PosPrimary}"
                                         md:HintAssist.Hint="Search sales, table, customer, payment..."
                                         md:TextFieldAssist.DecorationVisibility="Hidden"
                                         TextChanged="OnSearchReportsChanged"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Sales DataGrid -->
                <Border Grid.Row="2" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <DataGrid x:Name="SalesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                              RowBackground="{DynamicResource PosSurface}"
                              AlternatingRowBackground="{DynamicResource PosTableRow}"
                              MinRowHeight="42" FontFamily="Segoe UI" FontSize="12.5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sale No" Binding="{Binding SaleNo}" Width="155"
                                                ElementStyle="{StaticResource RestoReportTextCenterBold}"/>
                            <DataGridTextColumn Header="Table" Binding="{Binding TableNumber, TargetNullValue='Counter'}" Width="95"
                                                ElementStyle="{StaticResource RestoReportTextCenter}"/>
                            <DataGridTextColumn Header="Customer / Guest" Binding="{Binding CustomerName, TargetNullValue='Walk-in Guest'}" Width="*"
                                                ElementStyle="{StaticResource RestoReportTextCenter}"/>
                            <DataGridTextColumn Header="Payment" Binding="{Binding PaymentMethod}" Width="110"
                                                ElementStyle="{StaticResource RestoReportTextCenter}"/>
                            <DataGridTextColumn Header="Items Count" Binding="{Binding Items.Count, StringFormat='{}{0} items'}" Width="100"
                                                ElementStyle="{StaticResource RestoReportTextCenter}"/>
                            <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat='₱{0:N2}'}" Width="130" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PosPrimaryText}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding CreatedAt, StringFormat='MMM dd, yyyy  hh:mm tt'}" Width="170"
                                                ElementStyle="{StaticResource RestoReportTextCenter}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ── B. Inventory Report Panel ─────────────────────────────── -->
            <Grid x:Name="InventoryReportsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- KPI Summary Bar -->
                    <RowDefinition Height="Auto"/> <!-- Search & Filters -->
                    <RowDefinition Height="*"/>    <!-- Inventory DataGrid -->
                </Grid.RowDefinitions>

                <!-- Inventory KPI Ribbon (3 Cards) -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Border Height="3" VerticalAlignment="Top" Background="#6366F1" CornerRadius="2" Margin="0,-10,0,0"/>
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="TOTAL INVENTORY ITEMS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}"/>
                                <TextBlock x:Name="TxtInvItemCount" Text="0" FontSize="19" FontWeight="Bold" Foreground="#6366F1" Margin="0,4,0,0"/>
                                <TextBlock Text="Tracked ingredients &amp; bar supplies" FontSize="11" Foreground="{DynamicResource PosMutedText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="#FEF2F2" BorderBrush="#FCA5A5"
                            BorderThickness="1.5" CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Border Height="3" VerticalAlignment="Top" Background="#DC2626" CornerRadius="2" Margin="0,-10,0,0"/>
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="LOW STOCK ALERTS" FontSize="10.5" FontWeight="Bold" Foreground="#DC2626"/>
                                <TextBlock x:Name="TxtInvLowCount" Text="0" FontSize="19" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                                <TextBlock Text="Items requiring restocking" FontSize="11" Foreground="#991B1B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Border Height="3" VerticalAlignment="Top" Background="#16A34A" CornerRadius="2" Margin="0,-10,0,0"/>
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="TOTAL STOCK VALUATION" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}"/>
                                <TextBlock x:Name="TxtInvTotalValue" Text="₱0.00" FontSize="19" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                                <TextBlock Text="Current stock cost value" FontSize="11" Foreground="{DynamicResource PosMutedText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Search & Filters Toolbar -->
                <Border Grid.Row="1" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Inventory Items Masterlist" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource PosPrimaryText}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="{DynamicResource PosBackground}" CornerRadius="6"
                                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" Padding="8,4" Margin="14,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <md:PackIcon Kind="Magnify" Width="16" Height="16" Foreground="{DynamicResource PosMutedText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtSearchInventory" Grid.Column="1" BorderThickness="0" FontSize="12"
                                         Foreground="{DynamicResource PosPrimaryText}" CaretBrush="{DynamicResource PosPrimary}"
                                         md:HintAssist.Hint="Filter by item name, code, category..."
                                         md:TextFieldAssist.DecorationVisibility="Hidden"
                                         TextChanged="OnSearchInventoryChanged"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Inventory DataGrid -->
                <Border Grid.Row="2" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <DataGrid x:Name="InventoryReportGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                              RowBackground="{DynamicResource PosSurface}"
                              AlternatingRowBackground="{DynamicResource PosTableRow}"
                              MinRowHeight="40" FontFamily="Segoe UI" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}" Width="100"
                                                ElementStyle="{StaticResource RestoReportTextCenter}"/>
                            <DataGridTextColumn Header="Item Name" Binding="{Binding Name}" Width="*"
                                                ElementStyle="{StaticResource RestoReportTextCenterBold}"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"
                                                ElementStyle="{StaticResource RestoReportTextCenter}"/>
                            <DataGridTextColumn Header="On-Hand" Binding="{Binding Quantity, StringFormat='{}{0:N1}'}" Width="95" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="75"
                                                ElementStyle="{StaticResource RestoReportTextCenter}"/>
                            <DataGridTextColumn Header="Min Stock" Binding="{Binding MinStockLevel, StringFormat='{}{0:N0}'}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Unit Cost" Binding="{Binding CostPrice, StringFormat='₱{0:N2}'}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Total Value" Binding="{Binding StockValue, StringFormat='₱{0:N2}'}" Width="125" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PosPrimaryText}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StockStatus}" FontWeight="Bold" FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
