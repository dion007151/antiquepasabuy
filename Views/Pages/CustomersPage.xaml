<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AntiquePasabuyPOS.Views.Pages.CustomersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource PosBackground}"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">
    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER &amp; ACTION ════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Border Background="#E0F2FE" CornerRadius="8" Padding="7" Margin="0,0,10,0" VerticalAlignment="Center">
                        <md:PackIcon Kind="AccountGroupOutline" Width="18" Height="18" Foreground="#0369A1"/>
                    </Border>
                    <TextBlock Text="Customers" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Manage customer contacts, addresses, and purchase order history"
                           Foreground="{DynamicResource PosSecondaryText}" FontSize="12" FontFamily="Segoe UI" Margin="40,2,0,0"/>
            </StackPanel>
            <Button Style="{StaticResource Pos3DPrimaryBtn}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="OnAddCustomer" Height="38" Padding="16,0">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="AccountPlus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="+ NEW CUSTOMER" FontWeight="Bold" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ══ SEARCH BOX &amp; SELECTION TOOLBAR ══════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PosSurface}" CornerRadius="10"
                    BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" Margin="0,0,10,0" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <md:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="{DynamicResource PosMutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                             FontSize="12.5" FontFamily="Segoe UI" VerticalAlignment="Center"
                             Foreground="{DynamicResource PosPrimaryText}"
                             CaretBrush="{DynamicResource PosPrimary}"
                             md:HintAssist.Hint="Search by name, phone, address, or code..."
                             md:TextFieldAssist.DecorationVisibility="Hidden"
                             TextChanged="OnSearch"/>
                    <Button Grid.Column="2" Content="&#x2715;" Click="OnClearSearch"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource PosMutedText}" Padding="6,2" FontSize="11"
                            ToolTip="Clear search"/>
                </Grid>
            </Border>

            <!-- Selection / Bulk Toolbar -->
            <Border Grid.Column="1" Background="{DynamicResource PosSurface}" CornerRadius="10"
                    BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" Padding="8,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource PosLightBlue}" CornerRadius="6"
                            Padding="7,3" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedCountLabel" Text="0 selected"
                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PosPrimary}"/>
                    </Border>
                    <Button Click="OnSelectAllClick" Style="{StaticResource Pos3DFilterBtn}" Height="30" Padding="8,0" Margin="0,0,4,0" ToolTip="Select all visible customers">
                        <TextBlock Text="Select All" FontSize="11" FontWeight="SemiBold"/>
                    </Button>
                    <Button Click="OnClearSelectionClick" Style="{StaticResource Pos3DFilterBtn}" Height="30" Padding="8,0" Margin="0,0,4,0" ToolTip="Clear selection">
                        <TextBlock Text="Clear" FontSize="11" FontWeight="SemiBold"/>
                    </Button>
                    <Button x:Name="BulkDeleteBtn" Click="OnBulkDeleteClick" Style="{StaticResource Pos3DDangerBtn}" Height="30" Padding="10,0" IsEnabled="False" ToolTip="Delete selected customers">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="DeleteOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Delete" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ CUSTOMERS DATAGRID ═════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                BorderThickness="1" CornerRadius="10" Padding="2">
            <DataGrid x:Name="CustomersGrid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" Style="{StaticResource MaterialDesignDataGrid}"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      MinRowHeight="50" AlternationCount="2" FontFamily="Segoe UI" FontSize="12.5"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" BorderThickness="0">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="FontSize" Value="10.5"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="{DynamicResource PosSecondaryText}"/>
                        <Setter Property="Padding" Value="8,8"/>
                        <Setter Property="Background" Value="{DynamicResource PosBackground}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <!-- SELECTION CHECKBOX -->
                    <DataGridTemplateColumn Width="46" CanUserResize="False">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="HeaderSelectAll" Click="OnHeaderSelectAllClick"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip="Select / Deselect all visible customers"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Click="OnRowCheckBoxClick"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Avatar + Code -->
                    <DataGridTemplateColumn Header="Code" Width="100" SortMemberPath="Code">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                                    <Border Width="30" Height="30" CornerRadius="15"
                                            Background="{DynamicResource PosLightPurple}" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding InitialsDisplay}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource PosPrimary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Code, TargetNullValue='CUST'}" FontSize="11.5"
                                               VerticalAlignment="Center" Foreground="{DynamicResource PosSecondaryText}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Name -->
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" FontWeight="SemiBold">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Phone -->
                    <DataGridTemplateColumn Header="Phone" Width="140" SortMemberPath="Phone">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <md:PackIcon Kind="Phone" Width="12" Height="12" Foreground="{DynamicResource PosMutedText}"
                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Phone, TargetNullValue='No phone'}" FontSize="12"
                                               Foreground="{DynamicResource PosPrimaryText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Address -->
                    <DataGridTextColumn Header="Address" Binding="{Binding Address, TargetNullValue='No address'}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{DynamicResource PosSecondaryText}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Orders Count -->
                    <DataGridTemplateColumn Header="Orders" Width="80" SortMemberPath="Orders.Count">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PosPanel}" CornerRadius="6" Padding="8,2"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Orders.Count, TargetNullValue='0'}"
                                               FontWeight="Bold" FontSize="12"
                                               Foreground="{DynamicResource PosPrimary}" HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                    <Button Style="{StaticResource Pos3DTableActionBtn}"
                                            Margin="0,0,6,0" Click="OnViewCustomer" Tag="{Binding Id}"
                                            ToolTip="View customer profile and history">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="EyeOutline" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="VIEW"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Pos3DTableMoreBtn}"
                                            Click="OnMoreMenuClick" Tag="{Binding Id}"
                                            ToolTip="More Actions">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Edit Customer" Click="OnEditCustomerFromMenu">
                                                    <MenuItem.Icon>
                                                        <md:PackIcon Kind="PencilOutline" Width="16" Height="16" Foreground="{DynamicResource PosPrimary}"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Delete Customer" Click="OnDeleteCustomerFromMenu" Foreground="#EF4444">
                                                    <MenuItem.Icon>
                                                        <md:PackIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="#EF4444"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
