<Page x:Class="AntiquePasabuyPOS.Views.Pages.PaymentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:views="clr-namespace:AntiquePasabuyPOS.Views"
      Background="{DynamicResource PosBackground}"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER & QUICK ACTIONS ═════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Payments &amp; GCash" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"/>
                <TextBlock Text="Record GCash, cash, and unpaid order balances"
                           Foreground="{DynamicResource PosSecondaryText}" FontSize="12" FontFamily="Segoe UI" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Quick Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search Box -->
                <Border Background="{DynamicResource PosSurface}" CornerRadius="10"
                        BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                        Padding="10,5" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Grid Width="220">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <md:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18"
                                     Foreground="{DynamicResource PosMutedText}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 BorderThickness="0" Background="Transparent"
                                 FontSize="12.5" FontFamily="Segoe UI" VerticalAlignment="Center"
                                 Foreground="{DynamicResource PosPrimaryText}"
                                 CaretBrush="{DynamicResource PosPrimary}"
                                 TextChanged="OnSearchChanged"
                                 md:HintAssist.Hint="Search order, customer..."
                                 md:TextFieldAssist.DecorationVisibility="Hidden"/>
                        <Button x:Name="ClearSearchBtn" Grid.Column="2" Click="OnClearSearch"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Width="22" Height="22" Padding="0" Margin="4,0,0,0"
                                Visibility="Collapsed">
                            <md:PackIcon Kind="CloseCircleOutline" Width="15" Height="15" Foreground="{DynamicResource PosMutedText}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 1. [ + MARK AS PAID ] -->
                <Button Click="OnCollectPaymentClick"
                        Style="{StaticResource Pos3DPrimaryBtn}"
                        Margin="0,0,8,0" Height="38" Padding="14,0"
                        ToolTip="Record customer payment for an order">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="CashPlus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="+ MARK AS PAID" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Refresh -->
                <Button Click="OnRefresh"
                        Style="{StaticResource Pos3DSecondaryBtn}"
                        Width="38" Height="38" Padding="0"
                        ToolTip="Refresh">
                    <md:PackIcon Kind="Refresh" Width="16" Height="16" Foreground="{DynamicResource PosSecondaryText}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══ KPI CARDS & FILTER TABS ═════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- KPI Metric Cards -->
            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,12">
                <Border Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                        BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="UNPAID BALANCE DUE" FontSize="9.5" FontWeight="Bold" Foreground="#EF4444" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="UnpaidTotalLabel" Text="₱0.00" FontSize="18" FontWeight="Bold" Foreground="#DC2626" FontFamily="Segoe UI" Margin="0,3,0,0"/>
                        <TextBlock x:Name="UnpaidOrdersCountLabel" Text="0 Orders pending payment" FontSize="10" Foreground="{DynamicResource PosMutedText}"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                        BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="TODAY'S PAYMENTS" FontSize="9.5" FontWeight="Bold" Foreground="#059669" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="TodayLabel" Text="₱0.00" FontSize="18" FontWeight="Bold" Foreground="#059669" FontFamily="Segoe UI" Margin="0,3,0,0"/>
                        <TextBlock x:Name="TodayCountLabel" Text="0 Payments recorded today" FontSize="10" Foreground="{DynamicResource PosMutedText}"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                        BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="THIS MONTH TOTAL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PosPrimary}" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="MonthLabel" Text="₱0.00" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PosPrimary}" FontFamily="Segoe UI" Margin="0,3,0,0"/>
                        <TextBlock x:Name="TotalTransactionsLabel" Text="0 Total transactions" FontSize="10" Foreground="{DynamicResource PosMutedText}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Quick Filter Tabs -->
            <Border Grid.Row="1" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="6,5">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TabUnpaid" Click="OnTabClick" Tag="unpaid"
                            Style="{StaticResource Pos3DFilterBtn}" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ClockAlertOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TabUnpaidText" Text="UNPAID ORDERS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabToday" Click="OnTabClick" Tag="today"
                            Style="{StaticResource Pos3DFilterBtn}" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="CalendarToday" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="TODAY'S PAYMENTS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabAll" Click="OnTabClick" Tag="all"
                            Style="{StaticResource Pos3DFilterBtn}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="History" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="ALL TRANSACTIONS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ GRID ROW 2: TABLES & COLLECTION MODAL ══════════════════════════ -->
        <Grid Grid.Row="2">
            <!-- Table 1: Unpaid Orders Queue -->
            <Border x:Name="UnpaidOrdersContainer" Background="{DynamicResource PosSurface}"
                    BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="2" Visibility="Visible">
                <Grid>
                    <DataGrid x:Name="UnpaidOrdersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" Style="{StaticResource MaterialDesignDataGrid}"
                              MinRowHeight="48" AlternationCount="2" FontFamily="Segoe UI" FontSize="12.5"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PO #" Binding="{Binding OrderNo}" Width="95" FontWeight="SemiBold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name, TargetNullValue='Walk-in Customer'}" Width="1.5*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Customer.Phone, TargetNullValue='—'}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="{Binding Status, Converter={StaticResource StatusColorConv}}"
                                                ToolTip="{Binding Status, Converter={StaticResource StatusTooltipConv}}">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusTextConv}}" Foreground="White"
                                                       FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat='₱{0:N2}'}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Paid" Binding="{Binding TotalPaid, StringFormat='₱{0:N2}'}" Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Balance" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Balance, StringFormat='₱{0:N2}'}" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Action: [ MARK AS PAID ] -->
                            <DataGridTemplateColumn Header="Action" Width="Auto" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="OnCollectRowClick" Tag="{Binding Id}"
                                                Style="{StaticResource Pos3DTableSuccessBtn}">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="CashCheck" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="MARK AS PAID" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State for Unpaid Orders -->
                    <Border x:Name="EmptyStatePanelUnpaid" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <md:PackIcon Kind="CheckCircleOutline" Width="44" Height="44" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="No Unpaid Orders" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PosPrimaryText}" HorizontalAlignment="Center"/>
                            <TextBlock Text="All customer orders are fully paid or settled." FontSize="12" Foreground="{DynamicResource PosSecondaryText}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Table 2: Payment Transactions History -->
            <Border x:Name="TransactionsContainer" Background="{DynamicResource PosSurface}"
                    BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="2" Visibility="Collapsed">
                <Grid>
                    <DataGrid x:Name="MainGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" Style="{StaticResource MaterialDesignDataGrid}"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              MinRowHeight="46" AlternationCount="2" FontFamily="Segoe UI" FontSize="12.5"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PO #" Binding="{Binding Order.OrderNo, TargetNullValue='N/A'}" Width="100" FontWeight="SemiBold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Order.Customer.Name, TargetNullValue='Walk-in Customer'}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Method" Binding="{Binding Method, TargetNullValue='Cash'}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='₱{0:N2}'}" Width="100" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Reference" Binding="{Binding Reference, TargetNullValue='—'}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding CreatedAt, StringFormat='MMM dd, yyyy hh:mm tt'}" Width="155">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State for Transactions -->
                    <Border x:Name="EmptyStatePanelTransactions" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <md:PackIcon Kind="ReceiptTextOutline" Width="44" Height="44" Foreground="{DynamicResource PosMutedText}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="No Transactions Found" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PosPrimaryText}" HorizontalAlignment="Center"/>
                            <TextBlock Text="No recorded payments match the current filter." FontSize="12" Foreground="{DynamicResource PosSecondaryText}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Collection Dialog / Modal Overlay -->
            <Grid x:Name="CollectionModal" Background="#80000000" Visibility="Collapsed">
                <Border Background="{DynamicResource PosSurface}" CornerRadius="8" Width="440"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="24" md:ElevationAssist.Elevation="Dp5"
                        BorderBrush="{DynamicResource PosBorder}" BorderThickness="1">
                    <StackPanel>
                        <!-- Modal Title -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Record Order Payment" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"/>
                                <TextBlock Text="Antique Pasabuy POS Payment Recording"
                                           Foreground="{DynamicResource PosSecondaryText}" FontSize="12" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Click="OnCancelCollection" Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Padding="2" Width="28" Height="28">
                                <md:PackIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource PosSecondaryText}"/>
                            </Button>
                        </Grid>

                        <!-- Order & Balance Info Box -->
                        <Border Background="{DynamicResource PosPanel}" BorderBrush="{DynamicResource PosBorder}"
                                BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="ModalOrderNoText" Text="Order: PB-000000" FontWeight="Bold"
                                               FontSize="13.5" Foreground="{DynamicResource PosPrimaryText}"/>
                                    <TextBlock x:Name="ModalCustomerText" Text="Customer: Walk-in"
                                               FontSize="12" Foreground="{DynamicResource PosSecondaryText}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="BALANCE DUE" FontSize="9.5" FontWeight="Bold" Foreground="#DC2626"/>
                                    <TextBlock x:Name="ModalBalanceText" Text="₱0.00" FontSize="18" FontWeight="Bold" Foreground="#DC2626"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- If no specific order selected, show dropdown -->
                        <StackPanel x:Name="OrderSelectorPanel" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock Text="Select Unpaid Order" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="ModalOrderCombo" SelectionChanged="OnModalOrderSelected"
                                      DisplayMemberPath="OrderNo" SelectedValuePath="Id"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Padding="10,6" FontSize="12.5"/>
                        </StackPanel>

                        <!-- Amount to Collect -->
                        <TextBlock Text="Payment Amount (₱)" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,5"/>
                        <TextBox x:Name="ModalAmountBox" FontSize="16" FontWeight="Bold" Foreground="#059669"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,12" Padding="10,6"/>

                        <!-- Payment Method -->
                        <TextBlock Text="Payment Method" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ModalMethodCombo" SelectedIndex="0"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Margin="0,0,0,12" Padding="10,6" FontSize="12.5">
                            <ComboBoxItem Content="Cash"/>
                            <ComboBoxItem Content="GCash"/>
                            <ComboBoxItem Content="Bank Transfer"/>
                            <ComboBoxItem Content="Maya"/>
                            <ComboBoxItem Content="COD (Cash on Delivery)"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>

                        <!-- Reference No -->
                        <TextBlock Text="Reference / Transaction #" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,5"/>
                        <TextBox x:Name="ModalReferenceBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="e.g., GCash Ref 123456789"
                                 Margin="0,0,0,18" Padding="10,6" FontSize="12.5"/>

                        <!-- Modal Actions -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="OnCancelCollection"
                                    Style="{StaticResource Pos3DSecondaryBtn}" Height="40">
                                <TextBlock Text="Cancel" FontWeight="SemiBold" FontSize="12.5"/>
                            </Button>
                            <Button Grid.Column="2" Click="OnConfirmPaymentClick"
                                    Style="{StaticResource Pos3DSuccessBtn}" Height="40">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="CheckCircleOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="MARK AS PAID" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
