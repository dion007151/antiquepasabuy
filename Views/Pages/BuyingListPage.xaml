<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AntiquePasabuyPOS.Views.Pages.BuyingListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:conv="clr-namespace:AntiquePasabuyPOS.Converters"
      xmlns:views="clr-namespace:AntiquePasabuyPOS.Views"
      Background="{DynamicResource PosBackground}"
      Focusable="True"
      KeyDown="OnPageKeyDown"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- KPI Card Style -->
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PosSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <!-- Crisp Modern Filter ComboBox Style -->
        <Style x:Key="PosFilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PosPrimaryText}"/>
            <Setter Property="Background" Value="{DynamicResource PosSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0,24,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.ColumnSpan="2" x:Name="OuterBorder"
                                    Background="{DynamicResource PosSurface}"
                                    BorderBrush="{DynamicResource PosBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"/>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.ColumnSpan="2"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Style="{StaticResource MaterialDesignFlatButton}"
                                          Padding="0"/>

                            <ContentPresenter x:Name="ContentSite"
                                              Grid.Column="0"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,4,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource PosPrimaryText}"/>
                                        <Setter Property="FontSize" Value="11.5"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <md:PackIcon Grid.Column="1"
                                         Kind="ChevronDown"
                                         Width="13" Height="13"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         IsHitTestVisible="False"
                                         Foreground="{DynamicResource PosSecondaryText}"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource PosSurface}"
                                            BorderBrush="{DynamicResource PosBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,4,0,4">
                                        <ScrollViewer Margin="2,4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource PosPrimary}"/>
                                <Setter TargetName="OuterBorder" Property="Background" Value="#FAF5FF"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource PosPrimary}"/>
                                <Setter TargetName="OuterBorder" Property="Background" Value="#FAF5FF"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource PosMutedText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Buying DatePicker Style -->
        <Style x:Key="PosBuyingDatePickerStyle" TargetType="DatePicker"
               BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{DynamicResource PosPrimaryText}"/>
            <Setter Property="Background" Value="{DynamicResource PosSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorder}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="md:TextFieldAssist.TextBoxViewMargin" Value="0,0,32,0"/>
            <Style.Resources>
                <Style TargetType="DatePickerTextBox">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="Foreground" Value="{DynamicResource PosPrimaryText}"/>
                </Style>
            </Style.Resources>
        </Style>
    </Page.Resources>

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Sleek Top Header Bar -->
            <RowDefinition Height="Auto"/> <!-- Row 1: KPI Summary Cards Ribbon -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Consolidated Filters & Action Toolbar -->
            <RowDefinition Height="*"/>    <!-- Row 3: Full-Height Virtualized Unified DataGrid -->
        </Grid.RowDefinitions>

        <!-- ══ ROW 0: TOP HEADER BAR ═══════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Page Title & Operational Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EDE9FE" CornerRadius="8" Padding="7" Margin="0,0,10,0" VerticalAlignment="Center">
                        <md:PackIcon Kind="CartOutline" Width="18" Height="18" Foreground="#6D28D9" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="PageTitleText" Text="Shopping Workspace" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="PageSubtitleText" Text="Live shopping checklist, purchasing workflow &amp; cost auditing"
                           Foreground="{DynamicResource PosSecondaryText}" FontSize="12" FontFamily="Segoe UI" Margin="40,2,0,0"/>
            </StackPanel>

            <!-- Top Primary Operations -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Start Buying / Shopping Mode -->
                <Button x:Name="StartBuyingBtn" Click="OnStartBuyingClick"
                        Style="{StaticResource Pos3DSecondaryBtn}" Margin="0,0,8,0" Height="38" Padding="14,0"
                        ToolTip="Mark pending orders as currently being bought">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ShoppingOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource PosPrimary}"/>
                        <TextBlock Text="Start Shopping" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- Barcode / Camera Scanner (F2) -->
                <Button x:Name="BarcodeScannerBtn" Click="OnToggleBarcodeScanner"
                        Style="{StaticResource Pos3DSecondaryBtn}" Height="38" Padding="14,0" Margin="0,0,8,0"
                        ToolTip="Open live camera barcode scanner (F2) to scan and mark items purchased">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="BarcodeScan" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Scanner (F2)" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- PRINT SHOPPING CHECKLIST -->
                <Button x:Name="PrintBuyingListBtn" Click="OnPrintBuyingListClick"
                        Style="{StaticResource Pos3DPrimaryBtn}"
                        Height="38" Padding="16,0" Margin="0,0,8,0"
                        ToolTip="Print paper checklist to bring to the market or stores">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="PrinterCheck" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="PRINT CHECKLIST" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- FINISH SHOPPING -->
                <Button x:Name="CompleteBuyingBtn" Click="OnCompleteBuyingClick"
                        Style="{StaticResource Pos3DSuccessBtn}"
                        Height="38" Padding="14,0" Margin="0,0,8,0"
                        ToolTip="Finalize shopping for orders when all items are bought">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="CheckAll" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Finish Shopping" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- More Actions Menu [ ••• ] -->
                <Button Click="OnMoreActionsClick"
                        Style="{StaticResource Pos3DTableMoreBtn}"
                        Height="38" Width="38"
                        ToolTip="More options (Export to Excel, Refresh)"/>
            </StackPanel>
        </Grid>

        <!-- ══ ROW 1: KPI SUMMARY CARDS RIBBON ═════════════════════════════════ -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,12">
            <!-- Stores Pillar -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#FEF3C7" CornerRadius="6" Padding="5" Margin="0,0,8,0">
                            <md:PackIcon Kind="StorefrontOutline" Width="14" Height="14" Foreground="#D97706"/>
                        </Border>
                        <TextBlock Text="STORES" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="StoresCountLabel" Text="0 stores" FontSize="18" FontWeight="Black" Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- POs Pillar -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#EDE9FE" CornerRadius="6" Padding="5" Margin="0,0,8,0">
                            <md:PackIcon Kind="ClipboardListOutline" Width="14" Height="14" Foreground="#6D28D9"/>
                        </Border>
                        <TextBlock Text="PURCHASE ORDERS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="POsCountLabel" Text="0 POs" FontSize="18" FontWeight="Black" Foreground="#6D28D9" FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- Items Pillar -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#E0F2FE" CornerRadius="6" Padding="5" Margin="0,0,8,0">
                            <md:PackIcon Kind="FormatListBulleted" Width="14" Height="14" Foreground="#0284C7"/>
                        </Border>
                        <TextBlock Text="DISTINCT ITEMS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="ItemsCountLabel" Text="0 items" FontSize="18" FontWeight="Black" Foreground="#0284C7" FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- Qty Pillar -->
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#F0FDF4" CornerRadius="6" Padding="5" Margin="0,0,8,0">
                            <md:PackIcon Kind="PackageVariant" Width="14" Height="14" Foreground="#16A34A"/>
                        </Border>
                        <TextBlock Text="TOTAL QTY" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TotalQtyLabel" Text="0 units" FontSize="18" FontWeight="Black" Foreground="#16A34A" FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- Estimated Capital Pillar -->
            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#ECFDF5" CornerRadius="6" Padding="5" Margin="0,0,8,0">
                            <md:PackIcon Kind="CashMultiple" Width="14" Height="14" Foreground="#059669"/>
                        </Border>
                        <TextBlock Text="EST. CAPITAL" FontSize="9.5" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="EstBudgetLabel" Text="&#x20B1;0.00" FontSize="18" FontWeight="Black" Foreground="#059669" FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ══ ROW 2: CONSOLIDATED FILTERS & COMMAND TOOLBAR ═══════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tier 1: Search & Filter Selectors -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Filters Wrap -->
                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- Store Filter Dropdown -->
                        <ComboBox x:Name="StoreFilterCombo" Width="150" Height="36" Margin="0,0,8,0"
                                  Style="{StaticResource PosFilterComboBoxStyle}"
                                  SelectionChanged="OnFilterChanged"/>

                        <!-- Shopping Progress / Status Filter -->
                        <ComboBox x:Name="StatusFilterCombo" Width="140" Height="36" Margin="0,0,8,0"
                                  Style="{StaticResource PosFilterComboBoxStyle}"
                                  SelectionChanged="OnFilterChanged"/>

                        <!-- Scheduled Shopping Day / Date Picker -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <DatePicker x:Name="BuyingDatePicker"
                                        Style="{StaticResource PosBuyingDatePickerStyle}"
                                        md:HintAssist.Hint="Shopping Date"
                                        SelectedDateChanged="OnBuyingDateChanged"
                                        ToolTip="Select specific shopping run date to filter and print"/>
                            <Button x:Name="ClearDateBtn" Content="✕" Click="OnClearDateFilter"
                                    Style="{StaticResource Pos3DFilterBtn}"
                                    Margin="4,0,0,0" Height="36" Width="30" Padding="0"
                                    FontSize="11" Foreground="{DynamicResource PosMutedText}"
                                    ToolTip="Clear date filter (show all dates)"
                                    Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Today Only Filter -->
                        <Button x:Name="TodayBuyingBtn" Click="OnTodayBuyingToggle"
                                Style="{StaticResource Pos3DFilterBtn}" Margin="0,0,8,0" Height="36" Padding="12,0"
                                ToolTip="Filter list to show items scheduled for today">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="CalendarCheckOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TodayBtnText" Text="Today Only" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11.5"/>
                            </StackPanel>
                        </Button>

                        <!-- Group By Store Toggle -->
                        <Button x:Name="GroupByStoreBtn" Click="OnGroupByStoreToggle"
                                Style="{StaticResource Pos3DFilterBtn}" Height="36" Padding="12,0" Margin="0,0,8,0"
                                ToolTip="Group list by store or show single flat list">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="StorefrontOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Group by Store" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11.5"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Real-Time Debounced Search Box -->
                    <Border Grid.Column="1" Background="{DynamicResource PosBackground}" CornerRadius="8"
                            BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" Padding="10,4" Width="290" Height="36">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <md:PackIcon Kind="Magnify" Width="16" Height="16" Foreground="{DynamicResource PosMutedText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                     FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center"
                                     Foreground="{DynamicResource PosPrimaryText}"
                                     CaretBrush="{DynamicResource PosPrimary}"
                                     md:HintAssist.Hint="Search item, store, customer, PO #..."
                                     md:TextFieldAssist.DecorationVisibility="Hidden"
                                     TextChanged="OnSearchTextChanged"/>
                            <Button Grid.Column="2" Content="✕" Click="OnClearSearch"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="{DynamicResource PosMutedText}" Padding="4,1" FontSize="11"
                                    ToolTip="Clear search"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Tier 2: Selection Counter & Multi-Row Batch Operations -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Selection Status Pill & Select Shortcuts -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource PosPanel}" BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                                CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                            <TextBlock x:Name="SelectedSummaryLabel" Text="0 of 0 selected (Est: &#x20B1;0.00)"
                                       FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PosPrimaryText}" VerticalAlignment="Center"/>
                        </Border>

                        <Button Click="OnSelectAllClick" Style="{StaticResource Pos3DFilterBtn}" Height="32" Padding="10,0" Margin="0,0,6,0" ToolTip="Select all items">
                            <TextBlock Text="Select All" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                        <Button Click="OnDeselectAllClick" Style="{StaticResource Pos3DFilterBtn}" Height="32" Padding="10,0" Margin="0,0,6,0" ToolTip="Clear selection">
                            <TextBlock Text="Clear" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                        <Button Click="OnSelectPendingClick" Style="{StaticResource Pos3DFilterBtn}" Height="32" Padding="10,0" Margin="0,0,12,0" ToolTip="Select pending items only">
                            <TextBlock Text="Pending Only" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>

                    <!-- Batch Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BulkPurchasedBtn" Click="OnBulkMarkPurchasedClick"
                                Style="{StaticResource Pos3DSuccessBtn}"
                                Height="32" Padding="12,0" Margin="0,0,8,0"
                                IsEnabled="False" Opacity="0.5"
                                ToolTip="Mark all checked items as Purchased">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="CheckCircleOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Mark as Bought" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BulkUnavailableBtn" Click="OnBulkMarkUnavailableClick"
                                Style="{StaticResource Pos3DDangerBtn}"
                                Height="32" Padding="12,0" Margin="0,0,8,0"
                                IsEnabled="False" Opacity="0.5"
                                ToolTip="Mark all checked items as Unavailable">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="CloseCircleOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Mark Unavailable" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BulkDeleteBtn" Click="OnBulkDeleteSelectedClick"
                                Style="{StaticResource Pos3DTableDangerBtn}"
                                Height="32" Padding="12,0"
                                IsEnabled="False" Opacity="0.5"
                                ToolTip="Delete all checked items from their orders">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="TrashCanOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Delete" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Hidden Combos & Panels kept for programmatic binding -->
        <ComboBox x:Name="DayFilterCombo" Visibility="Collapsed"/>
        <StackPanel x:Name="QuickSubFiltersPanel" Visibility="Collapsed"/>
        <StackPanel x:Name="SubFilterButtons" Visibility="Collapsed"/>

        <!-- ══ ROW 3: UNIFIED VIRTUALIZED DATAGRID (FULL HEIGHT) ═══════════════ -->
        <Border Grid.Row="3" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                BorderThickness="1" CornerRadius="10" Padding="0">
            <Grid>
                <DataGrid x:Name="MainBuyingGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          Style="{StaticResource MaterialDesignDataGrid}"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          MinRowHeight="48" AlternationCount="2"
                          FontFamily="Segoe UI" FontSize="12"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent" BorderThickness="0">

                    <!-- Native WPF GroupStyle for Store Groups with sticky pinned headers -->
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True" Background="Transparent" BorderThickness="0">
                                                    <Expander.Header>
                                                        <Border Background="{DynamicResource PosPanel}" BorderBrush="{DynamicResource PosBorder}"
                                                                BorderThickness="0,1,0,1" Padding="14,8" Margin="-2,2,-2,2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Background="#FEF3C7" CornerRadius="6" Padding="4" Margin="0,0,8,0">
                                                                        <md:PackIcon Kind="Storefront" Width="14" Height="14" Foreground="#D97706" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PosPrimaryText}" VerticalAlignment="Center"/>
                                                                    <Border Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} item(s)'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Expander.Header>
                                                    <ItemsPresenter/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>

                    <DataGrid.Columns>
                        <!-- 1. Selection Checkbox -->
                        <DataGridTemplateColumn Width="46" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Cursor="Hand" ToolTip="Check to select item"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 2. Product Name & Notes -->
                        <DataGridTemplateColumn Header="Product / Item Name" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="0,3">
                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="12.5"
                                                   Foreground="{DynamicResource PosPrimaryText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ProductName}"/>
                                        <TextBlock Text="{Binding NotesDisplay}" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"
                                                   FontSize="11" FontStyle="Italic" Foreground="#D97706" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding NotesDisplay}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        
                        <!-- 3. Quantity Column -->
                        <DataGridTextColumn Header="Qty" Binding="{Binding QtyDisplay}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PosPrimaryText}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 4. Customer & PO # Column -->
                        <DataGridTemplateColumn Header="Customer / PO #" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CustomerDisplay}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource PosPrimaryText}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding OrderDateDisplay}" FontSize="10" Foreground="{DynamicResource PosMutedText}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 5. Estimated Price Column -->
                        <DataGridTextColumn Header="Est. Price" Binding="{Binding EstimatedPrice, StringFormat='₱{0:N2}'}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PosSecondaryText}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 6. Actual Price Column -->
                        <DataGridTemplateColumn Header="Actual" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ActualPriceDisplay}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PosPrimary}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        
                        <!-- 7. Status Column -->
                        <DataGridTemplateColumn Header="Status" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBgBrush}" CornerRadius="6" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFgBrush}"
                                                   FontSize="10" FontWeight="Bold" TextAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 8. Actions Column -->
                        <DataGridTemplateColumn Header="Actions" Width="Auto" MinWidth="168">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- When Pending: [ Bought ] [ From stock ] [ Not available ] -->
                                        <Button Content="Bought" Tag="{Binding}"
                                                Click="OnMarkPurchasedClick"
                                                Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource Pos3DTableSuccessBtn}"
                                                Margin="0,0,6,0"/>
                                        <Button Content="From stock" Tag="{Binding}"
                                                Click="OnMarkBoughtFromStockClick"
                                                Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource Pos3DTableActionBtn}"
                                                Margin="0,0,6,0"
                                                ToolTip="Fulfill item directly from on-hand inventory"/>
                                        <Button Content="Not available" Tag="{Binding}"
                                                Click="OnMarkUnavailableClick"
                                                Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource Pos3DTableDangerBtn}"
                                                ToolTip="Item could not be purchased / out of stock at store"/>

                                        <!-- When Unavailable: [ RESOLVE ] -->
                                        <Button Content="RESOLVE" Tag="{Binding}"
                                                Click="OnResolveUnavailableClick"
                                                Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource Pos3DTableDangerBtn}"
                                                ToolTip="Resolve item: Try another store, contact customer, or remove item"/>

                                        <!-- When Bought from stock: [ VIEW ORDER ] and [ RESET ] -->
                                        <Button Content="VIEW ORDER" Tag="{Binding}"
                                                Click="OnViewOrderClick"
                                                Visibility="{Binding IsBoughtFromStock, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource Pos3DTableActionBtn}"
                                                Margin="0,0,6,0"/>
                                        <Button Content="RESET" Tag="{Binding}"
                                                Click="OnResetItemToPendingClick"
                                                Visibility="{Binding IsBoughtFromStock, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource Pos3DFilterBtn}"
                                                ToolTip="Revert back to Pending and restore inventory quantity"/>

                                        <!-- When Purchased: [ VIEW ORDER ] and [ RECEIPT ] -->
                                        <Button Content="VIEW ORDER" Tag="{Binding}"
                                                Click="OnViewOrderClick"
                                                Visibility="{Binding IsPurchased, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource Pos3DTableActionBtn}"
                                                Margin="0,0,6,0"/>
                                        <Button Content="RECEIPT" Tag="{Binding}"
                                                Click="OnViewPurchaseClick"
                                                Visibility="{Binding IsPurchased, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource Pos3DTableSuccessBtn}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State Panel -->
                <Border x:Name="EmptyStatePanel" Visibility="Collapsed" Background="Transparent"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <StackPanel HorizontalAlignment="Center">
                        <md:PackIcon Kind="CheckCircleOutline" Width="48" Height="48" Foreground="#059669" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="EmptyStateMainText" Text="All shopping completed!" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryText}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock x:Name="EmptyStateSubText" Text="There are no pending items on your shopping checklist." FontSize="12" Foreground="{DynamicResource PosSecondaryText}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <Button Style="{StaticResource Pos3DPrimaryBtn}"
                                Click="OnGoToOrdersClick"
                                Height="36" Padding="16,0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ClipboardListOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="VIEW PURCHASE ORDERS" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
