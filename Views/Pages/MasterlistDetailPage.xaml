<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AntiquePasabuyPOS.Views.Pages.MasterlistDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource PosBackground}"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Page.Resources>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"        Value="Center"/>
            <Setter Property="Padding"                  Value="6,0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Back button + title -->
            <RowDefinition Height="Auto"/>  <!-- Masterlist info card -->
            <RowDefinition Height="Auto"/>  <!-- Sort / filter bar -->
            <RowDefinition Height="*"/>     <!-- Order list -->
        </Grid.RowDefinitions>

        <!-- ══ ROW 0: HEADER ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Button Style="{StaticResource Pos3DSecondaryBtn}"
                        Height="34" Padding="12,0" Margin="0,0,12,0"
                        Click="OnGoBack">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ArrowLeft" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Back" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#F5F3FF" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                            <TextBlock x:Name="ControlNoLabel" FontSize="12" FontWeight="Bold"
                                       Foreground="#4338CA" FontFamily="Segoe UI Mono, Consolas, Segoe UI"/>
                        </Border>
                        <TextBlock x:Name="TitleLabel" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="SubtitleLabel" FontSize="11.5" Foreground="{DynamicResource PosSecondaryText}"
                               FontFamily="Segoe UI" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Assign existing orders -->
                <Button x:Name="AssignOrdersBtn"
                        Style="{StaticResource Pos3DSecondaryBtn}"
                        Height="36" Padding="14,0" Margin="0,0,8,0"
                        Click="OnAssignOrders"
                        ToolTip="Associate existing unassigned orders to this masterlist">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="LinkVariant" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Assign Orders" FontSize="12" FontWeight="SemiBold"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Print -->
                <Button Style="{StaticResource Pos3DSecondaryBtn}"
                        Height="36" Padding="14,0" Margin="0,0,8,0"
                        Click="OnPrint"
                        ToolTip="Print this masterlist">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="PrinterOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Print" FontSize="12" FontWeight="SemiBold"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Refresh -->
                <Button Click="OnRefresh" Style="{StaticResource Pos3DSecondaryBtn}"
                        Width="36" Height="36" Padding="0" ToolTip="Refresh">
                    <md:PackIcon Kind="Refresh" Width="16" Height="16"
                                 Foreground="{DynamicResource PosSecondaryText}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══ ROW 1: MASTERLIST INFO CARD ════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource PosSurface}"
                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                CornerRadius="10" Padding="18,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Date Range -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="DATE RANGE" FontSize="9.5" FontWeight="Bold"
                               Foreground="{DynamicResource PosMutedText}" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="DateRangeLabel" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Status -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="STATUS" FontSize="9.5" FontWeight="Bold"
                               Foreground="{DynamicResource PosMutedText}" FontFamily="Segoe UI"/>
                    <Border x:Name="DetailStatusBadge" CornerRadius="5" Padding="8,3" HorizontalAlignment="Left" Margin="0,2,0,0">
                        <TextBlock x:Name="DetailStatusLabel" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI"/>
                    </Border>
                </StackPanel>

                <!-- Customer Orders -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="CUSTOMER ORDERS" FontSize="9.5" FontWeight="Bold"
                               Foreground="{DynamicResource PosMutedText}" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="DetailOrderCount" FontSize="20" FontWeight="Bold"
                               Foreground="#4F46E5" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Total Items -->
                <StackPanel Grid.Column="3">
                    <TextBlock Text="TOTAL ITEMS" FontSize="9.5" FontWeight="Bold"
                               Foreground="{DynamicResource PosMutedText}" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="DetailItemCount" FontSize="20" FontWeight="Bold"
                               Foreground="#0891B2" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Not Available -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="NOT AVAILABLE" FontSize="9.5" FontWeight="Bold"
                               Foreground="{DynamicResource PosMutedText}" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="DetailUnavailable" FontSize="20" FontWeight="Bold"
                               Foreground="#DC2626" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Bought On Hand -->
                <StackPanel Grid.Column="5">
                    <TextBlock Text="BOUGHT ON HAND" FontSize="9.5" FontWeight="Bold"
                               Foreground="{DynamicResource PosMutedText}" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="DetailBoughtOnHand" FontSize="20" FontWeight="Bold"
                               Foreground="#059669" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ ROW 2: SORT / FILTER BAR ══════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource PosSurface}"
                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Border Grid.Column="0" Background="{DynamicResource PosBackground}"
                        BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                        CornerRadius="7" Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <md:PackIcon Kind="Magnify" Width="15" Height="15"
                                     Foreground="{DynamicResource PosSecondaryText}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="DetailSearchBox" Grid.Column="1"
                                 FontSize="12.5" FontFamily="Segoe UI"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource PosInputText}"
                                 VerticalContentAlignment="Center"
                                 Padding="0,8"
                                 md:HintAssist.Hint="Search customer or product…"
                                 TextChanged="OnDetailSearchChanged"/>
                    </Grid>
                </Border>

                <!-- Sort -->
                <ComboBox x:Name="DetailSortBox" Grid.Column="2"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          FontSize="12.5" FontFamily="Segoe UI"
                          SelectionChanged="OnDetailSortChanged">
                    <ComboBoxItem Content="By Customer Name"    Tag="customer"  IsSelected="True"/>
                    <ComboBoxItem Content="Most Orders"         Tag="orders"/>
                    <ComboBoxItem Content="Not Available First" Tag="unavail"/>
                    <ComboBoxItem Content="Newest Order First"  Tag="newest"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- ══ ROW 3: ORDER LIST ══════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="OrdersPanel"/>
        </ScrollViewer>
    </Grid>
</Page>
