<Page x:Class="AntiquePasabuyPOS.Views.Pages.RestoTablesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource PosBackground}"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Explainer Banner -->
            <RowDefinition Height="Auto"/> <!-- Filter Pills & Summary -->
            <RowDefinition Height="*"/>    <!-- Floor Plan Cards -->
        </Grid.RowDefinitions>

        <!-- ══ 0. HEADER ═════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Table Management &amp; Floor Plan" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource PosPrimaryText}"/>
                <TextBlock Text="Manage dining tables, track active customer tabs, and monitor live running bills in real time."
                           FontSize="12" Foreground="{DynamicResource PosSecondaryText}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Click="OnRefreshClick" Style="{StaticResource Pos3DSecondaryBtn}" Height="36" Padding="12,0" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Refresh Bills" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnAddTableClick" Style="{StaticResource Pos3DPrimaryBtn}" Height="36" Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="TableChair" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="+ ADD TABLE" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══ 1. UNDERSTANDING BILLS EXPLAINER BANNER ════════════════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource PosPanel}" BorderBrush="{DynamicResource PosBorder}"
                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="18" Background="#3B82F620" Margin="0,0,12,0" VerticalAlignment="Center">
                    <md:PackIcon Kind="InformationOutline" Width="20" Height="20" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="How Table Running Bills Work:" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryText}"/>
                    <TextBlock Text="Click 'Take Order / Seat' on any Available table to punch in dishes and drinks. Clicking 'Save Tab' keeps the table Occupied with its live running bill. When guests want to add more, click 'View / Add to Bill'; when ready to pay, click 'Settle Bill'."
                               FontSize="11.5" Foreground="{DynamicResource PosSecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 2. STATUS FILTER PILLS & SEARCH ════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filter Pills -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" x:Name="TableFilterPillsPanel">
                    <Button x:Name="BtnFilterAll" Content="All Tables" Tag="All" Click="OnFilterStatusClick"
                            Style="{StaticResource Pos3DPrimaryBtn}" Height="30" Padding="12,0" Margin="0,0,6,0"/>
                    <Button x:Name="BtnFilterAvailable" Content="Available" Tag="Available" Click="OnFilterStatusClick"
                            Style="{StaticResource Pos3DSecondaryBtn}" Height="30" Padding="12,0" Margin="0,0,6,0"/>
                    <Button x:Name="BtnFilterOccupied" Content="Occupied (Active Tabs)" Tag="Occupied" Click="OnFilterStatusClick"
                            Style="{StaticResource Pos3DSecondaryBtn}" Height="30" Padding="12,0" Margin="0,0,6,0"/>
                    <Button x:Name="BtnFilterBilling" Content="Billing" Tag="Billing" Click="OnFilterStatusClick"
                            Style="{StaticResource Pos3DSecondaryBtn}" Height="30" Padding="12,0" Margin="0,0,6,0"/>
                    <Button x:Name="BtnFilterReserved" Content="Reserved" Tag="Reserved" Click="OnFilterStatusClick"
                            Style="{StaticResource Pos3DSecondaryBtn}" Height="30" Padding="12,0"/>
                </StackPanel>

                <!-- Stats summary -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,4,0">
                    <TextBlock x:Name="TxtTableSummary" Text="Total Tables: 0 | Active Tabs: 0"
                               FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 3. FLOOR PLAN TABLE CARDS ══════════════════════════════════════ -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TablesCardsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PosSurface}"
                                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                                CornerRadius="10" Padding="14" Margin="8" Width="260" MinHeight="230">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- 0: Number & Badge -->
                                    <RowDefinition Height="Auto"/> <!-- 1: Name & Capacity -->
                                    <RowDefinition Height="*"/>    <!-- 2: Bill Status Info Panel -->
                                    <RowDefinition Height="Auto"/> <!-- 3: Primary Action (Take Order / View Bill) -->
                                    <RowDefinition Height="Auto"/> <!-- 4: Status Toggle -->
                                    <RowDefinition Height="Auto"/> <!-- 5: Edit / Delete -->
                                </Grid.RowDefinitions>

                                <!-- Top row: Table number & Status badge -->
                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TableNumber}" FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource PosPrimaryText}"/>
                                        <TextBlock Text="{Binding Section, StringFormat=' ({0})'}" FontSize="11"
                                                   Foreground="{DynamicResource PosSecondaryText}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </StackPanel>
                                    <!-- Colour-coded status badge -->
                                    <Border HorizontalAlignment="Right" CornerRadius="4" Padding="7,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#22C55E20"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                        <Setter Property="Background" Value="#DC262620"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Reserved">
                                                        <Setter Property="Background" Value="#F5940020"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Billing">
                                                        <Setter Property="Background" Value="#7C3AED20"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#22C55E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Reserved">
                                                            <Setter Property="Foreground" Value="#F59400"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Billing">
                                                            <Setter Property="Foreground" Value="#7C3AED"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <!-- Table name and capacity -->
                                <StackPanel Grid.Row="1" Margin="0,4,0,8">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PosSecondaryText}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Capacity, StringFormat='{}Capacity: {0} seats'}" FontSize="11"
                                               Foreground="{DynamicResource PosMutedText}"/>
                                </StackPanel>

                                <!-- Bill / Tab info panel -->
                                <Border Grid.Row="2" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#22C55E10"/>
                                            <Setter Property="BorderBrush" Value="#22C55E40"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                    <Setter Property="Background" Value="#DC262610"/>
                                                    <Setter Property="BorderBrush" Value="#DC262640"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Billing">
                                                    <Setter Property="Background" Value="#7C3AED10"/>
                                                    <Setter Property="BorderBrush" Value="#7C3AED40"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Reserved">
                                                    <Setter Property="Background" Value="#F5940010"/>
                                                    <Setter Property="BorderBrush" Value="#F5940040"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <!-- AVAILABLE STATE: Prompt to take order -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Billing">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Ready for Dining" FontSize="11.5" FontWeight="SemiBold" Foreground="#16A34A"/>
                                            <TextBlock Text="No active bill • Table is free" FontSize="10.5" Foreground="{DynamicResource PosSecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- OCCUPIED / BILLING STATE: Display running bill & guest -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Billing">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{Binding CurrentCustomerName, TargetNullValue='Dine-in Guests', StringFormat='{}Guest: {0}'}"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosPrimaryText}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CurrentBillAmount, StringFormat='{}Running Bill: ₱{0:N2}'}"
                                                       FontSize="13.5" FontWeight="Bold"
                                                       Foreground="#DC2626" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Primary Table Action: Take Order vs View/Settle -->
                                <Grid Grid.Row="3" Margin="0,0,0,6">
                                    <!-- When Available: [ TAKE ORDER / SEAT ] -->
                                    <Button Click="OnTakeOrderClick" Tag="{Binding}" Height="32">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Pos3DPrimaryBtn}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Billing">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="FoodOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Take Order / Seat" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- When Occupied / Billing: [ VIEW / ADD ITEMS ] and [ SETTLE BILL ] -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Billing">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Click="OnViewAddItemsClick" Tag="{Binding}"
                                                Style="{StaticResource Pos3DSecondaryBtn}" Height="32" ToolTip="Add more food or drinks to this tab">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="PlaylistPlus" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                <TextBlock Text="Add Items" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Click="OnSettleBillClick" Tag="{Binding}"
                                                Style="{StaticResource Pos3DPrimaryBtn}" Height="32" ToolTip="Go to checkout and settle bill">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="CashCheck" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                <TextBlock Text="Settle Bill" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>

                                <!-- Status Toggle -->
                                <Button Grid.Row="4" Click="OnToggleTableStatusClick" Tag="{Binding}"
                                        Style="{StaticResource Pos3DFilterBtn}" Height="26" Margin="0,0,0,6">
                                    <Button.Content>
                                        <TextBlock FontSize="10.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Mark Occupied"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                            <Setter Property="Text" Value="Mark Available (Clear)"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Reserved">
                                                            <Setter Property="Text" Value="Mark Available"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Billing">
                                                            <Setter Property="Text" Value="Mark Available (Clear)"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>

                                <!-- Edit / Delete actions -->
                                <Grid Grid.Row="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="OnEditTableClick" Tag="{Binding}" Style="{StaticResource Pos3DFilterBtn}" Height="24">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Pencil" Width="11" Height="11" Margin="0,0,3,0"/>
                                            <TextBlock Text="Edit" FontSize="10.5"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Click="OnDeleteTableClick" Tag="{Binding}" Style="{StaticResource Pos3DTableDangerBtn}" Height="24">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Delete" Width="11" Height="11" Margin="0,0,3,0"/>
                                            <TextBlock Text="Delete" FontSize="10.5"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
