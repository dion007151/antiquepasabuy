<Page x:Class="AntiquePasabuyPOS.Views.Pages.RestoCustomersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource PosBackground}"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Page.Resources>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Restaurant Guests &amp; Customers" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource PosPrimaryText}"/>
                <TextBlock Text="Manage VIP guests, regular diners, and customer records."
                           FontSize="12" Foreground="{DynamicResource PosSecondaryText}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="200" Height="36"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Search customers..."
                         TextChanged="OnSearchChanged" Margin="0,0,10,0"/>
                <Button Click="OnAddCustomerClick" Style="{StaticResource Pos3DPrimaryBtn}" Height="36" Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="AccountPlus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="+ ADD CUSTOMER" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Stats Bar -->
        <Border Grid.Row="1" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Total Customers: " FontSize="13" Foreground="{DynamicResource PosSecondaryText}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTotalCount" Text="0" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource PosPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Customer Grid -->
        <Border Grid.Row="2" Background="{DynamicResource PosSurface}"
                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <DataGrid x:Name="CustomersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                      RowBackground="{DynamicResource PosSurface}"
                      AlternatingRowBackground="{DynamicResource PosTableRow}"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Phone / Mobile" Binding="{Binding Phone}" Width="150"/>
                    <DataGridTextColumn Header="Address / City" Binding="{Binding Address}" Width="180"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                    <!-- Actions Column -->
                    <DataGridTemplateColumn Header="Actions" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Click="OnEditCustomerClick" Tag="{Binding}"
                                            Style="{StaticResource Pos3DFilterBtn}"
                                            Height="28" Padding="8,0" Margin="0,0,4,0" ToolTip="Edit customer">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Pencil" Width="13" Height="13" Margin="0,0,3,0"/>
                                            <TextBlock Text="Edit" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnDeleteCustomerClick" Tag="{Binding}"
                                            Style="{StaticResource Pos3DTableDangerBtn}"
                                            Height="28" Padding="8,0" ToolTip="Delete customer">
                                        <md:PackIcon Kind="Delete" Width="13" Height="13"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>

