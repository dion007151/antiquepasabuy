<Page x:Class="AntiquePasabuyPOS.Views.Pages.RestoInventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource PosBackground}"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Page.Resources>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Restaurant Stock &amp; Inventory" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource PosPrimaryText}"/>
                <TextBlock Text="Track food supplies, meats, beverages, liquor, and pantry items."
                           FontSize="12" Foreground="{DynamicResource PosSecondaryText}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox x:Name="TxtSearchInventory" Width="200" Height="36" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Search items..." TextChanged="OnSearchTextChanged" Margin="0,0,10,0"/>
                <Button Click="OnRestockClick" Style="{StaticResource Pos3DPrimaryBtn}" Height="36" Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="PackageVariantPlus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="+ RESTOCK ITEM" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Inventory DataGrid -->
        <Border Grid.Row="1" Background="{DynamicResource PosSurface}"
                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <DataGrid x:Name="InventoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                      RowBackground="{DynamicResource PosSurface}"
                      AlternatingRowBackground="{DynamicResource PosTableRow}"
                      MouseDoubleClick="OnGridRowDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}" Width="100" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Item Name" Binding="{Binding Name}" Width="*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                    <DataGridTextColumn Header="On-Hand" Binding="{Binding Quantity, StringFormat='{}{0:N1}'}" Width="85" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="65"/>
                    <DataGridTextColumn Header="Min Stock" Binding="{Binding MinStockLevel, StringFormat='{}{0:N0}'}" Width="85"/>
                    <DataGridTextColumn Header="Unit Cost" Binding="{Binding CostPrice, StringFormat='₱{0:N2}'}" Width="95"/>

                    <!-- Stock Status Badge -->
                    <DataGridTemplateColumn Header="Status" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10.5" FontWeight="Bold" TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="IN STOCK"/>
                                                <Setter Property="Foreground" Value="#166534"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                        <Setter Property="Text" Value="LOW STOCK"/>
                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Last Restocked" Binding="{Binding LastRestockedAt, StringFormat='MMM dd, yyyy'}" Width="120"/>

                    <!-- Action Buttons -->
                    <DataGridTemplateColumn Header="Actions" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Click="OnRestockRowClick" Tag="{Binding}" Style="{StaticResource Pos3DFilterBtn}"
                                            Height="28" Padding="8,0" Margin="0,0,4,0" ToolTip="Restock this item">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="PlusCircleOutline" Width="13" Height="13" Margin="0,0,3,0"/>
                                            <TextBlock Text="Restock" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnDeleteRowClick" Tag="{Binding}" Style="{StaticResource Pos3DTableDangerBtn}"
                                            Height="28" Padding="8,0" ToolTip="Delete Item">
                                        <md:PackIcon Kind="Delete" Width="13" Height="13"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
