<Page x:Class="AntiquePasabuyPOS.Views.Pages.RestoOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource PosBackground}"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Page.Resources>
        <!-- Standard DataGrid Cell Style: Vertically centered text for every cell -->
        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="GridTextCenter">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="GridTextCenterBold">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="GridTextCenterRightBold">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource PosPrimaryText}"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="Auto"/> <!-- 1: KPI Stats Bar -->
            <RowDefinition Height="Auto"/> <!-- 2: Category Segment Tabs -->
            <RowDefinition Height="Auto"/> <!-- 3: Date Filters & Search -->
            <RowDefinition Height="*"/>    <!-- 4: Orders DataGrid -->
        </Grid.RowDefinitions>

        <!-- ══ 0. HEADER ═════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Angelito's Bar &amp; Resto Grill Orders" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource PosPrimaryText}"/>
                <TextBlock Text="Organize dine-in tables, bar counter orders, active running tabs, and sales receipts."
                           FontSize="12" Foreground="{DynamicResource PosSecondaryText}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnDeleteSelected" Click="OnDeleteSelectedClick" Style="{StaticResource Pos3DDangerBtn}" Height="36" Padding="12,0" Margin="0,0,8,0" Visibility="Collapsed" ToolTip="Delete selected orders">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="DeleteSweepOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtDeleteSelectedLabel" Text="Delete Selected" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnClearAllOrdersClick" Style="{StaticResource Pos3DSecondaryBtn}" Height="36" Padding="12,0" Margin="0,0,8,0" Foreground="#DC2626" ToolTip="Clear/delete all restaurant sales and orders">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Clear All" Foreground="#DC2626" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnRefreshClick" Style="{StaticResource Pos3DSecondaryBtn}" Height="36" Padding="12,0" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnNewOrderClick" Style="{StaticResource Pos3DPrimaryBtn}" Height="36" Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="PlusCircle" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="+ NEW RESTO ORDER" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══ 1. KPI STATS CARDS ════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Sales -->
            <Border Grid.Column="0" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                <Grid>
                    <Border Height="3" VerticalAlignment="Top" Background="#16A34A" CornerRadius="2" Margin="0,-10,0,0"/>
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="TOTAL SALES" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}"/>
                        <TextBlock x:Name="TxtKpiTotalSales" Text="₱0.00" FontSize="18" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtKpiOrderCount" Text="0 completed sales" FontSize="10.5" Foreground="{DynamicResource PosMutedText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active Tabs / Running Bills -->
            <Border Grid.Column="2" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                <Grid>
                    <Border Height="3" VerticalAlignment="Top" Background="#D97706" CornerRadius="2" Margin="0,-10,0,0"/>
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="ACTIVE RUNNING TABS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}"/>
                        <TextBlock x:Name="TxtKpiActiveTabs" Text="₱0.00" FontSize="18" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtKpiActiveTabsCount" Text="0 open tables/tabs" FontSize="10.5" Foreground="{DynamicResource PosMutedText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dine-In Revenue -->
            <Border Grid.Column="4" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                <Grid>
                    <Border Height="3" VerticalAlignment="Top" Background="#2563EB" CornerRadius="2" Margin="0,-10,0,0"/>
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="DINE-IN TABLES" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}"/>
                        <TextBlock x:Name="TxtKpiDineInSales" Text="₱0.00" FontSize="18" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtKpiDineInCount" Text="0 dining orders" FontSize="10.5" Foreground="{DynamicResource PosMutedText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bar Counter Revenue -->
            <Border Grid.Column="6" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                <Grid>
                    <Border Height="3" VerticalAlignment="Top" Background="#7C3AED" CornerRadius="2" Margin="0,-10,0,0"/>
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="BAR COUNTER" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}"/>
                        <TextBlock x:Name="TxtKpiBarSales" Text="₱0.00" FontSize="18" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtKpiBarCount" Text="0 bar tabs / drinks" FontSize="10.5" Foreground="{DynamicResource PosMutedText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ 2. CATEGORY SEGMENT TABS ══════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" x:Name="CategoryTabsPanel">
                <Button x:Name="BtnTabAll" Content="ALL ORDERS" Tag="All" Click="OnCategoryTabClick"
                        Style="{StaticResource Pos3DPrimaryBtn}" Height="32" Padding="14,0" Margin="0,0,6,0" Cursor="Hand"/>
                <Button x:Name="BtnTabDineIn" Content="🍽️ DINE-IN TABLES" Tag="Dining" Click="OnCategoryTabClick"
                        Style="{StaticResource Pos3DSecondaryBtn}" Height="32" Padding="14,0" Margin="0,0,6,0" Cursor="Hand"/>
                <Button x:Name="BtnTabBar" Content="🍺 BAR COUNTER" Tag="Bar" Click="OnCategoryTabClick"
                        Style="{StaticResource Pos3DSecondaryBtn}" Height="32" Padding="14,0" Margin="0,0,6,0" Cursor="Hand"/>
                <Button x:Name="BtnTabActive" Content="⚡ ACTIVE TABS" Tag="Active" Click="OnCategoryTabClick"
                        Style="{StaticResource Pos3DSecondaryBtn}" Height="32" Padding="14,0" Margin="0,0,6,0" Cursor="Hand"/>
                <Button x:Name="BtnTabCompleted" Content="✅ COMPLETED SALES" Tag="Completed" Click="OnCategoryTabClick"
                        Style="{StaticResource Pos3DSecondaryBtn}" Height="32" Padding="14,0" Margin="0,0,6,0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- ══ 3. DATE FILTER BAR & SEARCH ═══════════════════════════════════ -->
        <Border Grid.Row="3" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Date Presets -->
                    <ColumnDefinition Width="Auto"/> <!-- Custom DatePickers -->
                    <ColumnDefinition Width="*"/>    <!-- Search Box -->
                </Grid.ColumnDefinitions>

                <!-- Date Pills: Today, Yesterday, This Week, This Month, All -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" x:Name="DatePillsPanel">
                    <Button x:Name="BtnDateToday" Content="Today" Tag="Today" Click="OnDatePillClick"
                            Style="{StaticResource Pos3DPrimaryBtn}" Height="30" Padding="12,0" Margin="0,0,5,0"/>
                    <Button x:Name="BtnDateYesterday" Content="Yesterday" Tag="Yesterday" Click="OnDatePillClick"
                            Style="{StaticResource Pos3DSecondaryBtn}" Height="30" Padding="12,0" Margin="0,0,5,0"/>
                    <Button x:Name="BtnDateThisWeek" Content="This Week" Tag="ThisWeek" Click="OnDatePillClick"
                            Style="{StaticResource Pos3DSecondaryBtn}" Height="30" Padding="12,0" Margin="0,0,5,0"/>
                    <Button x:Name="BtnDateThisMonth" Content="This Month" Tag="ThisMonth" Click="OnDatePillClick"
                            Style="{StaticResource Pos3DSecondaryBtn}" Height="30" Padding="12,0" Margin="0,0,5,0"/>
                    <Button x:Name="BtnDateAll" Content="All Time" Tag="All" Click="OnDatePillClick"
                            Style="{StaticResource Pos3DSecondaryBtn}" Height="30" Padding="12,0"/>
                </StackPanel>

                <!-- Custom Date Range with Styled Pill Borders -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,14,0">
                    <Border Background="{DynamicResource PosBackground}" BorderBrush="{DynamicResource PosBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="From:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="DpFrom" Width="95" Height="24" FontSize="11"
                                        BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                        SelectedDateChanged="OnDateRangeChanged"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource PosBackground}" BorderBrush="{DynamicResource PosBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="8,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="To:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="DpTo" Width="95" Height="24" FontSize="11"
                                        BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                        SelectedDateChanged="OnDateRangeChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Search Box -->
                <Border Grid.Column="2" Background="{DynamicResource PosBackground}" CornerRadius="6"
                        BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <md:PackIcon Kind="Magnify" Width="16" Height="16" Foreground="{DynamicResource PosMutedText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtSearchOrders" Grid.Column="1" BorderThickness="0" FontSize="12"
                                 Foreground="{DynamicResource PosPrimaryText}" CaretBrush="{DynamicResource PosPrimary}"
                                 md:HintAssist.Hint="Search order #, table, customer, item, bartender..."
                                 md:TextFieldAssist.DecorationVisibility="Hidden"
                                 TextChanged="OnSearchOrdersChanged"/>
                        <Button Grid.Column="2" Content="✕" Click="OnClearSearchClick"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{DynamicResource PosMutedText}" Padding="4,0" Height="22" FontSize="11"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ══ 4. ORDERS DATAGRID ═════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="{DynamicResource PosSurface}"
                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <Grid>
                <DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                          RowBackground="{DynamicResource PosSurface}"
                          AlternatingRowBackground="{DynamicResource PosTableRow}"
                          MinRowHeight="44"
                          MouseDoubleClick="OnOrdersGridDoubleClick"
                          PreviewKeyDown="OnOrdersGridKeyDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="View Order Details" Click="OnContextMenuViewReceipt">
                                <MenuItem.Icon>
                                    <md:PackIcon Kind="ReceiptTextOutline" Width="16" Height="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Delete Order" Click="OnContextMenuDeleteOrder" Foreground="#DC2626">
                                <MenuItem.Icon>
                                    <md:PackIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="#DC2626"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <!-- 0. Selection Checkbox -->
                        <DataGridTemplateColumn Width="40" CanUserResize="False">
                            <DataGridTemplateColumn.Header>
                                <CheckBox x:Name="HeaderSelectAll" Click="OnHeaderSelectAllClick" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Select All"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Click="OnRowCheckChanged" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 1. Order / Ticket No - Center Vertically -->
                        <DataGridTextColumn Header="Order / Ticket #" Binding="{Binding OrderNo}" Width="145"
                                            ElementStyle="{StaticResource GridTextCenterBold}"/>

                        <!-- 2. Area Badge - Center Vertically -->
                        <DataGridTemplateColumn Header="Area" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding OrderTypeBackground}" CornerRadius="6" Padding="8,3"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OrderTypeBadge}" Foreground="{Binding OrderTypeForeground}"
                                                   FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 3. Table / Bar Stool - Center Vertically -->
                        <DataGridTemplateColumn Header="Table" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F3F4F6" CornerRadius="6" Padding="7,3"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TableDisplay}" Foreground="#374151"
                                                   FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 4. Guest / Customer - Center Vertically -->
                        <DataGridTextColumn Header="Guest / Customer" Binding="{Binding CustomerName}" Width="135"
                                            ElementStyle="{StaticResource GridTextCenter}"/>

                        <!-- 5. Items Summary - Center Vertically, Ellipsis, Never Truncates Header -->
                        <DataGridTextColumn Header="Items Summary" Binding="{Binding ItemsSummary}" Width="*" MinWidth="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextCenter}">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PosSecondaryText}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 6. Status & Payment Badge - Center Vertically -->
                        <DataGridTemplateColumn Header="Status" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBackground}" CornerRadius="6" Padding="8,3"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusBadge}" Foreground="{Binding StatusForeground}"
                                                   FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 7. Staff / Server - Center Vertically -->
                        <DataGridTextColumn Header="Staff / Server" Binding="{Binding ServerOrCashier}" Width="105"
                                            ElementStyle="{StaticResource GridTextCenter}"/>

                        <!-- 8. Total Amount - Center Vertically, Bold, Right Aligned -->
                        <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat='₱{0:N2}'}" Width="110"
                                            ElementStyle="{StaticResource GridTextCenterRightBold}"/>

                        <!-- 9. Date & Time - Center Vertically -->
                        <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding CreatedAt, StringFormat='MMM dd, hh:mm tt'}" Width="135"
                                            ElementStyle="{StaticResource GridTextCenter}"/>

                        <!-- 10. Actions - Center Vertically -->
                        <DataGridTemplateColumn Header="Actions" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Click="OnViewOrderDetailsClick" Tag="{Binding}"
                                                Style="{StaticResource Pos3DFilterBtn}" Height="26" Padding="7,0" Margin="0,0,6,0" Cursor="Hand"
                                                ToolTip="View receipt / order details">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="ReceiptTextOutline" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="View" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OnDeleteOrderClick" Tag="{Binding}"
                                                Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1"
                                                Foreground="#DC2626" Height="26" Padding="7,0" Cursor="Hand"
                                                ToolTip="Delete order">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="DeleteOutline" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Delete" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State -->
                <Border x:Name="EmptyStateBorder" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                    <StackPanel HorizontalAlignment="Center">
                        <md:PackIcon Kind="FoodOff" Width="42" Height="42" Foreground="{DynamicResource PosMutedText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No orders found" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PosPrimaryText}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="There are no restaurant or bar orders matching this filter." FontSize="11.5"
                                   Foreground="{DynamicResource PosSecondaryText}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
