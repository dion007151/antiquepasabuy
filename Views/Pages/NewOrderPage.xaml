<Page x:Class="AntiquePasabuyPOS.Views.Pages.NewOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:views="clr-namespace:AntiquePasabuyPOS.Views"
      Background="{DynamicResource PosBackground}"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="ClearType"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Category Pill Style (Modern Touch POS Capsule) -->
        <Style x:Key="CategoryPillStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{DynamicResource PosSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource PosSecondaryText}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.2" CornerRadius="17"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="views:NavProps.IsActive" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource PosPrimary}"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource PosPrimary}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="views:NavProps.IsActive" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource PosPanel}"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource PosPrimary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PosPrimary}"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource PosPrimary}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tender Key Style -->
        <Style x:Key="TenderKeyStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{DynamicResource PosSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource PosPrimary}"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource PosPrimary}"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource PosPrimary}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource PosPrimary}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PayMethodStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{DynamicResource PosSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource PosSecondaryText}"/>
        </Style>
    </Page.Resources>

    <!-- Smooth fade-in when page opens -->
    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootGrid"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootGrid"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="10" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>

    <Grid x:Name="RootGrid" Margin="12,10" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform Y="0"/>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <!-- LEFT: Products & Quick Add -->
            <ColumnDefinition Width="*"/>
            <!-- RIGHT: Order Ticket POS -->
            <ColumnDefinition Width="380" MinWidth="340"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- LEFT: Quick Add & Product Catalog                       -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 1. Rapid Item Entry Row -->
                <RowDefinition Height="Auto"/>  <!-- 2. Search & Filter Bar -->
                <RowDefinition Height="Auto"/>  <!-- 3. Category Pills -->
                <RowDefinition Height="*"/>     <!-- 4. Product Cards Grid -->
            </Grid.RowDefinitions>

            <!-- ── 1. RAPID PASABUY ITEM ENTRY (Front-and-center Store & Item) ── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource PosSurface}"
                    BorderBrush="{DynamicResource PosBorder}" BorderThickness="1.5"
                    CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#FEF3C7" CornerRadius="4" Padding="5,2" Margin="0,0,7,0">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="LightningBolt" Width="14" Height="14"
                                                 Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="QUICK ENCODER" FontSize="10" FontWeight="Black"
                                               Foreground="#B45309" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Type store, item name, price, qty and press Enter to instantly add"
                                       FontSize="10.5" Foreground="{DynamicResource PosSecondaryText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Hidden barcode scanner stub for code-behind -->
                        <Button x:Name="ScanBarcodeStub" Click="OnScanBarcode" Visibility="Collapsed"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- Store selector -->
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="6"/>
                            <!-- Item name -->
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <!-- Est. Price -->
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="6"/>
                            <!-- Qty -->
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="8"/>
                            <!-- Add Button -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Store Selector -->
                        <Border Grid.Column="0" Background="{DynamicResource PosPanel}"
                                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" CornerRadius="8" Padding="6,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <md:PackIcon Kind="StorefrontOutline" Width="15" Height="15"
                                             Foreground="{DynamicResource PosPrimary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="QuickStoreCombo" Grid.Column="1"
                                          BorderThickness="0" Background="Transparent"
                                          FontSize="11.5" FontWeight="SemiBold"
                                          Foreground="{DynamicResource PosPrimaryText}"
                                          IsEditable="True" Height="36"
                                          VerticalContentAlignment="Center"
                                          ToolTip="Select or type Store / Supplier"/>
                            </Grid>
                        </Border>

                        <!-- Item Name -->
                        <Border Grid.Column="2" Background="{DynamicResource PosPanel}"
                                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" CornerRadius="8" Padding="8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <md:PackIcon Kind="PencilOutline" Width="15" Height="15"
                                             Foreground="{DynamicResource PosMutedText}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="QuickItemNameBox" Grid.Column="1"
                                         BorderThickness="0" Background="Transparent"
                                         FontSize="12" Foreground="{DynamicResource PosPrimaryText}"
                                         Height="36" VerticalContentAlignment="Center"
                                         md:HintAssist.Hint="Item name (e.g. 1kg Chicken, Milk...)"
                                         KeyDown="OnQuickItemKeyDown"/>
                            </Grid>
                        </Border>

                        <!-- Est Price -->
                        <Border Grid.Column="4" Background="{DynamicResource PosPanel}"
                                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" CornerRadius="8" Padding="6,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="₱" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource PosPrimary}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBox x:Name="QuickPriceBox" Grid.Column="1"
                                         BorderThickness="0" Background="Transparent"
                                         FontSize="12" FontWeight="SemiBold"
                                         Foreground="{DynamicResource PosPrimaryText}"
                                         Height="36" VerticalContentAlignment="Center"
                                         md:HintAssist.Hint="0.00"
                                         KeyDown="OnQuickItemKeyDown"/>
                            </Grid>
                        </Border>

                        <!-- Qty -->
                        <Border Grid.Column="6" Background="{DynamicResource PosPanel}"
                                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" CornerRadius="8" Padding="4,0">
                            <TextBox x:Name="QuickQtyBox"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="12" FontWeight="Bold" Text="1"
                                     Foreground="{DynamicResource PosPrimaryText}"
                                     Height="36" VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     KeyDown="OnQuickItemKeyDown"/>
                        </Border>

                        <!-- Add Button -->
                        <Button Grid.Column="8" Click="OnQuickAddRowClick"
                                Style="{StaticResource Pos3DPrimaryBtn}"
                                Height="36" Padding="12,0" Cursor="Hand"
                                ToolTip="Add item to ticket (Enter)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <md:PackIcon Kind="PlusBold" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Add" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── 2. SEARCH BAR ── -->
            <Border Grid.Row="1" Margin="0,0,0,8"
                    Background="{DynamicResource PosSurface}"
                    BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <md:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18"
                                 Foreground="{DynamicResource PosPrimary}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="ProductSearchBox" Grid.Column="1"
                             BorderThickness="0" FontSize="12.5" FontFamily="Segoe UI"
                             Foreground="{DynamicResource PosPrimaryText}"
                             Background="Transparent"
                             md:HintAssist.Hint="Search product catalog..."
                             Style="{StaticResource MaterialDesignTextBox}"
                             TextChanged="OnProductSearchChanged"
                             KeyDown="OnSearchKeyDown"
                             Height="38"/>
                    <Button x:Name="ClearSearchBtn" Grid.Column="2"
                            Click="OnClearProductSearch"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource PosMutedText}"
                            Padding="4" ToolTip="Clear search (ESC)"
                            Visibility="Collapsed">
                        <md:PackIcon Kind="Close" Width="14" Height="14"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ── 3. CATEGORY PILLS ── -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                <StackPanel x:Name="CategoryPanel" Orientation="Horizontal"/>
            </ScrollViewer>

            <!-- ── 4. PRODUCT CARDS GRID ── -->
            <Border x:Name="ProductsBorder" Grid.Row="3"
                    Background="{DynamicResource PosSurface}"
                    BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                    CornerRadius="10" Padding="6"
                    SizeChanged="OnProductsGridSizeChanged">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ProductsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Pos3DProductBtn}"
                                        IsEnabled="{Binding IsActive}"
                                        Click="OnProductCardClicked" Tag="{Binding}"
                                        ToolTip="Click to add to order ticket">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="74"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Image / Icon area with sleek rounded card -->
                                        <Border Grid.Row="0" Margin="0,0,0,6"
                                                Background="{DynamicResource PosPanel}"
                                                BorderBrush="{DynamicResource PosBorder}"
                                                BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                            <Grid>
                                                <!-- Fallback icon (no image) -->
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                            Visibility="{Binding HasNoImage, Converter={StaticResource BoolToVis}}">
                                                    <md:PackIcon Kind="ShoppingOutline" Width="32" Height="32"
                                                                 Foreground="{DynamicResource PosPrimary}"
                                                                 HorizontalAlignment="Center" Opacity="0.75"/>
                                                </StackPanel>
                                                <!-- Actual product image -->
                                                <Image Source="{Binding ImageSource}" Stretch="UniformToFill"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"/>

                                                <!-- Store Tag Badge -->
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                        Background="{DynamicResource PosPrimary}"
                                                        CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding Store}" FontSize="8.5" FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>

                                                <!-- Cart Qty Badge (When item is in ticket) -->
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                                        Background="#10B981"
                                                        CornerRadius="4" Padding="6,2"
                                                        Visibility="{Binding IsInCart, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding CartQtyBadge}" FontSize="9"
                                                               FontWeight="Black" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Product Title -->
                                        <TextBlock Grid.Row="1" Text="{Binding Name}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource PosPrimaryText}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   MaxHeight="34" LineHeight="16"
                                                   VerticalAlignment="Top" Margin="2,0,2,0"/>

                                        <!-- Price & Add Pill Tag -->
                                        <Grid Grid.Row="2" VerticalAlignment="Bottom" Margin="2,4,2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Price & Unit -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Price, StringFormat='₱{0:N2}'}"
                                                           FontWeight="Black" FontSize="13.5"
                                                           Foreground="{DynamicResource PosPrimary}"/>
                                                <TextBlock Text="{Binding Unit, StringFormat='/{0}'}"
                                                           FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PosSecondaryText}"
                                                           VerticalAlignment="Center" Margin="2,2,0,0"/>
                                            </StackPanel>

                                            <!-- Visual "+ Add" Pill Tag -->
                                            <Border Grid.Column="1" Background="{DynamicResource PosLightBlue}"
                                                    CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="+ ADD" FontSize="9" FontWeight="Bold"
                                                           Foreground="{DynamicResource PosPrimary}"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- RIGHT: Order Ticket POS                                 -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Column="1"
                Background="{DynamicResource PosSurface}"
                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                CornerRadius="12" Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Header -->
                    <RowDefinition Height="*"/>      <!-- Scrollable Ticket -->
                    <RowDefinition Height="Auto"/>   <!-- Save Button -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="ReceiptTextOutline" Width="19" Height="19"
                                     Foreground="{DynamicResource PosPrimary}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="PURCHASE ORDER" FontWeight="Black" FontSize="14"
                                   Foreground="{DynamicResource PosPrimaryText}"
                                   VerticalAlignment="Center" FontFamily="Segoe UI"/>
                        <Border CornerRadius="10" Background="{DynamicResource PosLightBlue}"
                                Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CartCountBadge" Text="0 items" FontSize="10"
                                       FontWeight="Bold" Foreground="{DynamicResource PosPrimary}"/>
                        </Border>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="OnClearCart"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource PosDanger}"
                            Padding="4" ToolTip="Clear ticket items">
                        <md:PackIcon Kind="TrashCanOutline" Width="17" Height="17"/>
                    </Button>
                </Grid>

                <!-- Scrollable Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,-4,0" Padding="0,0,4,0">
                    <StackPanel>

                        <!-- Customer & Run Settings -->
                        <Border Background="{DynamicResource PosPanel}"
                                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                            <StackPanel>

                                <!-- Customer Selector -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CustomerCombo"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              md:HintAssist.Hint="Customer (or Walk-in)"
                                              FontSize="12" FontFamily="Segoe UI"
                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                              IsEditable="True"
                                              SelectionChanged="OnCustomerSelected"/>
                                    <Button x:Name="ClearCustomerBtn" Grid.Column="1"
                                            Click="OnClearCustomerSelection"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="{DynamicResource PosMutedText}"
                                            Padding="4" Margin="2,0,0,0"
                                            ToolTip="Clear customer"
                                            Visibility="Collapsed">
                                        <md:PackIcon Kind="CloseCircleOutline" Width="15" Height="15"/>
                                    </Button>
                                    <Button Grid.Column="3" Content="+ New"
                                            Click="OnAddNewCustomer"
                                            Style="{StaticResource Pos3DSecondaryBtn}"
                                            Height="32" Padding="8,0" FontSize="11"
                                            ToolTip="Register new customer"/>
                                </Grid>

                                <!-- Duplicate PO Notice -->
                                <Border x:Name="DuplicatePoNotice"
                                        Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1.5"
                                        CornerRadius="6" Padding="8,6" Margin="0,0,0,6"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <md:PackIcon Kind="AlertCircleOutline" Foreground="#D97706"
                                                         Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="DuplicatePoText"
                                                       Foreground="#92400E" FontSize="11" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Text="Customer already has a PO today."/>
                                        </StackPanel>
                                        <Button x:Name="AppendToExistingPoBtn" Grid.Column="1"
                                                Click="OnAppendToExistingPoClick"
                                                Style="{StaticResource Pos3DSuccessBtn}"
                                                Height="24" Padding="8,0" FontSize="10.5" FontWeight="Bold"
                                                ToolTip="Append items to existing PO"/>
                                    </Grid>
                                </Border>

                                <!-- Shopping Day + Scan button -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Shopping Day -->
                                    <ComboBox x:Name="BuyingDayCombo" Grid.Column="0"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              md:HintAssist.Hint="Shopping Day"
                                              FontSize="11.5"/>

                                    <!-- Scan & Add shortcut button (replaces duplicate store selector) -->
                                    <Button Grid.Column="2" Click="OnScanBarcode"
                                            Style="{StaticResource Pos3DPrimaryBtn}"
                                            Height="36" Padding="12,0"
                                            ToolTip="Scan product barcode to quickly add to order">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="BarcodeScan" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Scan &amp; Add" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Fulfillment -->
                                <ComboBox x:Name="FulfillmentCombo"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          md:HintAssist.Hint="Fulfillment"
                                          FontSize="11.5" SelectionChanged="OnFulfillmentChanged"
                                          Margin="0,0,0,6"/>

                                <!-- Delivery Address -->
                                <TextBox x:Name="DeliveryAddressBox"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         md:HintAssist.Hint="Delivery Address..."
                                         FontSize="11" Margin="0,0,0,6" Height="45"
                                         TextWrapping="Wrap" AcceptsReturn="True" Visibility="Collapsed"/>

                                <!-- Notes toggle -->
                                <Button x:Name="AddNoteBtn"
                                        Content="+ Add PO notes / special instructions"
                                        Click="OnToggleNotes"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="{DynamicResource PosMutedText}"
                                        FontSize="11" Padding="0,2"
                                        HorizontalAlignment="Left"/>
                                <TextBox x:Name="NotesBox"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         md:HintAssist.Hint="Special instructions..."
                                         FontSize="11.5" Margin="0,4,0,0"
                                         Height="50" TextWrapping="Wrap" AcceptsReturn="True"
                                         Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Cart Items List -->
                        <Border Background="{DynamicResource PosPanel}"
                                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="8,6" Margin="0,0,0,6" MinHeight="60">
                            <Grid>
                                <!-- Empty state -->
                                <StackPanel x:Name="EmptyCartPanel" VerticalAlignment="Center"
                                            HorizontalAlignment="Center" Margin="0,12">
                                    <md:PackIcon Kind="CartOutline" Width="36" Height="36"
                                                 Foreground="{DynamicResource PosMutedText}"
                                                 HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Ticket is empty" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource PosMutedText}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Use Quick Entry above or tap product cards"
                                               FontSize="10.5" Foreground="{DynamicResource PosMutedText}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Cart list -->
                                <ItemsControl x:Name="CartItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource PosBorder}"
                                                    BorderThickness="0,0,0,1" Padding="0,6">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="68"/>
                                                        <ColumnDefinition Width="24"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Item name + store + qty×unit + price -->
                                                    <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="Bold" FontSize="12"
                                                                   Foreground="{DynamicResource PosPrimaryText}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <!-- Store badge -->
                                                            <Border Background="{DynamicResource PosLightBlue}"
                                                                    CornerRadius="3" Padding="5,1" Margin="0,0,4,0">
                                                                <TextBlock Text="{Binding Store, TargetNullValue='General'}"
                                                                           FontSize="9" FontWeight="Bold"
                                                                           Foreground="{DynamicResource PosPrimary}"/>
                                                            </Border>
                                                            <!-- Unit badge (set / pack / pc / kg / etc.) -->
                                                            <Border Background="#F1F5F9" CornerRadius="3" Padding="5,1" Margin="0,0,4,0">
                                                                <TextBlock Text="{Binding Unit, TargetNullValue='pc'}" FontSize="9" FontWeight="SemiBold" Foreground="#475569"/>
                                                            </Border>
                                                            <!-- Price/unit -->
                                                            <TextBlock Text="{Binding Price, StringFormat='₱{0:N2}'}"
                                                                       FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PosSecondaryText}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Qty stepper: [−] n [+] (Touch Friendly) -->
                                                    <Border Grid.Row="0" Grid.Column="1"
                                                            Background="{DynamicResource PosSurface}"
                                                            BorderBrush="{DynamicResource PosBorder}"
                                                            BorderThickness="1" CornerRadius="14"
                                                            Padding="2,1" Margin="6,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="−" Click="OnDecreaseQty" Tag="{Binding}"
                                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                                    Padding="0" Width="26" Height="26"
                                                                    FontSize="14" FontWeight="Black"
                                                                    Foreground="{DynamicResource PosSecondaryText}"
                                                                    ToolTip="Decrease quantity"/>
                                                            <TextBlock Text="{Binding Qty}"
                                                                       FontWeight="Black" FontSize="12.5"
                                                                       Width="26" TextAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource PosPrimaryText}"/>
                                                            <Button Content="+" Click="OnIncreaseQty" Tag="{Binding}"
                                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                                    Padding="0" Width="26" Height="26"
                                                                    FontSize="14" FontWeight="Black"
                                                                    Foreground="{DynamicResource PosPrimary}"
                                                                    ToolTip="Increase quantity"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Line subtotal -->
                                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                                               Text="{Binding Subtotal, StringFormat='₱{0:N2}'}"
                                                               FontWeight="Bold" FontSize="12.5"
                                                               Foreground="{DynamicResource PosPrimaryText}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right"/>

                                                    <!-- Remove -->
                                                    <Button Grid.Row="0" Grid.Column="3" Click="OnRemoveCartItem" Tag="{Binding}"
                                                            Style="{StaticResource MaterialDesignFlatButton}"
                                                            Foreground="{DynamicResource PosDanger}"
                                                            Padding="1" Width="24" Height="24"
                                                            VerticalAlignment="Center" Margin="2,0,0,0"
                                                            ToolTip="Remove item">
                                                        <md:PackIcon Kind="TrashCanOutline" Width="14" Height="14"/>
                                                    </Button>

                                                    <!-- Inline Notes -->
                                                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="10.5" FontFamily="Segoe UI"
                                                             Foreground="{DynamicResource PosSecondaryText}"
                                                             md:HintAssist.Hint="+ Item notes..."
                                                             BorderThickness="0" Background="{DynamicResource PosPanel}"
                                                             Margin="0,4,0,2" Padding="6,2"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- Totals Breakdown -->
                        <Border Background="{DynamicResource PosPanel}"
                                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Total Items" FontSize="11.5" Foreground="{DynamicResource PosSecondaryText}"/>
                                    <TextBlock x:Name="TotalItemsCountLabel" Text="0 items"
                                               HorizontalAlignment="Right" FontWeight="SemiBold"
                                               FontSize="11.5" Foreground="{DynamicResource PosPrimaryText}"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Items Subtotal" FontSize="11.5" Foreground="{DynamicResource PosSecondaryText}"/>
                                    <TextBlock x:Name="SubtotalLabel" Text="₱0.00"
                                               HorizontalAlignment="Right" FontWeight="SemiBold"
                                               FontSize="11.5" Foreground="{DynamicResource PosPrimaryText}"/>
                                </Grid>
                                <!-- Pasabuy Fee row with Manual Override toggle -->
                                <StackPanel x:Name="PasabuyFeeRow" Margin="0,0,0,4">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Pasabuy Fee" FontSize="11.5" Foreground="{DynamicResource PosSecondaryText}"/>
                                            <Button x:Name="ToggleFeeOverrideBtn"
                                                    Click="OnToggleFeeOverride"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Height="18" Padding="4,0" Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Switch between AUTO and MANUAL fee">
                                                <Border x:Name="FeeModeBadge" Background="{DynamicResource PosLightBlue}" CornerRadius="3" Padding="4,1">
                                                    <TextBlock x:Name="FeeModeBadgeText" Text="AUTO" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource PosPrimary}"/>
                                                </Border>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="PasabuyFeeLabel" Text="₱0.00"
                                                   HorizontalAlignment="Right" FontWeight="SemiBold"
                                                   FontSize="11.5" Foreground="#0D9488"/>
                                    </Grid>
                                    <!-- Manual fee input panel (hidden by default) -->
                                    <Border x:Name="ManualFeePanel"
                                            Visibility="Collapsed" Margin="0,5,0,0"
                                            Background="#F0FDF4" BorderBrush="#10B981" BorderThickness="1"
                                            CornerRadius="6" Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ManualFeeBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     md:HintAssist.Hint="Enter fee (₱)..."
                                                     FontSize="12" FontWeight="Bold"
                                                     TextChanged="OnManualFeeChanged"/>
                                            <Button Grid.Column="2" Content="Apply"
                                                    Click="OnApplyManualFee"
                                                    Style="{StaticResource Pos3DSuccessBtn}"
                                                    Height="32" Padding="10,0" FontSize="11"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,2,0,0">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="ESTIMATED TOTAL" FontWeight="Bold" FontSize="11"
                                                       Foreground="#6D28D9"/>
                                            <TextBlock Text="Items + Fees" FontSize="9.5" Foreground="#8B5CF6"/>
                                        </StackPanel>
                                        <TextBlock x:Name="GrandTotalLabel" Text="₱0.00"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Black"
                                                   FontSize="21" Foreground="#452B86"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Payment (Optional / Tender) -->
                        <Border Background="{DynamicResource PosPanel}"
                                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="PAYMENT (OPTIONAL)" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,6"/>

                                <!-- Method + Amount -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PaymentMethodCombo" Grid.Column="0"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              md:HintAssist.Hint="Method" FontSize="11.5"
                                              SelectionChanged="OnPaymentMethodChanged"/>
                                    <TextBox x:Name="TenderedAmountBox" Grid.Column="2"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             md:HintAssist.Hint="Amount Paid (₱)" FontSize="12.5" FontWeight="Bold"
                                             TextChanged="OnTenderedAmountChanged"/>
                                </Grid>

                                <!-- Quick Cash Presets -->
                                <Grid x:Name="QuickCashPanel" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="EXACT" Click="OnQuickCashClick" Tag="exact" Style="{StaticResource TenderKeyStyle}" Margin="1,0"/>
                                    <Button Grid.Column="1" Content="₱50"   Click="OnQuickCashClick" Tag="50"    Style="{StaticResource TenderKeyStyle}" Margin="1,0"/>
                                    <Button Grid.Column="2" Content="₱100"  Click="OnQuickCashClick" Tag="100"   Style="{StaticResource TenderKeyStyle}" Margin="1,0"/>
                                    <Button Grid.Column="3" Content="₱200"  Click="OnQuickCashClick" Tag="200"   Style="{StaticResource TenderKeyStyle}" Margin="1,0"/>
                                    <Button Grid.Column="4" Content="₱500"  Click="OnQuickCashClick" Tag="500"   Style="{StaticResource TenderKeyStyle}" Margin="1,0"/>
                                    <Button Grid.Column="5" Content="₱1000" Click="OnQuickCashClick" Tag="1000"  Style="{StaticResource TenderKeyStyle}" Margin="1,0"/>
                                </Grid>

                                <!-- Change Due -->
                                <Border x:Name="ChangeDueBorder" Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1.5"
                                        CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="CHANGE DUE" FontSize="9.5" FontWeight="Bold" Foreground="#047857"/>
                                            <TextBlock x:Name="ChangeDueLabel" Text="₱0.00" FontSize="20" FontWeight="Black" Foreground="#059669"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#D1FAE5" CornerRadius="4" Padding="6,2">
                                            <TextBlock x:Name="PaymentStatusHint" Text="AWAITING" FontSize="9.5" FontWeight="Bold" Foreground="#065F46"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Ref # -->
                                <TextBox x:Name="PaymentRefBox"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         md:HintAssist.Hint="GCash / Maya / Bank Ref # (Optional)"
                                         FontSize="11" Margin="0,0,0,2"/>

                                <!-- Hidden stubs for code-behind compatibility -->
                                <Button x:Name="PayLaterBtn" Visibility="Collapsed" Tag="later" Click="OnPayOptionSelected"/>
                                <Button x:Name="PayNowBtn"  Visibility="Collapsed" Tag="now"   Click="OnPayOptionSelected"/>
                                <StackPanel x:Name="PayNowPanel" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Save Button (Prominent Action Bar) -->
                <Button Grid.Row="2" Height="52" Click="OnPlaceOrder"
                        Style="{StaticResource Pos3DPrimaryBtn}"
                        Margin="0,10,0,0" Cursor="Hand"
                        ToolTip="Save purchase order (F5)">
                    <Grid Width="340">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <md:PackIcon Kind="ClipboardCheckOutline" Width="22" Height="22"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="SAVE PURCHASE ORDER"
                                       FontWeight="Black" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="#6D28D9" CornerRadius="4" Padding="7,2" Margin="0,0,10,0">
                            <TextBlock Text="F5" FontSize="10.5" FontWeight="Black" Foreground="White"/>
                        </Border>
                    </Grid>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
