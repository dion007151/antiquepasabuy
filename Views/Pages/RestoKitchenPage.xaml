<Page x:Class="AntiquePasabuyPOS.Views.Pages.RestoKitchenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource PosBackground}"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Kitchen Display System (KDS)" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource PosPrimaryText}"/>
                <TextBlock Text="Live order preparation tickets for the kitchen and grill station."
                           FontSize="12" Foreground="{DynamicResource PosSecondaryText}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Click="OnRefreshClick" Style="{StaticResource Pos3DSecondaryBtn}" Height="36" Padding="12,0" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Refresh Tickets" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Kitchen Tickets Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="KitchenTicketsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PosSurface}"
                                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                                CornerRadius="10" Padding="14" Margin="8" Width="260" MinHeight="200">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Ticket Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding OrderNo}" FontWeight="Bold" FontSize="14"
                                               Foreground="{DynamicResource PosPrimaryText}"/>
                                    <Border HorizontalAlignment="Right" Background="{DynamicResource PosPanel}"
                                            CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource PosPrimary}"/>
                                    </Border>
                                </Grid>

                                <!-- Table & Server -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding TableNumber, StringFormat='{}Table: {0}'}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PosPrimaryText}"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}Time: {0:hh:mm tt}'}" FontSize="11"
                                               Foreground="{DynamicResource PosSecondaryText}"/>
                                </StackPanel>

                                <!-- Items List -->
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding Items}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <TextBlock Text="{Binding Quantity, StringFormat='{}{0}x'}" FontWeight="Bold"
                                                           Foreground="{DynamicResource PosPrimary}" Width="24"/>
                                                <TextBlock Text="{Binding ItemName}" Margin="26,0,0,0" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PosPrimaryText}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Advance Status and Cancel/Delete Ticket -->
                                <Grid Grid.Row="3" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Click="OnAdvanceStatusClick" Tag="{Binding}"
                                            Style="{StaticResource Pos3DPrimaryBtn}" Height="34">
                                        <TextBlock Text="Advance Status →" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                    <Button Grid.Column="2" Click="OnCancelKitchenTicketClick" Tag="{Binding}"
                                            Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1"
                                            Foreground="#DC2626" Height="34" Width="34" Padding="0" Cursor="Hand"
                                            ToolTip="Delete / Void this kitchen ticket">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                        <md:PackIcon Kind="DeleteOutline" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
