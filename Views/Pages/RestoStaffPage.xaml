<Page x:Class="AntiquePasabuyPOS.Views.Pages.RestoStaffPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource PosBackground}"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Page.Resources>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Restaurant Staff Directory" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource PosPrimaryText}"/>
                <TextBlock Text="Manage waiters, bartenders, chefs, supervisors, and cashiers."
                           FontSize="12" Foreground="{DynamicResource PosSecondaryText}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox x:Name="TxtSearchStaff" Width="200" Height="36" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:HintAssist.Hint="Search staff..." TextChanged="OnSearchTextChanged" Margin="0,0,10,0"/>
                <Button Click="OnAddStaffClick" Style="{StaticResource Pos3DPrimaryBtn}" Height="36" Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="AccountPlus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="+ ADD STAFF" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Staff List -->
        <Border Grid.Row="1" Background="{DynamicResource PosSurface}"
                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <DataGrid x:Name="StaffGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                      RowBackground="{DynamicResource PosSurface}"
                      AlternatingRowBackground="{DynamicResource PosTableRow}"
                      MouseDoubleClick="OnGridRowDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Staff Code" Binding="{Binding StaffCode}" Width="110" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120"/>
                    <DataGridTextColumn Header="Shift" Binding="{Binding Shift}" Width="110"/>
                    <DataGridTextColumn Header="Contact Number" Binding="{Binding ContactNumber}" Width="140"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="85"/>
                    <DataGridTextColumn Header="Hire Date" Binding="{Binding HireDate, StringFormat='MMM dd, yyyy'}" Width="120"/>

                    <!-- Action Buttons -->
                    <DataGridTemplateColumn Header="Actions" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Click="OnEditStaffRowClick" Tag="{Binding}" Style="{StaticResource Pos3DFilterBtn}"
                                            Height="28" Padding="8,0" Margin="0,0,4,0" ToolTip="Edit Staff">
                                        <md:PackIcon Kind="Pencil" Width="13" Height="13"/>
                                    </Button>
                                    <Button Click="OnDeleteStaffRowClick" Tag="{Binding}" Style="{StaticResource Pos3DTableDangerBtn}"
                                            Height="28" Padding="8,0" ToolTip="Delete Staff">
                                        <md:PackIcon Kind="Delete" Width="13" Height="13"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
