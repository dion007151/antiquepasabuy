<Page x:Class="AntiquePasabuyPOS.Views.Pages.ExpensesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:views="clr-namespace:AntiquePasabuyPOS.Views"
      Background="{DynamicResource PosBackground}"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Filters & Search -->
            <RowDefinition Height="Auto"/> <!-- KPI Summary Cards -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- 1. Header with Title and Top Quick Action -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Expenses &amp; Fuel Tracking" FontSize="18" FontWeight="Bold" Foreground="#102A43" FontFamily="Segoe UI"/>
                <TextBlock Text="Track operational expenses, vehicle fuel, parking, and purchasing supplies" Foreground="#64748B" FontSize="11.5" FontFamily="Segoe UI"/>
            </StackPanel>

            <!-- TOP ACTION: [ + ADD EXPENSE ] -->
            <Button Style="{StaticResource Pos3DPrimaryBtn}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="OnAdd">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="ADD EXPENSE" FontWeight="Bold" FontSize="12" FontFamily="Segoe UI"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 2. Filters & Search Bar -->
        <Border Grid.Row="1" Background="{DynamicResource PosSurface}" CornerRadius="8" BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" Margin="0,0,0,10" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Filters -->
                    <ColumnDefinition Width="*"/>    <!-- Search -->
                    <ColumnDefinition Width="Auto"/> <!-- Bulk Toolbar -->
                </Grid.ColumnDefinitions>

                <!-- Filters: [ ALL ], [ TODAY ], [ THIS WEEK ], [ THIS MONTH ] -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,14,0">
                    <Button x:Name="FilterAllBtn" Content="ALL" Click="OnFilterClick" Tag="all"
                            Style="{StaticResource Pos3DFilterBtn}"/>
                    <Button x:Name="FilterTodayBtn" Content="TODAY" Click="OnFilterClick" Tag="today"
                            Style="{StaticResource Pos3DFilterBtn}"/>
                    <Button x:Name="FilterWeekBtn" Content="THIS WEEK" Click="OnFilterClick" Tag="week"
                            Style="{StaticResource Pos3DFilterBtn}"/>
                    <Button x:Name="FilterMonthBtn" Content="THIS MONTH" Click="OnFilterClick" Tag="month"
                            Style="{StaticResource Pos3DFilterBtn}"/>
                </StackPanel>

                <!-- Search Box -->
                <Border Grid.Column="1" Background="{DynamicResource PosPanel}" CornerRadius="6" BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <md:PackIcon Kind="Magnify" Width="17" Height="17" Foreground="{DynamicResource PosSecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 FontSize="12.5" FontFamily="Segoe UI" VerticalAlignment="Center"
                                 md:HintAssist.Hint="Search expense description, category, or notes..."
                                 TextChanged="OnSearchChanged"/>
                        <Button x:Name="ClearSearchBtn" Grid.Column="2" Content="✕" Click="OnClearSearch"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{DynamicResource PosSecondaryText}" Padding="6,2" FontSize="11"
                                ToolTip="Clear search"/>
                    </Grid>
                </Border>

                <!-- Bulk Selection Toolbar -->
                <StackPanel x:Name="BulkSelectionPanel" Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Background="{DynamicResource PosLightBlue}" CornerRadius="6"
                            Padding="7,3" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedCountLabel" Text="0 selected"
                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PosPrimary}"/>
                    </Border>
                    <Button Click="OnSelectAllClick" Style="{StaticResource Pos3DFilterBtn}" Height="30" Padding="8,0" Margin="0,0,4,0" ToolTip="Select all visible expenses">
                        <TextBlock Text="Select All" FontSize="11" FontWeight="SemiBold"/>
                    </Button>
                    <Button Click="OnClearSelectionClick" Style="{StaticResource Pos3DFilterBtn}" Height="30" Padding="8,0" Margin="0,0,4,0" ToolTip="Clear selection">
                        <TextBlock Text="Clear" FontSize="11" FontWeight="SemiBold"/>
                    </Button>
                    <Button x:Name="BulkDeleteBtn" Click="OnBulkDeleteClick" Style="{StaticResource Pos3DDangerBtn}" Height="30" Padding="10,0" ToolTip="Delete selected expenses">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="DeleteOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Delete" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. KPI Summary Cards (Compact 1-row) -->
        <Border Grid.Row="2" Background="{DynamicResource PosSurface}" CornerRadius="8" BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TODAY'S EXPENSES" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="TodayLabel" Text="₱0.00" FontSize="17" FontWeight="Bold" Foreground="#EF4444" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="THIS MONTH" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="MonthLabel" Text="₱0.00" FontSize="17" FontWeight="Bold" Foreground="#F59E0B" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="FILTERED TOTAL" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="CountLabel" Text="0 records" FontSize="17" FontWeight="Bold" Foreground="#2563EB" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. DataGrid with Row Actions -->
        <Border Grid.Row="3" Background="{DynamicResource PosSurface}" CornerRadius="8" BorderBrush="{DynamicResource PosBorder}" BorderThickness="1">
            <Grid>
                <DataGrid x:Name="MainGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" Style="{StaticResource MaterialDesignDataGrid}"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          MinRowHeight="46" AlternationCount="2" FontFamily="Segoe UI" FontSize="12.5"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <!-- SELECTION CHECKBOX COLUMN -->
                        <DataGridTemplateColumn Width="46" CanUserResize="False">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="HeaderSelectAll" Click="OnHeaderSelectAllClick"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ToolTip="Select / Deselect all visible expenses"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Click="OnRowCheckBoxClick"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Description" Binding="{Binding Description, TargetNullValue='Expense'}" Width="*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category, TargetNullValue='General'}" Width="120"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='₱{0:N2}'}" Width="110" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding ExpenseDate, StringFormat='MMM dd, yyyy'}" Width="120"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes, TargetNullValue='-'}" Width="*"/>
                    
                        <!-- ROW ACTIONS: [ VIEW ] and [ ••• ] -->
                        <DataGridTemplateColumn Header="Actions" Width="Auto" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- ROW ACTION: [ VIEW ] -->
                                        <Button Content="VIEW" Tag="{Binding Id}"
                                                Style="{StaticResource Pos3DTableActionBtn}"
                                                Margin="0,0,5,0"
                                                Click="OnViewExpense"/>

                                        <!-- ROW ACTION: [ ••• ] MORE MENU -->
                                        <Button Style="{StaticResource Pos3DTableMoreBtn}"
                                                Click="OnMoreMenuClick" Tag="{Binding Id}"
                                                ToolTip="More Actions">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Edit Expense" Click="OnEditFromMenu">
                                                        <MenuItem.Icon>
                                                            <md:PackIcon Kind="PencilOutline" Width="16" Height="16" Foreground="#2563EB"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="Delete Expense" Click="OnDeleteFromMenu" Foreground="#EF4444">
                                                        <MenuItem.Icon>
                                                            <md:PackIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="#EF4444"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State for Expenses -->
                <Border x:Name="EmptyStatePanel" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <md:PackIcon Kind="CurrencyUsd" Width="44" Height="44" Foreground="{DynamicResource PosMutedText}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="No Expenses Found" FontSize="15" FontWeight="SemiBold" Foreground="#102A43" HorizontalAlignment="Center"/>
                        <TextBlock Text="No expenses match the current filter or search." FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
