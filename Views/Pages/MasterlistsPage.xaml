<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AntiquePasabuyPOS.Views.Pages.MasterlistsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource PosBackground}"
      Focusable="True"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Page.Resources>
        <!-- KPI Card style identical to OrdersPage -->
        <Style x:Key="MlKpiCard" TargetType="Border">
            <Setter Property="Background"       Value="{DynamicResource PosSurface}"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource PosBorder}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="10"/>
            <Setter Property="Padding"          Value="14,10"/>
        </Style>

        <!-- DataGridCell vertical centering -->
        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"        Value="Center"/>
            <Setter Property="Padding"                  Value="6,0"/>
        </Style>

        <!-- Status badge helper -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius"     Value="5"/>
            <Setter Property="Padding"          Value="7,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Page.Resources>

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header + actions -->
            <RowDefinition Height="Auto"/>  <!-- KPI cards -->
            <RowDefinition Height="Auto"/>  <!-- Search / filter bar -->
            <RowDefinition Height="*"/>     <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- ══ ROW 0: HEADER ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Masterlists" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"/>
                <TextBlock Text="Manage weekly customer orders, purchasing, and historical batches."
                           Foreground="{DynamicResource PosSecondaryText}" FontSize="12"
                           FontFamily="Segoe UI" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="CreateMasterlistBtn"
                        Style="{StaticResource Pos3DPrimaryBtn}"
                        Margin="0,0,8,0" Height="38" Padding="16,0"
                        Click="OnCreateMasterlist">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="PlusCircleOutline" Width="16" Height="16"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="+ CREATE NEW MASTERLIST" FontSize="12" FontWeight="Bold"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OnRefresh" Style="{StaticResource Pos3DSecondaryBtn}"
                        Width="38" Height="38" Padding="0" ToolTip="Refresh Masterlists">
                    <md:PackIcon x:Name="RefreshIcon" Kind="Refresh" Width="17" Height="17"
                                 Foreground="{DynamicResource PosSecondaryText}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══ ROW 1: KPI SUMMARY CARDS ══════════════════════════════════════ -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,12">

            <Border Style="{StaticResource MlKpiCard}" Margin="0,0,6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#EDE9FE" CornerRadius="6" Padding="5" Margin="0,0,8,0">
                            <md:PackIcon Kind="ClipboardListOutline" Width="15" Height="15" Foreground="#4F46E5"/>
                        </Border>
                        <TextBlock Text="Total Batches" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PosSecondaryText}" FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="KpiTotalBatches" Text="0" FontSize="22" FontWeight="Bold"
                               Foreground="#4F46E5" FontFamily="Segoe UI"/>
                    <TextBlock Text="all time" FontSize="10" Foreground="{DynamicResource PosMutedText}"
                               FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MlKpiCard}" Margin="0,0,6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#D1FAE5" CornerRadius="6" Padding="5" Margin="0,0,8,0">
                            <md:PackIcon Kind="CheckCircleOutline" Width="15" Height="15" Foreground="#059669"/>
                        </Border>
                        <TextBlock Text="Active" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PosSecondaryText}" FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="KpiActive" Text="0" FontSize="22" FontWeight="Bold"
                               Foreground="#059669" FontFamily="Segoe UI"/>
                    <TextBlock Text="open batches" FontSize="10" Foreground="{DynamicResource PosMutedText}"
                               FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MlKpiCard}" Margin="0,0,6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#FEF3C7" CornerRadius="6" Padding="5" Margin="0,0,8,0">
                            <md:PackIcon Kind="AccountGroupOutline" Width="15" Height="15" Foreground="#D97706"/>
                        </Border>
                        <TextBlock Text="Customer Orders" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PosSecondaryText}" FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="KpiTotalOrders" Text="0" FontSize="22" FontWeight="Bold"
                               Foreground="#D97706" FontFamily="Segoe UI"/>
                    <TextBlock Text="across all batches" FontSize="10" Foreground="{DynamicResource PosMutedText}"
                               FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MlKpiCard}" Margin="0,0,6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#CFFAFE" CornerRadius="6" Padding="5" Margin="0,0,8,0">
                            <md:PackIcon Kind="PackageVariantClosed" Width="15" Height="15" Foreground="#0891B2"/>
                        </Border>
                        <TextBlock Text="Total Items" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PosSecondaryText}" FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="KpiTotalItems" Text="0" FontSize="22" FontWeight="Bold"
                               Foreground="#0891B2" FontFamily="Segoe UI"/>
                    <TextBlock Text="ordered items" FontSize="10" Foreground="{DynamicResource PosMutedText}"
                               FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MlKpiCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#FEE2E2" CornerRadius="6" Padding="5" Margin="0,0,8,0">
                            <md:PackIcon Kind="AlertCircleOutline" Width="15" Height="15" Foreground="#DC2626"/>
                        </Border>
                        <TextBlock Text="Not Available" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PosSecondaryText}" FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="KpiUnavailable" Text="0" FontSize="22" FontWeight="Bold"
                               Foreground="#DC2626" FontFamily="Segoe UI"/>
                    <TextBlock Text="items unavailable" FontSize="10" Foreground="{DynamicResource PosMutedText}"
                               FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ══ ROW 2: SEARCH / FILTER BAR ════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource PosSurface}"
                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Border Grid.Column="0" Background="{DynamicResource PosBackground}"
                        BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                        CornerRadius="7" Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <md:PackIcon Kind="Magnify" Width="15" Height="15"
                                     Foreground="{DynamicResource PosSecondaryText}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 FontSize="12.5" FontFamily="Segoe UI"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource PosInputText}"
                                 VerticalContentAlignment="Center"
                                 Padding="0,8"
                                 md:HintAssist.Hint="Search control number or name…"
                                 TextChanged="OnSearchChanged"/>
                    </Grid>
                </Border>

                <!-- Month filter -->
                <ComboBox x:Name="FilterMonthBox" Grid.Column="2"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          FontSize="12.5" FontFamily="Segoe UI"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="All Months" IsSelected="True"/>
                    <ComboBoxItem Content="January"    Tag="1"/>
                    <ComboBoxItem Content="February"   Tag="2"/>
                    <ComboBoxItem Content="March"      Tag="3"/>
                    <ComboBoxItem Content="April"      Tag="4"/>
                    <ComboBoxItem Content="May"        Tag="5"/>
                    <ComboBoxItem Content="June"       Tag="6"/>
                    <ComboBoxItem Content="July"       Tag="7"/>
                    <ComboBoxItem Content="August"     Tag="8"/>
                    <ComboBoxItem Content="September"  Tag="9"/>
                    <ComboBoxItem Content="October"    Tag="10"/>
                    <ComboBoxItem Content="November"   Tag="11"/>
                    <ComboBoxItem Content="December"   Tag="12"/>
                </ComboBox>

                <!-- Year filter -->
                <ComboBox x:Name="FilterYearBox" Grid.Column="4"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          FontSize="12.5" FontFamily="Segoe UI"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="All Years" IsSelected="True"/>
                </ComboBox>

                <!-- Status filter -->
                <ComboBox x:Name="FilterStatusBox" Grid.Column="6"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          FontSize="12.5" FontFamily="Segoe UI"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="All Statuses" IsSelected="True"/>
                    <ComboBoxItem Content="Active"/>
                    <ComboBoxItem Content="Closed"/>
                    <ComboBoxItem Content="Archived"/>
                </ComboBox>

                <!-- Sort -->
                <ComboBox x:Name="SortBox" Grid.Column="8"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          FontSize="12.5" FontFamily="Segoe UI"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Newest First"      Tag="newest"  IsSelected="True"/>
                    <ComboBoxItem Content="Oldest First"      Tag="oldest"/>
                    <ComboBoxItem Content="Most Orders"       Tag="orders"/>
                    <ComboBoxItem Content="Most Items"        Tag="items"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- ══ ROW 3: DATA GRID ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="3">
            <!-- Loading overlay -->
            <Border x:Name="LoadingOverlay" Background="{DynamicResource PosBackground}"
                    Visibility="Collapsed" Panel.ZIndex="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <md:PackIcon Kind="Loading" Width="36" Height="36" Foreground="#6366F1"
                                 RenderTransformOrigin="0.5,0.5">
                        <md:PackIcon.RenderTransform>
                            <RotateTransform/>
                        </md:PackIcon.RenderTransform>
                        <md:PackIcon.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </md:PackIcon.Triggers>
                    </md:PackIcon>
                    <TextBlock Text="Loading masterlists…" FontSize="13" Foreground="{DynamicResource PosSecondaryText}"
                               FontFamily="Segoe UI" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Empty state -->
            <Border x:Name="EmptyState" Visibility="Collapsed"
                    Background="{DynamicResource PosSurface}"
                    BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                    CornerRadius="12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                    <Border Background="#EDE9FE" CornerRadius="50" Width="80" Height="80"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <md:PackIcon Kind="ClipboardTextOutline" Width="38" Height="38"
                                     Foreground="#6366F1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No masterlists found" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Create your first weekly masterlist to get started."
                               FontSize="12.5" Foreground="{DynamicResource PosSecondaryText}"
                               FontFamily="Segoe UI" HorizontalAlignment="Center"
                               Margin="0,6,0,20" TextAlignment="Center"/>
                    <Button Style="{StaticResource Pos3DPrimaryBtn}" Height="38" Padding="20,0"
                            HorizontalAlignment="Center" Click="OnCreateMasterlist">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Create New Masterlist" FontSize="12" FontWeight="Bold"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Main data grid -->
            <DataGrid x:Name="MasterlistGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeight="44"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource PosBorder}"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      Background="{DynamicResource PosSurface}"
                      RowBackground="{DynamicResource PosTableRow}"
                      AlternatingRowBackground="{DynamicResource PosAlternateRow}"
                      BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                      Padding="0,0,0,0"
                      MouseDoubleClick="OnRowDoubleClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="Background"   Value="{DynamicResource PosTableHeader}"/>
                        <Setter Property="Foreground"   Value="{DynamicResource PosSecondaryText}"/>
                        <Setter Property="FontSize"     Value="10.5"/>
                        <Setter Property="FontWeight"   Value="Bold"/>
                        <Setter Property="FontFamily"   Value="Segoe UI"/>
                        <Setter Property="Padding"      Value="6,10"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <!-- Control Number -->
                    <DataGridTemplateColumn Header="Control No." Width="130" SortMemberPath="ControlNumber">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#F5F3FF" CornerRadius="5" Padding="7,3">
                                    <TextBlock Text="{Binding ControlNumber}"
                                               FontSize="11.5" FontWeight="Bold"
                                               Foreground="#4338CA" FontFamily="Segoe UI Mono, Consolas, Segoe UI"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Name / Week -->
                    <DataGridTemplateColumn Header="Masterlist / Week" Width="*" MinWidth="160" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"/>
                                    <TextBlock Text="{Binding MonthYearDisplay}" FontSize="10.5"
                                               Foreground="{DynamicResource PosMutedText}" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Date Range -->
                    <DataGridTemplateColumn Header="Date Range" Width="160" SortMemberPath="StartDate">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DateRangeDisplay}" FontSize="12"
                                           Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Order Count -->
                    <DataGridTemplateColumn Header="Customer Orders" Width="110" SortMemberPath="OrderCount">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OrderCount}" FontSize="13" FontWeight="Bold"
                                           Foreground="#4F46E5" TextAlignment="Center"
                                           VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Total Items Ordered -->
                    <DataGridTemplateColumn Header="Total Ordered" Width="100" SortMemberPath="TotalOrderedItems">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalOrderedItems, StringFormat=N0}" FontSize="12.5"
                                           Foreground="{DynamicResource PosPrimaryText}" TextAlignment="Center"
                                           VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Total Purchased -->
                    <DataGridTemplateColumn Header="Purchased" Width="90" SortMemberPath="TotalPurchased">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalPurchased, StringFormat=N0}" FontSize="12.5"
                                           Foreground="#059669" TextAlignment="Center"
                                           VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Bought On Hand -->
                    <DataGridTemplateColumn Header="Bought On Hand" Width="105" SortMemberPath="TotalBoughtOnHand">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalBoughtOnHand, StringFormat=N0}" FontSize="12.5"
                                           Foreground="#0891B2" TextAlignment="Center"
                                           VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Not Available -->
                    <DataGridTemplateColumn Header="Not Available" Width="100" SortMemberPath="TotalUnavailable">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalUnavailable, StringFormat=N0}" FontSize="12.5"
                                           Foreground="#DC2626" TextAlignment="Center"
                                           VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Created Date -->
                    <DataGridTemplateColumn Header="Created" Width="100" SortMemberPath="CreatedAt">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CreatedAt, StringFormat='MMM dd, yyyy'}" FontSize="11.5"
                                           Foreground="{DynamicResource PosSecondaryText}"
                                           VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status -->
                    <DataGridTemplateColumn Header="Status" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="StatusBorder" CornerRadius="5" Padding="7,3" HorizontalAlignment="Left">
                                    <TextBlock x:Name="StatusText" FontSize="10.5" FontWeight="Bold"
                                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EDE9FE"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Active">
                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Closed">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Archived">
                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Active">
                                        <Setter TargetName="StatusText" Property="Text" Value="Active"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#059669"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Closed">
                                        <Setter TargetName="StatusText" Property="Text" Value="Closed"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#D97706"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Archived">
                                        <Setter TargetName="StatusText" Property="Text" Value="Archived"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#64748B"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="Actions" Width="180" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Open/View -->
                                    <Button Tag="{Binding}" Click="OnOpenMasterlist"
                                            Style="{StaticResource Pos3DSecondaryBtn}"
                                            Height="28" Padding="10,0" Margin="0,0,4,0"
                                            FontSize="11" ToolTip="Open / View this masterlist">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="OpenInApp" Width="13" Height="13"
                                                         VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="Open" FontSize="11" FontWeight="SemiBold"
                                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Print -->
                                    <Button Tag="{Binding}" Click="OnPrintMasterlist"
                                            Style="{StaticResource Pos3DSecondaryBtn}"
                                            Height="28" Padding="8,0" Margin="0,0,4,0"
                                            ToolTip="Print this masterlist">
                                        <md:PackIcon Kind="PrinterOutline" Width="14" Height="14"/>
                                    </Button>

                                    <!-- More actions (Close / Archive) -->
                                    <Button Tag="{Binding}" Click="OnMoreActions"
                                            Style="{StaticResource Pos3DSecondaryBtn}"
                                            Height="28" Padding="8,0"
                                            ToolTip="More actions">
                                        <md:PackIcon Kind="DotsHorizontal" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>
