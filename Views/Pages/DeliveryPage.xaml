<Page x:Class="AntiquePasabuyPOS.Views.Pages.DeliveryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:views="clr-namespace:AntiquePasabuyPOS.Views"
      Background="{DynamicResource PosBackground}"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="PageTitle" Text="Delivery &amp; Pickup" FontSize="18" FontWeight="Bold" Foreground="#102A43" FontFamily="Segoe UI"/>
                <TextBlock Text="Track deliveries and customer pickups" Foreground="#64748B" FontSize="11.5" FontFamily="Segoe UI"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Search Box with Clear Button -->
                <Border Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1"
                        Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Grid Width="250">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <md:PackIcon Grid.Column="0" Kind="Magnify" Width="17" Height="17"
                                     Foreground="#94A3B8" VerticalAlignment="Center" Margin="2,0,6,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 BorderThickness="0" Background="Transparent"
                                 FontSize="12.5" FontFamily="Segoe UI" VerticalAlignment="Center"
                                 TextChanged="OnSearchChanged"
                                 md:HintAssist.Hint="Search order, customer, address..."
                                 md:TextFieldAssist.DecorationVisibility="Hidden"/>
                        <Button x:Name="ClearSearchBtn" Grid.Column="2" Click="OnClearSearch"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                                Visibility="Collapsed">
                            <md:PackIcon Kind="CloseCircleOutline" Width="15" Height="15" Foreground="#94A3B8"/>
                        </Button>
                    </Grid>
                </Border>

                <Button Click="OnRefresh"
                        Style="{StaticResource Pos3DPrimaryBtn}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Refresh" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Refresh" FontSize="12" FontWeight="Bold" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Top Filters: [ FOR DELIVERY ] [ OUT FOR DELIVERY ] [ DELIVERED ] [ READY FOR PICKUP ] [ PICKED UP ] [ COMPLETED ] -->
        <Border Grid.Row="1" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" CornerRadius="8" Padding="6,4" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="TabForDelivery" Content="FOR DELIVERY" Tag="for_delivery" Click="OnTabClick"
                        Style="{StaticResource Pos3DFilterBtn}"/>
                <Button x:Name="TabOutForDelivery" Content="OUT FOR DELIVERY" Tag="out_for_delivery" Click="OnTabClick"
                        Style="{StaticResource Pos3DFilterBtn}"/>
                <Button x:Name="TabDelivered" Content="DELIVERED" Tag="delivered" Click="OnTabClick"
                        Style="{StaticResource Pos3DFilterBtn}"/>
                <Button x:Name="TabPickup" Content="READY FOR PICKUP" Tag="pickup" Click="OnTabClick"
                        Style="{StaticResource Pos3DFilterBtn}"/>
                <Button x:Name="TabPickedUp" Content="PICKED UP" Tag="picked_up" Click="OnTabClick"
                        Style="{StaticResource Pos3DFilterBtn}"/>
                <Button x:Name="TabCompleted" Content="COMPLETED" Tag="completed" Click="OnTabClick"
                        Style="{StaticResource Pos3DFilterBtn}"/>
            </StackPanel>
        </Border>

        <!-- Main Dispatch Grid with Exact ONE Next Action -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="{DynamicResource PosBorder}" BorderThickness="1">
            <Grid>
                <DataGrid x:Name="MainGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" Style="{StaticResource MaterialDesignDataGrid}"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          MinRowHeight="46" AlternationCount="2" FontFamily="Segoe UI" FontSize="12.5"
                          CanUserResizeColumns="True"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PO #" Binding="{Binding Order.OrderNo, TargetNullValue='N/A'}" Width="90" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding Order.Customer.Name, TargetNullValue='Walk-in Customer'}" Width="1.5*" MinWidth="110"/>
                        <DataGridTextColumn Header="Address" Binding="{Binding DestinationAddress}" Width="2*" MinWidth="130"/>
                        <DataGridTemplateColumn Header="Rider Assigned" Width="Auto" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RiderDisplay}"
                                                   FontWeight="{Binding RiderFontWeight}"
                                                   Foreground="{Binding RiderForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <Button Visibility="{Binding CanAssignDriver, Converter={StaticResource BoolToVis}}"
                                                Content="{Binding AssignButtonLabel}"
                                                Tag="{Binding}"
                                                Click="OnAssignDriverClick"
                                                Style="{StaticResource Pos3DTableActionBtn}"
                                                FontSize="10.5"
                                                ToolTip="Assign or change rider for this delivery"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Total" Binding="{Binding Order.GrandTotal, StringFormat='₱{0:N2}'}" Width="90" FontWeight="SemiBold"/>
                        <DataGridTemplateColumn Header="Payment / COD" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <Border CornerRadius="5" Padding="6,2" HorizontalAlignment="Left" Background="{Binding PaymentBadgeBgBrush}">
                                            <TextBlock Text="{Binding PaymentBadgeText}" Foreground="{Binding PaymentBadgeFgBrush}"
                                                       FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding CodAmountText}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{Binding CodAmountFgBrush}" Margin="0,2,0,0"
                                                   Visibility="{Binding HasCodBalance, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,2" HorizontalAlignment="Left" Background="{Binding StatusBgBrush}">
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFgBrush}"
                                                   FontSize="10.5" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ONE OBVIOUS NEXT ACTION COLUMN -->
                        <DataGridTemplateColumn Header="Next Action" Width="Auto" MinWidth="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 1. FOR DELIVERY -> [ OUT FOR DELIVERY ] -->
                                        <Button Content="OUT FOR DELIVERY" Tag="{Binding}"
                                                Click="OnOutForDeliveryClick"
                                                Visibility="{Binding ShowOutForDeliveryBtn, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource Pos3DTablePrimaryBtn}"
                                                ToolTip="Dispatch rider out for delivery"/>

                                        <!-- 2. OUT FOR DELIVERY -> [ MARK DELIVERED ] -->
                                        <Button Content="MARK DELIVERED" Tag="{Binding}"
                                                Click="OnMarkDeliveredClick"
                                                Visibility="{Binding ShowMarkDeliveredBtn, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource Pos3DTablePrimaryBtn}"
                                                ToolTip="Confirm customer received the delivery"/>

                                        <!-- 3. READY FOR PICKUP -> [ MARK PICKED UP ] -->
                                        <Button Content="MARK PICKED UP" Tag="{Binding}"
                                                Click="OnMarkPickedUpClick"
                                                Visibility="{Binding ShowMarkPickedUpBtn, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource Pos3DTablePrimaryBtn}"
                                                ToolTip="Record customer picked up items from counter"/>

                                        <!-- 4. AFTER PICKUP -> [ COMPLETE ORDER ] -->
                                        <Button Content="COMPLETE ORDER" Tag="{Binding}"
                                                Click="OnCompleteOrderClick"
                                                Visibility="{Binding ShowCompleteOrderBtn, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource Pos3DTableSuccessBtn}"
                                                ToolTip="Finalize and complete order"/>

                                        <!-- When Finished: Completed Chip -->
                                        <Border Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}"
                                                Background="#ECFDF5" CornerRadius="5" Padding="6,2">
                                            <TextBlock Text="Completed" Foreground="#059669" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State -->
                <Border x:Name="EmptyStatePanel" Visibility="Collapsed" Background="Transparent"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <StackPanel HorizontalAlignment="Center">
                        <md:PackIcon Kind="TruckOutline" Width="36" Height="36" Foreground="{DynamicResource PosMutedText}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="No orders for delivery" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PosPrimaryText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Orders will appear here when they are ready for dispatch or pickup." FontSize="11.5" Foreground="{DynamicResource PosSecondaryText}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
