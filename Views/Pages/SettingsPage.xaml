<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AntiquePasabuyPOS.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:views="clr-namespace:AntiquePasabuyPOS.Views"
      Background="{DynamicResource PosBackground}"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Top Save -->
            <RowDefinition Height="Auto"/> <!-- Section Tab Switcher -->
            <RowDefinition Height="*"/>    <!-- Active Section Content -->
        </Grid.RowDefinitions>

        <!-- ══ 1. HEADER & PRIMARY SAVE ACTION ══════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EDE9FE" CornerRadius="8" Padding="7" Margin="0,0,10,0" VerticalAlignment="Center">
                        <md:PackIcon Kind="CogOutline" Width="18" Height="18" Foreground="#6D28D9" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="System Settings &amp; Configuration" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Manage business identity, fee rates, hardware printers, and storage"
                           Foreground="{DynamicResource PosSecondaryText}" FontSize="12" FontFamily="Segoe UI" Margin="40,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SaveStatus" Text="" Foreground="#0D9488"
                           FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"/>
                <Button Content="SAVE ALL SETTINGS" Click="OnSave"
                        Style="{StaticResource Pos3DPrimaryBtn}"
                        Height="38" Padding="18,0" FontSize="12" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- ══ 2. SECTION SWITCHER TABS ═════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                BorderThickness="1" CornerRadius="10" Padding="6,5" Margin="0,0,0,14">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TabBusiness" Tag="business" Click="OnSectionTabClick"
                            Style="{StaticResource Pos3DFilterBtn}" Height="34" Margin="0,0,4,0" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Domain" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="BUSINESS PROFILE" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabPasabuy" Tag="pasabuy" Click="OnSectionTabClick"
                            Style="{StaticResource Pos3DFilterBtn}" Height="34" Margin="0,0,4,0" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ShoppingOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="PASABUY &amp; RATES" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabPrinting" Tag="printing" Click="OnSectionTabClick"
                            Style="{StaticResource Pos3DFilterBtn}" Height="34" Margin="0,0,4,0" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="PrinterOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="PRINTING" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabData" Tag="data" Click="OnSectionTabClick"
                            Style="{StaticResource Pos3DFilterBtn}" Height="34" Margin="0,0,4,0" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="DatabaseOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="DATA &amp; BACKUP" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabDisplay" Tag="display" Click="OnSectionTabClick"
                            Style="{StaticResource Pos3DFilterBtn}" Height="34" Margin="0,0,4,0" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="PaletteOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="DISPLAY &amp; UI SCALE" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabSystem" Tag="system" Click="OnSectionTabClick"
                            Style="{StaticResource Pos3DFilterBtn}" Height="34" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Laptop" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="SYSTEM" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══ 3. ACTIVE SECTION CONTENT ═════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <!-- ========================================== -->
            <!-- 1. BUSINESS PROFILE SETTINGS               -->
            <!-- ========================================== -->
            <Border x:Name="SectionBusiness" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="20" Visibility="Visible" MaxWidth="840" HorizontalAlignment="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- PROFILE SELECTOR BANNER -->
                        <Border Background="{DynamicResource PosPanel}" BorderBrush="{DynamicResource PosBorder}"
                                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#EDE9FE" CornerRadius="6" Padding="5" Margin="0,0,8,0">
                                        <md:PackIcon Kind="DomainSwitch" Width="18" Height="18" Foreground="#6D28D9" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="ACTIVE BUSINESS PROFILE" FontSize="13.5" FontWeight="Bold"
                                               Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Select which business profile to operate. Changes apply immediately to navigation, branding, theme colors, and reports."
                                           FontSize="11.5" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbBusinessProfile" Grid.Column="0"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              FontSize="13" FontWeight="SemiBold"
                                              SelectionChanged="OnBusinessProfileSelectionChanged"/>
                                    <Button x:Name="BtnSwitchProfile" Grid.Column="2"
                                            Content="APPLY PROFILE" Click="OnApplyProfileClick"
                                            Style="{StaticResource Pos3DPrimaryBtn}"
                                            Height="40" Padding="18,0"/>
                                </Grid>
                                <TextBlock x:Name="TxtActiveProfileDesc" Text="" FontSize="11" Foreground="{DynamicResource PosPrimary}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- BUSINESS INFORMATION -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Background="#EDE9FE" CornerRadius="6" Padding="6" Margin="0,0,8,0">
                                <md:PackIcon Kind="Domain" Width="18" Height="18" Foreground="#6D28D9"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="BUSINESS INFORMATION" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"/>
                                <TextBlock Text="Business details shown on receipts, printouts, and reports" FontSize="11" Foreground="{DynamicResource PosSecondaryText}"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Business Name" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,5"/>
                                <TextBox x:Name="BizNameBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         md:HintAssist.Hint="Business Name" FontSize="12.5" Padding="10,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Subtitle / Tagline" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,5"/>
                                <TextBox x:Name="BizSubtitleBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         md:HintAssist.Hint="Subtitle / Business Category" FontSize="12.5" Padding="10,6"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Address / Location" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,5"/>
                                <TextBox x:Name="BizAddressBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         md:HintAssist.Hint="Store / Branch Location" FontSize="12.5" Padding="10,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Contact Number" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,5"/>
                                <TextBox x:Name="BizContactBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         md:HintAssist.Hint="Phone or Mobile Number" FontSize="12.5" Padding="10,6"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Receipt Header Message" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,5"/>
                        <TextBox x:Name="HeaderBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="Header text on printed receipts" FontSize="12.5" Margin="0,0,0,12" Padding="10,6"/>

                        <TextBlock Text="Receipt Footer Message" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,5"/>
                        <TextBox x:Name="FooterBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="Thank you message shown on receipts" FontSize="12.5" Margin="0,0,0,4" Padding="10,6"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========================================== -->
            <!-- 2. PASABUY & STORES SETTINGS               -->
            <!-- ========================================== -->
            <Border x:Name="SectionPasabuy" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="20" Visibility="Collapsed" MaxWidth="860" HorizontalAlignment="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Background="#EDE9FE" CornerRadius="6" Padding="6" Margin="0,0,8,0">
                                <md:PackIcon Kind="ShoppingOutline" Width="18" Height="18" Foreground="#6D28D9"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PASABUY &amp; PURCHASING CONFIGURATION" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"/>
                                <TextBlock Text="Official Antique Pasabuy rate table, scheduled shopping days, and store list" FontSize="11" Foreground="{DynamicResource PosSecondaryText}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- DAILY CHEAT SHEET (STAFF QUICK GUIDE) -->
                        <Border Background="#F5F3FF" BorderBrush="#C4B5FD" BorderThickness="1.5" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <md:PackIcon Kind="HelpCircleOutline" Width="16" Height="16" Foreground="#6D28D9" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="DAILY WORKFLOW CHEAT SHEET" FontSize="12" FontWeight="Bold" Foreground="#6D28D9" FontFamily="Segoe UI"/>
                                </StackPanel>
                                <TextBlock Text="1. Chat → New PO → Save (auto Waiting to Buy)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PosPrimaryText}" Margin="0,2,0,2"/>
                                <TextBlock Text="2. Open Shopping List → Start Shopping session" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PosPrimaryText}" Margin="0,0,0,2"/>
                                <TextBlock Text="3. Print checklist → shop at stores" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PosPrimaryText}" Margin="0,0,0,2"/>
                                <TextBlock Text="4. Mark items Bought + actual price (or Not available)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PosPrimaryText}" Margin="0,0,0,2"/>
                                <TextBlock Text="5. Finish Order → Collect payment → Done" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PosPrimaryText}"/>
                            </StackPanel>
                        </Border>

                        <!-- Pasabuy Fee Global Toggle & Default -->
                        <Border x:Name="PasabuyFeeNoticeBorder" Background="{DynamicResource PosPanel}" BorderBrush="{DynamicResource PosBorder}"
                                BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <CheckBox x:Name="ChkEnablePasabuyFee" Content="Enable Pasabuy Fee for New Transactions"
                                              FontWeight="Bold" FontSize="12.5" IsChecked="True"/>
                                    <TextBlock x:Name="TxtPasabuyFeeNotice" Text="When enabled, orders automatically calculate Pasabuy service fee based on tier rates."
                                               FontSize="11" Foreground="{DynamicResource PosSecondaryText}" Margin="26,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Default Fee: &#x20B1;" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBox x:Name="TxtDefaultPasabuyFee" Text="50.00" Width="75"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="36" Padding="6,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Pasabuy Rate Table Header -->
                        <Grid Margin="0,0,0,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Official Antique Pasabuy Rates" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryText}"/>
                                <TextBlock Text="Simple rates matching the official flyer (e.g. 0 to 99 pesos = &#x20B1;50, 100 to 199 = &#x20B1;75, ..., 2500 UP = 15%). Click cells to edit." FontSize="10.5" Foreground="{DynamicResource PosSecondaryText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="+ Add Tier" Click="OnAddRateTier"
                                        Style="{StaticResource Pos3DPrimaryBtn}"
                                        Height="32" Padding="10,0" FontSize="11" Margin="0,0,6,0"/>
                                <Button Content="Save Rates" Click="OnSaveRateTiers"
                                        Style="{StaticResource Pos3DSuccessBtn}"
                                        Height="32" Padding="10,0" FontSize="11" Margin="0,0,6,0"/>
                                <Button Content="Reset to Official" Click="OnResetDefaultRates"
                                        Style="{StaticResource Pos3DSecondaryBtn}"
                                        Height="32" Padding="10,0" FontSize="11"/>
                            </StackPanel>
                        </Grid>

                        <!-- Editable Rate Tiers DataGrid -->
                        <Border Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                                BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                            <DataGrid x:Name="RateTiersGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      MinRowHeight="38" AlternationCount="2"
                                      FontFamily="Segoe UI" FontSize="12"
                                      Background="Transparent" BorderThickness="0"
                                      CanUserResizeColumns="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      CellEditEnding="OnRateTierCellEditEnding">
                                <DataGrid.Columns>
                                    <!-- Min Amount (₱) -->
                                    <DataGridTemplateColumn Header="Min Amount (&#x20B1;)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding MinAmountDisplay}" VerticalAlignment="Center" Padding="4,0" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding MinAmountEdit, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Padding="4,0"
                                                         md:HintAssist.Hint="e.g. 100"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Max Amount (₱) -->
                                    <DataGridTemplateColumn Header="Max Amount (&#x20B1;)" Width="145">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding MaxAmountDisplay}" VerticalAlignment="Center" Padding="4,0" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding MaxAmountEdit, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Padding="4,0"
                                                         md:HintAssist.Hint="e.g. 99 (or blank for UP)"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Fixed Fee -->
                                    <DataGridTemplateColumn Header="Fixed Fee (&#x20B1;)" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FixedFeeDisplay}" VerticalAlignment="Center" Padding="4,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding FixedFeeEdit, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Padding="4,0"
                                                         md:HintAssist.Hint="e.g. 75"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Percentage Fee -->
                                    <DataGridTemplateColumn Header="% Fee (e.g. 0.15=15%)" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PercentFeeDisplay}" VerticalAlignment="Center" Padding="4,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding PercentFeeEdit, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Padding="4,0"
                                                         md:HintAssist.Hint="e.g. 0.15"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Calculated result preview -->
                                    <DataGridTextColumn Header="Preview" Binding="{Binding DisplayFee}" Width="*" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PosPrimary}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Padding" Value="4,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- Delete action -->
                                    <DataGridTemplateColumn Header="" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Tag="{Binding}" Click="OnDeleteRateTier"
                                                        Style="{StaticResource Pos3DTableDangerBtn}"
                                                        ToolTip="Remove this tier">
                                                    <md:PackIcon Kind="DeleteOutline" Width="14" Height="14"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Shopping Schedule -->
                        <TextBlock Text="Designated Shopping Days (comma-separated)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,5" FontFamily="Segoe UI"/>
                        <TextBox x:Name="BuyingDaysBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="e.g. Wednesday, Thursday" FontSize="12.5" Margin="0,0,0,12" Padding="10,6"/>

                        <TextBlock Text="Shopping Run Instructions / Notes" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,5" FontFamily="Segoe UI"/>
                        <TextBox x:Name="BuyingNotesBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="e.g. Wed: SM &amp; Grocery; Thu: Robinsons &amp; Bakeries" FontSize="12.5" Margin="0,0,0,16" Padding="10,6"/>

                        <!-- Store info redirect -->
                        <Border Background="{DynamicResource PosLightPurple}" BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="InformationOutline" Width="16" Height="16" Foreground="{DynamicResource PosPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Foreground="{DynamicResource PosPrimary}" FontSize="11.5" FontFamily="Segoe UI" TextWrapping="Wrap">
                                    <Run Text="Stores are managed in"/>
                                    <Run Text=" Management → Stores" FontWeight="Bold"/>
                                    <Run Text=" from the sidebar."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <!-- Hidden x:Name fields needed by code-behind - kept but not visible -->
                        <TextBox x:Name="NewStoreNameBox" Visibility="Collapsed"/>
                        <TextBox x:Name="NewStoreBranchBox" Visibility="Collapsed"/>
                        <ItemsControl x:Name="StoresListControl" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========================================== -->
            <!-- 3. DELIVERY SETTINGS (Hidden/Collapsed)    -->
            <!-- ========================================== -->
            <Border x:Name="SectionDelivery" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" CornerRadius="12" Padding="20" Visibility="Collapsed" MaxWidth="840" HorizontalAlignment="Left">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Background="#FEF3C7" CornerRadius="6" Padding="6" Margin="0,0,8,0">
                            <md:PackIcon Kind="TruckDeliveryOutline" Width="18" Height="18" Foreground="#D97706"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DELIVERY &amp; FULFILLMENT" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"/>
                            <TextBlock Text="Default delivery rates and dispatch options" FontSize="11" Foreground="{DynamicResource PosSecondaryText}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel MaxWidth="300" HorizontalAlignment="Left">
                        <TextBlock Text="Default Delivery Fee (&#x20B1;)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,5" FontFamily="Segoe UI"/>
                        <TextBox x:Name="DelivFeeBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="50" FontSize="12.5" Padding="10,6"/>
                        <TextBlock Text="Applied automatically when Delivery fulfillment is selected" FontSize="10.5" Foreground="{DynamicResource PosSecondaryText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ========================================== -->
            <!-- 4. PRINTING SETTINGS                       -->
            <!-- ========================================== -->
            <Border x:Name="SectionPrinting" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="20" Visibility="Collapsed" MaxWidth="840" HorizontalAlignment="Left">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Background="#EDE9FE" CornerRadius="6" Padding="6" Margin="0,0,8,0">
                            <md:PackIcon Kind="PrinterOutline" Width="18" Height="18" Foreground="#6D28D9"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PRINTING &amp; RECEIPT HARDWARE" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"/>
                            <TextBlock Text="Thermal POS printers, USB / network connection, and test prints" FontSize="11" Foreground="{DynamicResource PosSecondaryText}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                        <TextBlock Text="Default Receipt Printer" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <!-- Printer Status Badge -->
                        <Border x:Name="PrinterStatusBadge" Margin="10,0,0,0" CornerRadius="10" Padding="8,3" VerticalAlignment="Center" Background="#DCFCE7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="PrinterStatusDot" Width="7" Height="7" Fill="#16A34A" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock x:Name="PrinterStatusText" Text="Connected" FontSize="10.5" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PrinterCombo" Grid.Column="0"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  FontSize="12.5" md:HintAssist.Hint="Select printer" Padding="10,6"
                                  SelectionChanged="OnPrinterSelectionChanged"/>
                        <Button Grid.Column="2" Click="OnRefreshPrinters"
                                Style="{StaticResource Pos3DSecondaryBtn}"
                                Width="38" Height="38" Padding="0"
                                ToolTip="Refresh printers list">
                            <md:PackIcon Kind="Refresh" Width="16" Height="16" Foreground="{DynamicResource PosSecondaryText}"/>
                        </Button>
                    </Grid>

                    <!-- Print Spooler Queue Status & Health Check -->
                    <Border Background="{DynamicResource PosPanel}" BorderBrush="{DynamicResource PosBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PRINT SPOOLER QUEUE STATUS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,3"/>
                                <TextBlock x:Name="SpoolerQueueStatusText" Text="Ready (Queue empty)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PosPrimaryText}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Click="OnClearSpoolerQueue"
                                    Style="{StaticResource Pos3DTableDangerBtn}"
                                    Height="32" Padding="12,0"
                                    ToolTip="Purge all pending and stuck jobs from the Windows printer queue">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <md:PackIcon Kind="Cancel" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Clear Spooler Queue" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Quick Test Print" Click="OnTestPrint"
                                Style="{StaticResource Pos3DPrimaryBtn}"
                                Height="36" Padding="16,0" FontSize="11.5"
                                ToolTip="Test print receipt to configured default printer"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ========================================== -->
            <!-- 5. DATA SETTINGS                           -->
            <!-- ========================================== -->
            <Border x:Name="SectionData" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="20" Visibility="Collapsed" MaxWidth="840" HorizontalAlignment="Left">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Background="#DCFCE7" CornerRadius="6" Padding="6" Margin="0,0,8,0">
                            <md:PackIcon Kind="DatabaseOutline" Width="18" Height="18" Foreground="#059669"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DATA STORAGE &amp; LOCAL BACKUPS" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"/>
                            <TextBlock Text="Local SQLite database file and backup protection" FontSize="11" Foreground="{DynamicResource PosSecondaryText}"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Local Database Path" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,3"/>
                            <TextBlock x:Name="DbPathLabel" Text="data/antique_pasabuy.db" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource PosPrimaryText}"/>
                            <TextBlock x:Name="DbSizeLabel" Text="Database Size: Calculating..." FontSize="11" Foreground="{DynamicResource PosSecondaryText}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Open Data Folder" Click="OnOpenDataFolder"
                                    Style="{StaticResource Pos3DSecondaryBtn}"
                                    Height="36" Padding="14,0" Margin="0,0,8,0" FontSize="11.5"/>
                            <Button Content="Backup Database Now" Click="OnBackupDatabase"
                                    Style="{StaticResource Pos3DSuccessBtn}"
                                    Height="36" Padding="16,0" FontSize="11.5"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========================================== -->
            <!-- 6. SYSTEM SETTINGS                         -->
            <!-- ========================================== -->
            <Border x:Name="SectionSystem" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="20" Visibility="Collapsed" MaxWidth="840" HorizontalAlignment="Left">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Background="#EDE9FE" CornerRadius="6" Padding="6" Margin="0,0,8,0">
                            <md:PackIcon Kind="Laptop" Width="18" Height="18" Foreground="#6D28D9"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SYSTEM &amp; ENVIRONMENT" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"/>
                            <TextBlock Text="Runtime environment and architecture specifications" FontSize="11" Foreground="{DynamicResource PosSecondaryText}"/>
                        </StackPanel>
                    </StackPanel>

                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="Deployment Mode" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}"/>
                            <TextBlock Text="Single-Laptop Local Desktop (100% Offline Capable)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PosPrimaryText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Application Version" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}"/>
                            <TextBlock Text="DIONIX POS v2.0 (Tactile 3D Edition)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PosPrimaryText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Target Framework" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}"/>
                            <TextBlock Text=".NET 8.0 Windows (WPF + EF Core SQLite)" FontSize="12" Foreground="{DynamicResource PosSecondaryText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Local System User" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}"/>
                            <TextBlock x:Name="SystemUserLabel" Text="Windows User" FontSize="12" Foreground="{DynamicResource PosSecondaryText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ========================================== -->
            <!-- 7. DISPLAY & UI SCALE SETTINGS             -->
            <!-- ========================================== -->
            <Border x:Name="SectionDisplay" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="20" Visibility="Collapsed" MaxWidth="840" HorizontalAlignment="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="#EDE9FE" CornerRadius="6" Padding="6" Margin="0,0,8,0">
                                <md:PackIcon Kind="PaletteOutline" Width="18" Height="18" Foreground="#6D28D9"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DISPLAY, THEME &amp; UI SCALING" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"/>
                                <TextBlock Text="Screen resolution adaptation, zoom scaling, and color mode" FontSize="11" Foreground="{DynamicResource PosSecondaryText}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Theme Mode Selection -->
                        <TextBlock Text="Application Theme" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryText}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Button x:Name="BtnThemeLight" Content="Light Mode (Standard)" Click="OnSetLightMode"
                                    Style="{StaticResource Pos3DSecondaryBtn}" Height="36" Padding="16,0" Margin="0,0,8,0" FontSize="11.5"/>
                            <Button x:Name="BtnThemeDark" Content="Dark Mode (Sleek Purple)" Click="OnSetDarkMode"
                                    Style="{StaticResource Pos3DSecondaryBtn}" Height="36" Padding="16,0" FontSize="11.5"/>
                        </StackPanel>

                        <!-- UI Scaling Selection -->
                        <TextBlock Text="UI Scale Mode" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryText}" Margin="0,0,0,4"/>
                        <TextBlock Text="Adjust system scale to comfortably fit your monitor or laptop display" FontSize="11" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,14" MaxWidth="540" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ScaleModeCombo" Grid.Column="0"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      FontSize="12" md:HintAssist.Hint="Select UI Scale" Padding="10,6"
                                      SelectionChanged="OnScaleModeChanged">
                                <ComboBoxItem Content="Auto (Screen-Aware)" Tag="Auto"/>
                                <ComboBoxItem Content="Small (85% Density)" Tag="Small"/>
                                <ComboBoxItem Content="Compact (92% Laptop)" Tag="Compact"/>
                                <ComboBoxItem Content="Normal (100% Default)" Tag="Normal"/>
                                <ComboBoxItem Content="Large (115% Zoom)" Tag="Large"/>
                                <ComboBoxItem Content="Custom Percentage" Tag="Custom"/>
                            </ComboBox>

                            <Border Grid.Column="2" Background="{DynamicResource PosPanel}" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="EFFECTIVE SCALE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}"/>
                                    <TextBlock x:Name="EffectiveScaleLabel" Text="100% (1.00x)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PosPrimary}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Custom Scale Slider (Visible when Custom is selected) -->
                        <StackPanel x:Name="CustomScalePanel" Margin="0,0,0,18" MaxWidth="540" HorizontalAlignment="Left" Visibility="Collapsed">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Custom UI Scale Percentage" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}"/>
                                <TextBlock x:Name="CustomScaleValueLabel" Text="100%" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource PosPrimary}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="CustomScaleSlider" Minimum="80" Maximum="150" Value="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="OnCustomScaleSliderChanged" Margin="0,2,0,4"/>
                            <Grid>
                                <TextBlock Text="80% (Extra Compact)" FontSize="10" Foreground="{DynamicResource PosSecondaryText}" HorizontalAlignment="Left"/>
                                <TextBlock Text="100% (Standard)" FontSize="10" Foreground="{DynamicResource PosSecondaryText}" HorizontalAlignment="Center"/>
                                <TextBlock Text="150% (Max Touch/Zoom)" FontSize="10" Foreground="{DynamicResource PosSecondaryText}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <!-- Display Info Readout -->
                        <Border Background="{DynamicResource PosPanel}" BorderBrush="{DynamicResource PosBorder}"
                                BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,4,0,0" MaxWidth="640" HorizontalAlignment="Left">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <md:PackIcon Kind="MonitorScreenshot" Width="24" Height="24" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="SCREEN &amp; ENVIRONMENT DIAGNOSTICS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryText}"/>
                                    <TextBlock x:Name="ScreenDiagnosticsLabel" Text="Resolution: Detecting..." FontSize="11" Foreground="{DynamicResource PosSecondaryText}" Margin="0,2,0,0"/>
                                    <TextBlock Text="UI scaling dynamically adjusts all pages, forms, buttons, and popups vector-sharp without clipping." FontSize="10.5" Foreground="{DynamicResource PosSecondaryText}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
