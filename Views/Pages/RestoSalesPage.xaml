<Page x:Class="AntiquePasabuyPOS.Views.Pages.RestoSalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource PosBackground}"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Margin="18,14">
        <Grid.ColumnDefinitions>
            <!-- Left: Menu Catalog -->
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="14"/>
            <!-- Right: Current Bill / Order Ticket -->
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ LEFT: MENU CATALOG ═══════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{DynamicResource PosSurface}"
                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search & Filter bar -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtSearchMenu" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="Search dishes, drinks, pulutan..."
                             TextChanged="OnSearchTextChanged" Height="40" Padding="10,0"/>
                </Grid>

                <!-- Category Pills -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" x:Name="CategoryPillsPanel">
                        <Button Content="All Items" Click="OnCategoryClick" Tag="All" Style="{StaticResource Pos3DPrimaryBtn}" Height="32" Padding="12,0" Margin="0,0,6,0"/>
                        <Button Content="Grill" Click="OnCategoryClick" Tag="Grill" Style="{StaticResource Pos3DSecondaryBtn}" Height="32" Padding="12,0" Margin="0,0,6,0"/>
                        <Button Content="Sizzling" Click="OnCategoryClick" Tag="Sizzling" Style="{StaticResource Pos3DSecondaryBtn}" Height="32" Padding="12,0" Margin="0,0,6,0"/>
                        <Button Content="Pulutan" Click="OnCategoryClick" Tag="Pulutan" Style="{StaticResource Pos3DSecondaryBtn}" Height="32" Padding="12,0" Margin="0,0,6,0"/>
                        <Button Content="Alcoholic" Click="OnCategoryClick" Tag="Alcoholic" Style="{StaticResource Pos3DSecondaryBtn}" Height="32" Padding="12,0" Margin="0,0,6,0"/>
                        <Button Content="Drinks" Click="OnCategoryClick" Tag="Drinks" Style="{StaticResource Pos3DSecondaryBtn}" Height="32" Padding="12,0" Margin="0,0,6,0"/>
                        <Button Content="Rice" Click="OnCategoryClick" Tag="Rice" Style="{StaticResource Pos3DSecondaryBtn}" Height="32" Padding="12,0" Margin="0,0,6,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Dishes Grid -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MenuItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OnAddDishClick" Tag="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="0" Margin="4" Width="145" Height="130" Cursor="Hand">
                                    <Border Background="{DynamicResource PosPanel}"
                                            BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                                            CornerRadius="8" Width="145" Height="130" ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <!-- Photo strip -->
                                                <RowDefinition Height="60"/>
                                                <!-- Name -->
                                                <RowDefinition Height="*"/>
                                                <!-- Category -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- Price -->
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- ── Dish Photo / Placeholder ── -->
                                            <Border Grid.Row="0"
                                                    Background="{DynamicResource PosBackground}"
                                                    CornerRadius="8,8,0,0"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <!-- Placeholder food icon (no image) -->
                                                    <md:PackIcon Kind="FoodDrumstick"
                                                                 Width="28" Height="28"
                                                                 Foreground="{DynamicResource PosMutedText}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Visibility="{Binding HasNoThumbnail, Converter={StaticResource BoolToVis}}"/>
                                                    <!-- Actual dish photo -->
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="UniformToFill"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </Border>

                                            <!-- ── Name ── -->
                                            <TextBlock Grid.Row="1" Text="{Binding Name}"
                                                       FontWeight="Bold" FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource PosPrimaryText}"
                                                       Margin="8,4,8,0" VerticalAlignment="Top"/>

                                            <!-- ── Category ── -->
                                            <TextBlock Grid.Row="2" Text="{Binding Category}"
                                                       FontSize="9.5"
                                                       Foreground="{DynamicResource PosSecondaryText}"
                                                       Margin="8,1,8,0"/>

                                            <!-- ── Price ── -->
                                            <TextBlock Grid.Row="3"
                                                       Text="{Binding Price, StringFormat='₱{0:N2}'}"
                                                       FontWeight="Bold" FontSize="12"
                                                       Foreground="{DynamicResource PosPrimary}"
                                                       Margin="8,2,8,6"/>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ══ RIGHT: CURRENT BILL / ORDER TICKET ═══════════════════════ -->
        <Border Grid.Column="2" Background="{DynamicResource PosSurface}"
                BorderBrush="{DynamicResource PosBorder}" BorderThickness="1"
                CornerRadius="8" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Ticket Header Band ── -->
                <Border Grid.Row="0" Background="{DynamicResource PosPrimary}"
                        CornerRadius="8,8,0,0" Padding="14,10">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="ORDER TICKET" FontSize="13" FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock x:Name="TxtTicketSubtitle" Text="Angelito's Bar &amp; Resto Grill"
                                       FontSize="10" Foreground="#CCFFFFFF" Margin="0,1,0,0"/>
                        </StackPanel>
                        <!-- Active Tab Status Indicator -->
                        <Border x:Name="TabStatusBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                                CornerRadius="12" Padding="8,3"
                                Background="#33FFFFFF" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="CheckCircleOutline" Width="12" Height="12"
                                             Foreground="#AAFFFFFF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TxtTabStatus" Text="Active Tab" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── Table + Customer Row ── -->
                <Grid Grid.Row="1" Margin="12,10,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Table Selector -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TABLE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CmbTable"
                                  Height="36"
                                  Background="{DynamicResource PosSurface}"
                                  BorderBrush="{DynamicResource PosPrimary}"
                                  BorderThickness="1.5"
                                  Foreground="{DynamicResource PosPrimaryText}"
                                  FontSize="12" FontFamily="Segoe UI"
                                  Padding="10,0">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="{DynamicResource PosSurface}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PosPrimaryText}"/>
                                    <Setter Property="Padding" Value="10,7"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </ComboBox.Resources>
                        </ComboBox>
                    </StackPanel>
                    <!-- Customer Name -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="GUEST NAME" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PosSecondaryText}" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtCustomerName"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="Walk-in Guest" Height="36" Padding="8,0"
                                 Foreground="{DynamicResource PosPrimaryText}"/>
                    </StackPanel>
                </Grid>

                <!-- ── Cart Items List ── -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource PosBorder}" BorderThickness="0,1,0,1"
                        Margin="0">
                    <DataGrid x:Name="CartGrid" AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column"
                              Background="Transparent" BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource PosBorder}"
                              Foreground="{DynamicResource PosPrimaryText}"
                              RowBackground="Transparent"
                              AlternatingRowBackground="{DynamicResource PosPanel}"
                              CellEditEnding="OnCartCellEditEnding">
                        <DataGrid.Resources>
                            <!-- Header style that respects theme -->
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource PosPanel}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PosSecondaryText}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="10.5"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PosBorder}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                            <!-- Cell style -->
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="{DynamicResource PosPrimaryText}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PosPrimaryLight}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PosPrimaryText}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <!-- Row style -->
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="{DynamicResource PosPrimaryText}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource PosPrimaryText}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Quick Quantity +/- buttons -->
                            <DataGridTemplateColumn Header="Qty" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Button Click="OnDecreaseQtyClick" Tag="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Width="24" Height="24" Padding="0" Cursor="Hand" Margin="0,0,2,0">
                                                <TextBlock Text="−" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PosPrimary}"/>
                                            </Button>
                                            <TextBlock Text="{Binding Quantity, StringFormat='{}{0:N0}'}" FontWeight="Bold"
                                                       FontSize="13" Foreground="{DynamicResource PosPrimaryText}"
                                                       MinWidth="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Click="OnIncreaseQtyClick" Tag="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Width="24" Height="24" Padding="0" Cursor="Hand" Margin="2,0,0,0">
                                                <TextBlock Text="+" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PosPrimary}"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat='₱{0:N2}'}" Width="65" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource PosSecondaryText}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,4"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cost price column — shows what the item cost us (for margin visibility) -->
                            <DataGridTemplateColumn Header="Cost" Width="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Padding="4,4" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                    <Setter Property="Text" Value="—"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CostPrice}" Value="{x:Null}">
                                                            <Setter Property="Foreground" Value="{DynamicResource PosMutedText}"/>
                                                            <Setter Property="Text" Value="—"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding CostPrice, StringFormat='₱{0:N2}', TargetNullValue='—'}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Total" Binding="{Binding Subtotal, StringFormat='₱{0:N2}'}" Width="72" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource PosPrimary}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="4,4"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="OnRemoveCartItemClick" Tag="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Foreground="#DC2626" Padding="0" Height="24" Width="24" Cursor="Hand"
                                                ToolTip="Remove item">
                                            <md:PackIcon Kind="DeleteOutline" Width="14" Height="14"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ── Totals & Payment Section ── -->
                <StackPanel Grid.Row="3" Margin="12,10,12,6">

                    <!-- Subtotal + Discount -->
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Subtotal" Foreground="{DynamicResource PosSecondaryText}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSubtotal" Text="₱0.00" HorizontalAlignment="Right"
                                   FontWeight="SemiBold" Foreground="{DynamicResource PosPrimaryText}" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Discount (₱)" Foreground="{DynamicResource PosSecondaryText}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtDiscount" Text="0.00" HorizontalAlignment="Right" Width="80"
                                 TextAlignment="Right" FontSize="12" TextChanged="OnDiscountChanged"
                                 Foreground="{DynamicResource PosPrimaryText}"
                                 Background="Transparent" BorderBrush="{DynamicResource PosBorder}"/>
                    </Grid>

                    <!-- Total Due -->
                    <Border Background="{DynamicResource PosPanel}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <TextBlock Text="TOTAL DUE" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource PosPrimaryText}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtGrandTotal" Text="₱0.00" HorizontalAlignment="Right"
                                       FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PosPrimary}"/>
                        </Grid>
                    </Border>

                    <!-- Payment Method -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Payment:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSecondaryText}"/>
                        <RadioButton x:Name="RbCash" Content="Cash" IsChecked="True" Checked="OnPaymentMethodChanged"
                                     Margin="0,0,10,0" GroupName="PayMethod"
                                     Foreground="{DynamicResource PosPrimaryText}"/>
                        <RadioButton x:Name="RbGCash" Content="GCash" Checked="OnPaymentMethodChanged"
                                     Margin="0,0,10,0" GroupName="PayMethod"
                                     Foreground="{DynamicResource PosPrimaryText}"/>
                        <RadioButton x:Name="RbCard" Content="Card" Checked="OnPaymentMethodChanged"
                                     GroupName="PayMethod"
                                     Foreground="{DynamicResource PosPrimaryText}"/>
                    </StackPanel>

                    <!-- Amount Tendered + Change -->
                    <Border Background="{DynamicResource PosPanel}" BorderBrush="{DynamicResource PosBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <StackPanel>
                            <!-- Amount Row -->
                            <Grid>
                                <TextBlock Text="Amount Tendered" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PosPrimaryText}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtAmountPaid" HorizontalAlignment="Right"
                                         Width="120" Height="32"
                                         TextAlignment="Right" FontSize="15" FontWeight="Bold"
                                         Foreground="{DynamicResource PosPrimaryText}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Padding="6,2"
                                         TextChanged="OnAmountPaidChanged"/>
                            </Grid>

                            <!-- Fast Denomination Buttons -->
                            <WrapPanel Orientation="Horizontal" Margin="0,6,0,6" HorizontalAlignment="Right">
                                <Button Content="Exact" Click="OnQuickTenderClick" Tag="exact"
                                        Style="{StaticResource Pos3DFilterBtn}" Height="26" Padding="7,0" Margin="0,0,4,0" FontSize="10.5"/>
                                <Button Content="₱100" Click="OnQuickTenderClick" Tag="100"
                                        Style="{StaticResource Pos3DFilterBtn}" Height="26" Padding="7,0" Margin="0,0,4,0" FontSize="10.5"/>
                                <Button Content="₱200" Click="OnQuickTenderClick" Tag="200"
                                        Style="{StaticResource Pos3DFilterBtn}" Height="26" Padding="7,0" Margin="0,0,4,0" FontSize="10.5"/>
                                <Button Content="₱500" Click="OnQuickTenderClick" Tag="500"
                                        Style="{StaticResource Pos3DFilterBtn}" Height="26" Padding="7,0" Margin="0,0,4,0" FontSize="10.5"/>
                                <Button Content="₱1,000" Click="OnQuickTenderClick" Tag="1000"
                                        Style="{StaticResource Pos3DFilterBtn}" Height="26" Padding="7,0" FontSize="10.5"/>
                            </WrapPanel>

                            <!-- Change Due -->
                            <Border CornerRadius="6" Padding="8,6" Background="{DynamicResource PosSurface}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <md:PackIcon Kind="CashMultiple" Width="14" Height="14"
                                                     Foreground="{DynamicResource PosSecondaryText}"
                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="CHANGE DUE" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource PosSecondaryText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtChange" Text="₱0.00" HorizontalAlignment="Right"
                                               FontSize="17" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Action Buttons ── -->
                <Grid Grid.Row="4" Margin="12,0,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Void / Delete Active Tab -->
                    <Button Grid.Column="0" Click="OnVoidTabClick"
                            Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1"
                            Foreground="#DC2626" Height="46" Width="44" Padding="0" Cursor="Hand"
                            ToolTip="Cancel &amp; delete this table's active order tab">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <md:PackIcon Kind="DeleteOutline" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Save to Running Tab -->
                    <Button Grid.Column="2" Click="OnSaveToTabClick"
                            Style="{StaticResource Pos3DSecondaryBtn}"
                            Height="46" Cursor="Hand"
                            ToolTip="Save dishes and drinks to this table's running bill">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <md:PackIcon Kind="ClipboardTextClockOutline" Width="17" Height="17"
                                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="SAVE TAB" FontWeight="Bold" FontSize="11.5"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Complete Sale & Pay -->
                    <Button Grid.Column="4" Click="OnCompleteSaleClick"
                            Style="{StaticResource Pos3DPrimaryBtn}"
                            Height="46" Cursor="Hand"
                            ToolTip="Settle payment and checkout this table">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <md:PackIcon Kind="CashRegister" Width="18" Height="18"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="PAY &amp; CHECKOUT" FontWeight="Bold" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
