<Page x:Class="AntiquePasabuyPOS.Views.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource PosBackground}">
    <Grid Margin="16,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="User Management" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryText}" FontFamily="Segoe UI"/>
                <TextBlock Text="Manage staff accounts and permissions" Foreground="{DynamicResource PosSecondaryText}" FontSize="12" FontFamily="Segoe UI"/>
            </StackPanel>
            <Button Style="{StaticResource Pos3DPrimaryBtn}" Padding="14,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="OnAddUser">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="AccountPlus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Add User" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                </StackPanel>
            </Button>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource PosSurface}" CornerRadius="8" BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" Margin="0,0,0,12" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <md:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="{DynamicResource PosSecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" FontSize="13" FontFamily="Segoe UI"
                         md:HintAssist.Hint="Search users by name, username, or role..." Style="{StaticResource MaterialDesignTextBox}" TextChanged="OnSearch"/>
                <Button Grid.Column="2" Content="✕" Click="OnClearSearch"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="{DynamicResource PosSecondaryText}" Padding="6,2" FontSize="11"
                        ToolTip="Clear search"/>

                <!-- Bulk Selection Toolbar -->
                <StackPanel x:Name="BulkSelectionPanel" Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Background="{DynamicResource PosLightBlue}" CornerRadius="6"
                            Padding="7,3" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedCountLabel" Text="0 selected"
                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PosPrimary}"/>
                    </Border>
                    <Button Click="OnSelectAllClick" Style="{StaticResource Pos3DFilterBtn}" Height="30" Padding="8,0" Margin="0,0,4,0" ToolTip="Select all visible users">
                        <TextBlock Text="Select All" FontSize="11" FontWeight="SemiBold"/>
                    </Button>
                    <Button Click="OnClearSelectionClick" Style="{StaticResource Pos3DFilterBtn}" Height="30" Padding="8,0" Margin="0,0,4,0" ToolTip="Clear selection">
                        <TextBlock Text="Clear" FontSize="11" FontWeight="SemiBold"/>
                    </Button>
                    <Button x:Name="BulkDeleteBtn" Click="OnBulkDeleteClick" Style="{StaticResource Pos3DDangerBtn}" Height="30" Padding="10,0" ToolTip="Delete selected users">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="DeleteOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Delete" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}" BorderThickness="1" CornerRadius="12">
            <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" Style="{StaticResource MaterialDesignDataGrid}"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      AlternationCount="2" FontFamily="Segoe UI" FontSize="13"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <!-- SELECTION CHECKBOX COLUMN -->
                    <DataGridTemplateColumn Width="46" CanUserResize="False">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="HeaderSelectAll" Click="OnHeaderSelectAllClick"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip="Select / Deselect all visible users"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Click="OnRowCheckBoxClick"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="160" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                    <DataGridTemplateColumn Header="Status" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{Binding IsActive, Converter={StaticResource ActiveColorConv}}">
                                    <TextBlock Text="{Binding IsActive, Converter={StaticResource ActiveTextConv}}"
                                               Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat='MMM dd, yyyy'}" Width="120"/>
                    <DataGridTemplateColumn Header="Actions" Width="Auto" MinWidth="260">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="EDIT" Tag="{Binding Id}" Style="{StaticResource Pos3DTableActionBtn}"
                                            Margin="0,0,5,0" Click="OnEditUser"/>
                                    <Button Content="RESET PWD" Tag="{Binding Id}" Style="{StaticResource Pos3DTableWarningBtn}"
                                            Margin="0,0,5,0" Click="OnResetPassword"/>
                                    <Button Content="DELETE" Tag="{Binding Id}" Style="{StaticResource Pos3DTableDangerBtn}"
                                            Click="OnDeleteUser"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
