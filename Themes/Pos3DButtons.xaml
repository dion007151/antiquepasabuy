        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource PosSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PosBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource PosPrimaryText}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonFace"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- ACTIVE STATE: Selected Category (Solid DIONIX Indigo) -->
                        <Trigger Property="views:NavProps.IsActive" Value="True">
                            <Setter TargetName="ButtonFace" Property="Background" Value="#4F46E5"/>
                            <Setter TargetName="ButtonFace" Property="BorderBrush" Value="#4F46E5"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>

                        <!-- HOVER STATE -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="views:NavProps.IsActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonFace" Property="Background" Value="{DynamicResource PosPanel}"/>
                            <Setter TargetName="ButtonFace" Property="BorderBrush" Value="{DynamicResource PosPrimary}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PosPrimary}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="views:NavProps.IsActive" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonFace" Property="Background" Value="#6366F1"/>
                            <Setter TargetName="ButtonFace" Property="BorderBrush" Value="#6366F1"/>
                        </MultiTrigger>

                        <!-- PRESSED STATE -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True"/>
                                <Condition Property="views:NavProps.IsActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonFace" Property="Background" Value="{DynamicResource PosPanel}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True"/>
                                <Condition Property="views:NavProps.IsActive" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonFace" Property="Background" Value="#3730A3"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 14. PRODUCT CARD BUTTON (Modern Retail Touch POS Tile) -->
    <Style x:Key="Pos3DProductBtn" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="Height" Value="168"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonFace"
                            Background="{DynamicResource PosSurface}"
                            BorderBrush="{DynamicResource PosBorder}"
                            BorderThickness="1.2"
                            CornerRadius="12"
                            Padding="10,9"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- HOVER -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonFace" Property="Background" Value="{DynamicResource PosSurface}"/>
                            <Setter TargetName="ButtonFace" Property="BorderBrush" Value="{DynamicResource PosPrimary}"/>
                            <Setter TargetName="ButtonFace" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <!-- PRESSED -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonFace" Property="Background" Value="{DynamicResource PosPanel}"/>
                        </Trigger>
                        <!-- SELECTED: Item is in cart ticket -->
                        <DataTrigger Binding="{Binding IsInCart}" Value="True">
                            <Setter TargetName="ButtonFace" Property="Background" Value="{DynamicResource PosLightPurple}"/>
                            <Setter TargetName="ButtonFace" Property="BorderBrush" Value="{DynamicResource PosPrimary}"/>
                            <Setter TargetName="ButtonFace" Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                        <!-- DISABLED: Product unavailable/inactive -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonFace" Property="Background" Value="{DynamicResource PosSurface}"/>
                            <Setter TargetName="ButtonFace" Property="BorderBrush" Value="{DynamicResource PosBorder}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
