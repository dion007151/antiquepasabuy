    <!-- 12. FILTER PILL / SEGMENT BUTTON (Toggleable with NavProps.IsActive) -->
    <Style x:Key="Pos3DFilterBtn" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource PosPanel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PosBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource PosSecondaryText}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonFace"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- ACTIVE / SELECTED STATE -->
                        <Trigger Property="views:NavProps.IsActive" Value="True">
                            <Setter TargetName="ButtonFace" Property="Background" Value="#452B86"/>
                            <Setter TargetName="ButtonFace" Property="BorderBrush" Value="#452B86"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>

                        <!-- HOVER STATE -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="views:NavProps.IsActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonFace" Property="Background" Value="{DynamicResource PosSurface}"/>
                            <Setter TargetName="ButtonFace" Property="BorderBrush" Value="{DynamicResource PosPrimary}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PosPrimaryText}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="views:NavProps.IsActive" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonFace" Property="Background" Value="#5A3BA8"/>
                            <Setter TargetName="ButtonFace" Property="BorderBrush" Value="#5A3BA8"/>
                        </MultiTrigger>

                        <!-- PRESSED STATE -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True"/>
                                <Condition Property="views:NavProps.IsActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonFace" Property="Background" Value="{DynamicResource PosPanel}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True"/>
                                <Condition Property="views:NavProps.IsActive" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonFace" Property="Background" Value="#351F68"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

